---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { buildBreadcrumbSchema } from "../lib/schema";
import { siteConfig, customerIoNewsletter } from "../site";

const path = "/refer";

const schema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Refer a founder", path }
  ])
];

const turnstileSiteKey =
  (typeof import.meta.env.PUBLIC_TURNSTILE_SITE_KEY === "string" &&
    import.meta.env.PUBLIC_TURNSTILE_SITE_KEY.trim()) ||
  "0x4AAAAAAEIhzoHuWLsynQnO";
---

<BaseLayout
  title="Refer a founder, earn £500 | We Scale Startups"
  description="Know a post-PMF B2B SaaS founder with a pipeline problem? Refer them to We Scale Startups and earn £500 when they sign."
  path={path}
  schema={schema}
  lastUpdated={siteConfig.lastUpdated}
>

  <!-- HERO -->
  <section class="page-hero" aria-labelledby="refer-title">
    <div class="shell">
      <p class="eyebrow">Referral programme</p>
      <h1 id="refer-title">Know a founder who needs a <em>growth system?</em></h1>
      <p class="hero-copy">
        If you know a post-PMF B2B SaaS or AI founder with a pipeline problem,
        introduce them to We Scale Startups.
        <strong>We'll pay you £500 when they sign.</strong>
      </p>
      <div class="hero-actions">
        <a class="button button-brand" href="#refer-form" data-cta="refer-hero-cta">Make a referral →</a>
        <a class="button button-light" href="#how-it-works" data-cta="refer-hero-how">How it works</a>
      </div>
    </div>
  </section>

  <!-- REWARD STATS -->
  <section class="section">
    <div class="shell">
      <div class="showcase-stats">
        <div>
          <span class="stat-number">£500</span>
          <span class="stat-label">Flat reward, any tier</span>
        </div>
        <div>
          <span class="stat-number">14 days</span>
          <span class="stat-label">Paid after first invoice</span>
        </div>
        <div>
          <span class="stat-number">No limit</span>
          <span class="stat-label">Refer as many as you like</span>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section-alt" id="how-it-works">
    <div class="shell">
      <SectionIntro eyebrow="§ 01 · How it works" title="Three steps, zero friction." />
      <div class="grid-3">
        {[
          {
            n: "01",
            title: "Submit the form below",
            body: "Tell us who you're referring and why you think they're a good fit. A name and a line of context is enough, we'll take it from there."
          },
          {
            n: "02",
            title: "We reach out within 48 hours",
            body: "Daniel contacts the founder directly for a 20-minute growth diagnostic call. No hard sell, just an honest look at their constraint."
          },
          {
            n: "03",
            title: "You get paid £500",
            body: "When the founder signs any WSS engagement, we pay your £500 referral fee via bank transfer within 14 days of their first invoice."
          }
        ].map((step) => (
          <article class="feature-card">
            <p class="card-kicker">{step.n}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO CAN REFER -->
  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="§ 02 · Who can refer" title="This works for anyone in the startup ecosystem." />
      <div class="grid-2">
        {[
          {
            title: "Existing WSS clients",
            body: "You've seen the system work. If you know another founder with the same growth problem, send them over."
          },
          {
            title: "Advisors & angels",
            body: "Portfolio founders stuck on pipeline and still doing everything themselves, this is the call they need."
          },
          {
            title: "VCs & investors",
            body: "Post-PMF SaaS companies in your portfolio where the product works but pipeline is still founder-dependent."
          },
          {
            title: "Podcast listeners & followers",
            body: "If you've consumed the content and know someone who fits, founders doing £1–10M ARR, you're qualified to refer."
          }
        ].map((who) => (
          <article class="feature-card">
            <h3>{who.title}</h3>
            <p>{who.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section class="section section-alt" id="refer-form">
    <div class="shell">
      <SectionIntro
        eyebrow="§ 03 · Make your referral"
        title="Send us the intro."
        body="Takes about 2 minutes. We'll confirm receipt by email."
      />
      <form class="contact-option contact-form" id="referral-form" name="referral-form" novalidate>
        <p class="card-kicker">Your details</p>
        <label>Your name<input type="text" name="your_name" required placeholder="Jane Smith" /></label>
        <label>Your email<input type="email" name="your_email" required placeholder="jane@example.com" /></label>
        <label>Your relationship to WSS
          <select name="your_role">
            <option value="" disabled selected>Select one…</option>
            <option value="client">Current or past client</option>
            <option value="advisor">Advisor / angel investor</option>
            <option value="vc">VC / fund</option>
            <option value="podcast">Podcast listener / follower</option>
            <option value="other">Other</option>
          </select>
        </label>

        <p class="card-kicker">Founder you're referring</p>
        <label>Founder's name<input type="text" name="founder_name" required placeholder="Alex Jones" /></label>
        <label>Founder's email<input type="email" name="founder_email" required placeholder="alex@theirstartup.com" /></label>
        <label>Company<input type="text" name="company" placeholder="Their Startup Ltd" /></label>
        <label>Approx. ARR stage
          <select name="stage">
            <option value="" disabled selected>Select one…</option>
            <option value="sub-1m">Under £1M ARR</option>
            <option value="1-5m">£1M–£5M ARR</option>
            <option value="5-10m">£5M–£10M ARR</option>
            <option value="10m+">£10M+ ARR</option>
            <option value="unknown">Not sure</option>
          </select>
        </label>
        <label>Why are you referring them? (optional but helpful)
          <textarea name="context" rows="4" placeholder="e.g. They're post-PMF, pipeline depends on the founder, single paid channel, looking for senior growth support…"></textarea>
        </label>

        {turnstileSiteKey && (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="light"
            data-size="flexible"
          />
        )}
        <button class="button button-brand" type="submit" id="refer-submit">Submit referral →</button>
        <p class="not-for-footnote">We'll confirm receipt within 24 hours. Reward paid 14 days after the founder's first invoice.</p>

        <div id="refer-fallback" role="status" hidden></div>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section">
    <div class="shell">
      <SectionIntro eyebrow="§ 04 · Questions" title="A few things people usually ask." />
      <div class="faq-list">
        {[
          {
            q: "Does the founder need to know I'm referring them?",
            a: "Yes, a warm intro always converts better than a cold one. We recommend giving them a heads-up before you submit. If you'd prefer a blind referral, note that in the context field and we'll handle it carefully."
          },
          {
            q: "Which engagements qualify?",
            a: "Any paid WSS engagement counts, Growth Diagnosis (£2k–£4k), 90-Day Sprint (£8k–£12k), Acquisition System Build (£15k–£25k), or Fractional CMO (£5k–£8k/mo). The £500 reward is fixed regardless of engagement size."
          },
          {
            q: "How long is the referral window?",
            a: "If the founder you refer signs within 12 months of your submission, you're eligible for the reward. If they come back after a gap, just re-submit to refresh the attribution."
          },
          {
            q: "Is there a limit to how many referrals I can make?",
            a: "No limit. Refer as many qualified founders as you like, £500 per conversion, every time."
          },
          {
            q: "What if the founder isn't a good fit?",
            a: "No problem, Daniel will give them an honest read on the call. If they're pre-PMF or not ready, we'll say so and point them somewhere useful. You won't be penalised for referring someone who turns out not to be the right fit."
          }
        ].map(({ q, a }) => (
          <div class="faq-item">
            <h3>{q}</h3>
            <p>{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Questions first?</p>
        <h2>Book a 20-minute call with Daniel.</h2>
        <p>Happy to answer questions about fit, the process, or what happens after you refer someone.</p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="refer-book"
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="button button-light" href={`mailto:${siteConfig.email}?subject=Referral%20programme%20question`} data-cta="refer-email">
          Or, email {siteConfig.email} →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline define:vars={{ email: siteConfig.email, cioUrl: customerIoNewsletter.submitUrl, cioFormId: customerIoNewsletter.formId }}>
  const form = document.getElementById("referral-form");
  const fallback = document.getElementById("refer-fallback");

  form?.addEventListener("submit", function (event) {
    event.preventDefault();
    const data = new FormData(form);

    const yourName     = (data.get("your_name")     || "").toString().trim();
    const yourEmail    = (data.get("your_email")    || "").toString().trim();
    const yourRole     = (data.get("your_role")     || "").toString().trim();
    const founderName  = (data.get("founder_name")  || "").toString().trim();
    const founderEmail = (data.get("founder_email") || "").toString().trim();
    const company      = (data.get("company")       || "").toString().trim();
    const stage        = (data.get("stage")         || "").toString().trim();
    const context      = (data.get("context")       || "").toString().trim();

    const subject = "Founder referral: " + founderName + (company ? " (" + company + ")" : "");
    const body = [
      "Referred by: " + yourName + " <" + yourEmail + ">" + (yourRole ? ", " + yourRole : ""),
      "",
      "Founder: " + founderName + " <" + founderEmail + ">",
      "Company: " + (company || "—"),
      "ARR stage: " + (stage || "—"),
      "",
      "Context:",
      context || "(none provided)"
    ].join("\n");

    try {
      if (yourEmail) {
        fetch(cioUrl, {
          method: "POST",
          keepalive: true,
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            form_id: cioFormId,
            email: yourEmail,
            source_type: "referral-form",
            source_page: window.location.href,
            lead_magnet: "referral-programme",
            "cf-turnstile-response": (data.get("cf-turnstile-response") || "").toString()
          })
        }).catch(function () {});
      }
    } catch (_) {}

    window.location.href = "mailto:" + email + "?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);

    if (fallback) {
      fallback.removeAttribute("hidden");
      fallback.style.cssText = "margin-top:1rem;padding:1rem;border:1px solid currentColor;border-radius:8px;font-size:0.9rem;";
      fallback.innerHTML = "Your email draft should have opened. If it didn't, email <a href=\"mailto:" + email + "\">" + email + "</a> directly.";
    }

    if (navigator.clipboard) {
      navigator.clipboard.writeText(subject + "\n\n" + body).catch(function () {});
    }
  });
</script>
