---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { buildBreadcrumbSchema, buildCaseStudyArticleSchema, buildFaqSchema } from "../../lib/schema";
import { caseStudyRelatedReading, siteConfig } from "../../site";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((caseStudy) => ({
    params: { slug: caseStudy.id },
    props: { caseStudy }
  }));
}

const { caseStudy } = Astro.props;
const path = `/case-studies/${caseStudy.id}`;

// Standardised case-study structure (founder direction):
//   Problem · What WSS changed · Commercial result · System created · Why it mattered
// Maps onto existing collection fields:
//   problem        ← challenge
//   wssChanged     ← work[] (top 3-4)
//   commercialResult ← results[] (top 2-3)
//   systemCreated  ← derived from services[] + work synthesis
//   whyItMattered  ← summary as reframed value statement
function serviceToSystemLine(s: string) {
  const t = s.trim();
  if (/systems?$/i.test(t)) return t;
  return `${t} system`;
}

const systemCreatedList =
  caseStudy.data.systemsCreated?.length
    ? caseStudy.data.systemsCreated
    : caseStudy.data.services.map(serviceToSystemLine);

const sections = {
  problem: caseStudy.data.challenge,
  wssChanged: caseStudy.data.work,
  commercialResult: caseStudy.data.results,
  systemCreated: systemCreatedList,
  whyItMattered: caseStudy.data.whyItMattered ?? caseStudy.data.summary
};

/* Conditional sections, resolved once so the aside index and the body cannot
   disagree about which sections this case actually renders. */
const hasContext = Boolean(
  caseStudy.data.situation ||
    caseStudy.data.constraint ||
    caseStudy.data.beforeState ||
    caseStudy.data.afterState
);
const hasDepth = Boolean(
  caseStudy.data.timeline ||
    caseStudy.data.assetsShipped?.length ||
    caseStudy.data.commercialResult ||
    caseStudy.data.operationalResult ||
    caseStudy.data.clientQuote ||
    caseStudy.data.teamAfterWss
);

const caseNav = [
  ...(hasContext ? [{ id: "case-context", num: "00", label: "Context" }] : []),
  { id: "case-problem", num: "01", label: "Problem" },
  { id: "case-changed", num: "02", label: "What WSS changed" },
  { id: "case-result", num: "03", label: "Commercial result" },
  { id: "case-system", num: "04", label: "System created" },
  { id: "case-why", num: "05", label: "Why it mattered" },
  ...(hasDepth ? [{ id: "case-depth", num: "06", label: "Depth" }] : [])
];

const caseFaqs = [
  {
    question: `What did WSS change for this ${caseStudy.data.sector} client?`,
    answer: caseStudy.data.work.slice(0, 3).join("; ") + "."
  },
  {
    question: `What commercial result did this engagement produce?`,
    answer: caseStudy.data.results.slice(0, 3).join("; ") + "."
  },
  {
    question: `What system was left in place after the engagement?`,
    answer: `${systemCreatedList.join("; ")}, owned by the internal team after handover.`
  },
  {
    question: "How does WSS structure case studies?",
    answer: "Five standardised sections: Problem, What WSS changed, Commercial result, System created, Why it mattered. Same format every time so buyers can read in 60 seconds."
  }
];
---

<BaseLayout
  title={`${caseStudy.data.title} | We Scale Startups`}
  description={caseStudy.data.summary}
  ogImage={`/og/cases/${caseStudy.id}.png`}
  ogImageAlt={`${caseStudy.data.title}, We Scale Startups`}
  path={path}
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "Case studies", path: "/case-studies" },
    { name: caseStudy.data.title, path }
  ]}
  schema={[
    buildCaseStudyArticleSchema({
      name: caseStudy.data.title,
      description: caseStudy.data.summary,
      path,
      publishedAt: caseStudy.data.publishedAt,
      updatedAt: caseStudy.data.updatedAt,
      keywords: caseStudy.data.services
    }),
    buildFaqSchema(caseFaqs),
    buildBreadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Case studies", path: "/case-studies" },
      { name: caseStudy.data.title, path }
    ])
  ]}
>
  <!-- Hero -->
  <section class="page-hero page-hero-longtitle">
    <div class="shell">
      <p class="eyebrow">{caseStudy.data.sector}</p>
      <h1>{caseStudy.data.title}</h1>
      <div class="hero-support">
        {/* .case-summary had no styles anywhere, so this rendered as a bare
            hero paragraph while every sibling template opens on a .lede. */}
        <p class="lede case-summary">{caseStudy.data.summary}</p>
        <div class="hero-actions">
          <a
            class="button button-brand"
            href={siteConfig.bookingUrl}
            data-cta="case-book"
            title={siteConfig.bookingCallReassurance}
          >
            {siteConfig.bookingLabel} →
          </a>
          <a class="button button-light" href="/case-studies">All case studies →</a>
        </div>
      </div>
      {/* The engagement facts used to sit in the sticky aside, below the fold
          on every screen. They are the first thing a buyer checks, so they
          close the masthead in the same ledger object the pricing and service
          heroes use. The aside no longer repeats them. */}
      <div class="hero-rail hero-rail-stack">
        <p class="hero-rail-label">Engagement</p>
        <div class="hero-ledger">
          <div class="hero-ledger-cell">
            <span class="hero-ledger-index">Client</span>
            <span class="hero-ledger-value">{caseStudy.data.client}</span>
          </div>
          <div class="hero-ledger-cell">
            <span class="hero-ledger-index">Services used</span>
            <span class="hero-ledger-label">{caseStudy.data.services.join(", ")}</span>
          </div>
          {caseStudy.data.engagementPeriod && (
            <div class="hero-ledger-cell">
              <span class="hero-ledger-index">Period</span>
              <span class="hero-ledger-value">{caseStudy.data.engagementPeriod}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 5-section standardised structure -->
  <section class="section">
    <div class="shell">
      <div class="case-grid">
        {/* The aside used to restate the hero (client, sector, period) and then
            list the five section names immediately to the left of those exact
            five headings. It is a section index now: the same facts are in the
            hero ledger, and a sticky index is the one thing a long single
            column actually wants beside it. */}
        <aside class="case-aside">
          <p class="card-kicker">On this page</p>
          <nav class="case-aside-nav" aria-label="Sections of this case study">
            <ol class="case-aside-index">
              {caseNav.map((item) => (
                <li>
                  <a href={`#${item.id}`}>
                    <span class="case-aside-index-num">{item.num}</span>
                    <span class="case-aside-index-label">{item.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
          <a class="case-aside-link" href={siteConfig.danielSite} rel="noreferrer" target="_blank">
            Founder/operator: DanielJohnson.xyz →
          </a>
          {caseStudy.data.relatedOfferHref && (
            <p style="margin-top:1rem">
              <a class="button button-light" href={caseStudy.data.relatedOfferHref}>
                Related offer →
              </a>
            </p>
          )}
        </aside>

        <div class="case-body">
          {(caseStudy.data.situation ||
            caseStudy.data.constraint ||
            caseStudy.data.beforeState ||
            caseStudy.data.afterState) && (
            <article class="case-section case-section-context" id="case-context">
              <p class="case-section-num">00</p>
              <h2>Context</h2>
              {caseStudy.data.situation && (
                <p>
                  <strong>Situation:</strong> {caseStudy.data.situation}
                </p>
              )}
              {caseStudy.data.constraint && (
                <p>
                  <strong>Constraint:</strong> {caseStudy.data.constraint}
                </p>
              )}
              {caseStudy.data.beforeState && (
                <p>
                  <strong>Before:</strong> {caseStudy.data.beforeState}
                </p>
              )}
              {caseStudy.data.afterState && (
                <p>
                  <strong>After:</strong> {caseStudy.data.afterState}
                </p>
              )}
            </article>
          )}

          <!-- 1. PROBLEM -->
          <article class="case-section case-section-problem" id="case-problem">
            <p class="case-section-num">01</p>
            <h2>Problem</h2>
            <p>{sections.problem}</p>
          </article>

          <!-- 2. WHAT WSS CHANGED -->
          <article class="case-section case-section-action" id="case-changed">
            <p class="case-section-num">02</p>
            <h2>What WSS changed</h2>
            <ul>
              {sections.wssChanged.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <!-- 3. COMMERCIAL RESULT -->
          {/* The one section a buyer scrolls for was set in the same 0.95rem
              arrowed list as the process section above it. It reads as a
              ledger of outcomes instead — mono index, result at heading
              weight — which is the homepage metric rail's language. The text
              is the collection's `results` verbatim; nothing is re-cut into
              a value/label pair, because that would mean writing numbers the
              data does not state. */}
          <article class="case-section case-section-result" id="case-result">
            <p class="case-section-num">03</p>
            <h2>Commercial result</h2>
            <div class="case-result-ledger">
              {sections.commercialResult.map((item, index) => (
                <div class="case-result-cell">
                  <span class="case-result-index">{String(index + 1).padStart(2, "0")}</span>
                  <p class="case-result-text">{item}</p>
                </div>
              ))}
            </div>
          </article>

          <!-- 4. SYSTEM CREATED -->
          <article class="case-section case-section-system" id="case-system">
            <p class="case-section-num">04</p>
            <h2>System created</h2>
            <p>By the end of the engagement, the team was running these systems without WSS in every loop:</p>
            <ul>
              {sections.systemCreated.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <!-- 5. WHY IT MATTERED -->
          <article class="case-section case-section-why" id="case-why">
            <p class="case-section-num">05</p>
            <h2>Why it mattered</h2>
            <p>{sections.whyItMattered}</p>
            <p class="case-section-takeaway">
              <strong>The takeaway:</strong> the operating system stays with the team. The result isn't a campaign, it's the rhythm that keeps producing them.
            </p>
          </article>

          {(caseStudy.data.timeline ||
            caseStudy.data.assetsShipped?.length ||
            caseStudy.data.commercialResult ||
            caseStudy.data.operationalResult ||
            caseStudy.data.clientQuote ||
            caseStudy.data.teamAfterWss) && (
            <article class="case-section case-section-depth" id="case-depth">
              <p class="case-section-num">06</p>
              <h2>Depth</h2>
              {caseStudy.data.timeline && (
                <p>
                  <strong>Timeline:</strong> {caseStudy.data.timeline}
                </p>
              )}
              {caseStudy.data.assetsShipped && caseStudy.data.assetsShipped.length > 0 && (
                <div>
                  <strong>Assets shipped</strong>
                  <ul>
                    {caseStudy.data.assetsShipped.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                </div>
              )}
              {caseStudy.data.commercialResult && (
                <p>
                  <strong>Commercial result:</strong> {caseStudy.data.commercialResult}
                </p>
              )}
              {caseStudy.data.operationalResult && (
                <p>
                  <strong>Operational result:</strong> {caseStudy.data.operationalResult}
                </p>
              )}
              {caseStudy.data.clientQuote && (
                <blockquote>
                  <p>&ldquo;{caseStudy.data.clientQuote}&rdquo;</p>
                </blockquote>
              )}
              {caseStudy.data.teamAfterWss && (
                <p>
                  <strong>What the team could do after WSS:</strong> {caseStudy.data.teamAfterWss}
                </p>
              )}
            </article>
          )}

          {caseStudy.data.artefactImage && (
            <figure class="case-artefact">
              <img src={caseStudy.data.artefactImage} alt="" width="960" height="520" loading="lazy" decoding="async" />
              <figcaption>Engagement artefact (illustrative).</figcaption>
            </figure>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="Related reading" title="More proof and how to engage." />
      <ul class="related-insights-list">
        {caseStudyRelatedReading.map((item) => (
          <li>
            <a class="card-link" href={item.href}>
              {item.label} →
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="Case FAQ" title="What founders ask about this engagement." />
      <div class="grid-3">
        {caseFaqs.map((faq) => (
          <article class="feature-card">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Similar constraint?</p>
        <h2>Diagnose your bottleneck before you brief more work.</h2>
        <p>
          {siteConfig.bookingCallDurationPhrase}. Bring the current funnel, positioning, and reporting picture. We'll decide the most useful next move.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="case-final-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="link-arrow" href={siteConfig.scorecardUrl} data-cta="case-final-scorecard">
          Or, {siteConfig.scorecardLabel} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 980px) {
    .case-grid {
      grid-template-columns: 280px 1fr;
      gap: 3rem;
    }
  }

  .case-aside {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--v9-radius);
    padding: 1.4rem 1.4rem;
    align-self: start;
    position: sticky;
    top: 7rem;
  }
  /* Sticky section index. Rows are split by hairlines the way the hero
     ledger's cells are, so the aside reads as the same family of object. */
  .case-aside-nav { margin: 0.2rem 0 0; }
  .case-aside-index {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .case-aside-index li + li {
    border-top: 1px solid var(--line);
  }
  .case-aside-index a {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.55rem 0;
    text-decoration: none;
    color: var(--ink);
  }
  .case-aside-index a:hover .case-aside-index-label {
    color: var(--accent);
  }
  .case-aside-index-num {
    font-family: var(--v9-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .case-aside-index-label {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    transition: color 160ms ease;
  }
  .case-aside-link {
    display: inline-block;
    margin-top: 1.4rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .case-aside-link:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .case-body { display: flex; flex-direction: column; gap: 1.5rem; }

  /* Border/radius/background and the hover lift come from the shared card
     contract in site-v9.css. */
  .case-section {
    padding: 1.75rem 1.75rem 1.85rem 2.65rem;
    position: relative;
    /* Sticky header + the aside index's jump links. */
    scroll-margin-top: 7rem;
  }

  /* Accent spine. The previous pass tinted each card's border-color with a 35%
     mix into a 0.14-alpha hairline, which resolved to a difference of a few
     percent and was invisible at any real viewing distance. The accent is a
     solid 3px fill instead — a use mint and coral can carry, unlike text. */
  .case-section::before {
    content: "";
    position: absolute;
    left: 1.15rem;
    top: 1.95rem;
    bottom: 1.95rem;
    width: 3px;
    border-radius: 999px;
    background: var(--accent);
  }
  @media (max-width: 640px) {
    .case-section {
      padding-left: 2.15rem;
    }
    .case-section::before {
      left: 0.9rem;
    }
  }
  .case-section-num {
    font-family: var(--v9-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.12em;
    margin: 0 0 0.6rem;
  }
  .case-section h2 {
    margin: 0 0 1rem;
    font-size: 1.4rem;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .case-section p { color: var(--ink); line-height: 1.6; margin: 0 0 1rem; }
  .case-section p:last-child { margin-bottom: 0; }
  .case-section ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .case-section li {
    position: relative;
    padding: 0.6rem 0 0.6rem 1.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .case-section li:last-child { border-bottom: 0; }
  .case-section li::before {
    content: "→";
    position: absolute;
    left: 0;
    top: 0.6rem;
    color: var(--accent);
    font-weight: 700;
  }

  /* Commercial-result ledger. Collapsed rules, no gap colour, so an odd
     result count leaves an empty half-row rather than a grey block. */
  .case-result-ledger {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .case-result-cell {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
  }
  .case-result-cell:first-child {
    padding-top: 0;
    border-top: 0;
  }
  @media (min-width: 720px) {
    .case-result-ledger {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Only the first row opens without a rule; :nth-child(-n + 2) is the first
       row because the grid is exactly two columns wide here. */
    .case-result-cell:nth-child(-n + 2) {
      padding-top: 0;
      border-top: 0;
    }
    .case-result-cell:nth-child(odd) {
      padding-right: 1.6rem;
    }
    .case-result-cell:nth-child(even) {
      padding-left: 1.6rem;
      border-left: 1px solid var(--line);
    }
  }
  .case-result-index {
    font-family: var(--v9-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .case-result-text {
    /* `.case-section p` above resolves to 0-3-1 once Astro adds its scope
       attribute to both compounds, so a 0-2-0 class rule cannot clear its
       bottom margin without this. */
    margin: 0 !important;
    color: var(--ink);
    font-family: var(--v9-sans);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  /* Per-section accent, one recipe throughout: coral marks the problem, mint
     marks the system that was left behind, violet (the default UI accent)
     carries the rest. Colour is carried by the spine fill only — the mint "→"
     bullets this replaces sat at roughly 1.3:1 on white and were effectively
     unreadable. */
  .case-section-problem::before { background: var(--coral); }
  .case-section-system::before { background: var(--acid); }

  .case-section-takeaway {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-left: 3px solid var(--accent);
    padding: 0.85rem 1.1rem;
    border-radius: var(--v9-radius-small);
    margin-top: 1rem !important;
    font-size: 0.92rem;
  }
</style>
