---
// EmailSignup.astro — inline email capture; posts to Customer.io via /api/forms.
import { customerIoNewsletter, siteConfig } from "../site";

interface Props {
  heading?: string;
  subtext?: string;
  formId?: string;
  variant?: "light" | "dark";
  buttonLabel?: string;
  sourceType?: "newsletter" | "lead_magnet" | "contact_enquiry";
  sourcePage?: string;
  leadMagnet?: string;
  /** Customer.io form id (Integrations → Forms). Defaults to site newsletter form. */
  cioFormId?: string;
  finePrint?: string;
  /** Optional same-origin destination after a successful signup. */
  successRedirect?: string;
}

const {
  heading = siteConfig.newsletterName,
  subtext = `${siteConfig.newsletterDescription} ${siteConfig.newsletterFrequencyLine}`,
  formId = "email-signup",
  variant = "light",
  buttonLabel = "Get the note ->",
  sourceType = "newsletter",
  sourcePage = Astro.url.pathname,
  leadMagnet = "",
  cioFormId: cioFormIdProp,
  finePrint = "No spam. Unsubscribe any time.",
  successRedirect = ""
} = Astro.props;

const cioFormId = cioFormIdProp ?? customerIoNewsletter.formId;
const submitUrl = customerIoNewsletter.submitUrl;
const sourcePageValue = sourcePage || Astro.url.pathname;
const turnstileSiteKey =
  (typeof import.meta.env.PUBLIC_TURNSTILE_SITE_KEY === "string" &&
    import.meta.env.PUBLIC_TURNSTILE_SITE_KEY.trim()) ||
  "0x4AAAAAAEIhzoHuWLsynQnO";
const turnstileTheme = variant === "dark" ? "dark" : "light";
---

<div class={`email-signup-strip email-signup-strip--${variant}`} data-form-id={formId}>
  <div class="email-signup-inner">
    <div class="email-signup-copy">
      <p class="email-signup-heading">{heading}</p>
      <p class="email-signup-sub">{subtext}</p>
    </div>
    <form
      class="email-signup-form"
      id={formId}
      action={submitUrl}
      method="post"
      accept-charset="UTF-8"
      data-cta={`email-signup-${formId}`}
      data-cio-source-form
      data-success-redirect={successRedirect}
    >
      <input type="hidden" name="form_id" value={cioFormId} />
      <input type="hidden" name="source_type" value={sourceType} />
      <input type="hidden" name="source_page" value={sourcePageValue} data-source-page />
      <input type="hidden" name="lead_magnet" value={leadMagnet} />
      <input type="hidden" name="utm_source" value="" data-utm-field="utm_source" />
      <input type="hidden" name="utm_medium" value="" data-utm-field="utm_medium" />
      <input type="hidden" name="utm_campaign" value="" data-utm-field="utm_campaign" />
      <label class="sr-only" for={`email-field-${formId}`}>Your email address</label>
      <input
        id={`email-field-${formId}`}
        type="email"
        name="email"
        placeholder="you@company.com"
        required
        autocomplete="email"
      />
      {turnstileSiteKey && (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme={turnstileTheme}
          data-size="flexible"
        />
      )}
      <button type="submit" class="button button-brand">{buttonLabel}</button>
    </form>
    <p class="email-signup-fine" data-signup-status>{finePrint}</p>
  </div>
</div>

<script is:inline>
  document.querySelectorAll("form[data-cio-source-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.cioBound) return;
    form.dataset.cioBound = "1";

    const pageField = form.querySelector("[data-source-page]");
    if (pageField instanceof HTMLInputElement) {
      pageField.value = window.location.href;
    }

    const params = new URLSearchParams(window.location.search);
    form.querySelectorAll("[data-utm-field]").forEach((field) => {
      if (!(field instanceof HTMLInputElement)) return;
      const key = field.dataset.utmField;
      if (!key) return;
      field.value = params.get(key) || "";
    });

    const status = form.parentElement?.querySelector("[data-signup-status]");
    const button = form.querySelector('button[type="submit"]');
    const defaultFine = status?.textContent || "No spam. Unsubscribe any time.";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = (data.get("email") || "").toString().trim();
      if (!email) return;

      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
      }
      if (status) status.textContent = "Subscribing…";

      try {
        const res = await fetch(form.action || "/api/forms", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            email,
            form_id: (data.get("form_id") || "").toString(),
            source_type: (data.get("source_type") || "").toString(),
            source_page: (data.get("source_page") || window.location.href).toString(),
            lead_magnet: (data.get("lead_magnet") || "").toString(),
            utm_source: (data.get("utm_source") || "").toString(),
            utm_medium: (data.get("utm_medium") || "").toString(),
            utm_campaign: (data.get("utm_campaign") || "").toString(),
            "cf-turnstile-response": (data.get("cf-turnstile-response") || "").toString()
          })
        });
        const payload = await res.json().catch(() => ({}));
        if (res.ok && payload.ok) {
          try {
            if (typeof window.wssRememberLeadEmail === "function") {
              window.wssRememberLeadEmail(email);
            } else {
              sessionStorage.setItem("wss_lead_email", email);
            }
          } catch (_) {}
          form.reset();
          if (pageField instanceof HTMLInputElement) pageField.value = window.location.href;
          try {
            if (window.turnstile) {
              const widget = form.querySelector(".cf-turnstile");
              if (widget) window.turnstile.reset(widget);
            }
          } catch (_) {}
          // Lets the newsletter popup retire itself for anyone who has signed
          // up — newsletter forms only, not lead-magnet downloads.
          if ((data.get("source_type") || "").toString() === "newsletter") {
            document.dispatchEvent(new CustomEvent("newsletter:subscribed"));
          }
          const successRedirect = form.dataset.successRedirect || "";
          if (status) status.textContent = successRedirect ? "Success. Opening your downloads…" : "You're in. Check your inbox.";
          if (successRedirect) {
            const destination = new URL(successRedirect, window.location.origin);
            if (destination.origin === window.location.origin) window.location.assign(destination.href);
          }
        } else {
          if (status) status.textContent = "Something went wrong — try again in a moment.";
        }
      } catch (_) {
        if (status) status.textContent = "Something went wrong — try again in a moment.";
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
        if (status && status.textContent === "Subscribing…") {
          status.textContent = defaultFine;
        }
      }
    });
  });
</script>

<style>
  .email-signup-strip {
    border-radius: 0.75rem;
    padding: 2rem 1.5rem;
    margin: 2.5rem 0;
  }
  .email-signup-strip--light {
    background: var(--surface, #f9f9f7);
    border: 1px solid var(--line, #e8e5e0);
  }
  .email-signup-strip--dark {
    background: var(--ink, #1a1a18);
    color: #fff;
  }
  .email-signup-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .email-signup-copy { display: flex; flex-direction: column; gap: 0.25rem; }
  .email-signup-heading {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: inherit;
  }
  .email-signup-sub {
    font-size: 0.9rem;
    margin: 0;
    color: var(--muted, #666);
  }
  .email-signup-strip--dark .email-signup-sub { color: #aaa; }

  .email-signup-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    width: 100%;
    min-width: 0;
  }
  .email-signup-form .cf-turnstile {
    flex: 1 1 100%;
  }
  .email-signup-form input[type="email"] {
    flex: 1 1 220px;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line, #e8e5e0);
    border-radius: 0.4rem;
    font-size: 0.95rem;
    background: #fff;
    color: var(--ink, #1a1a18);
    outline: none;
    min-width: 0;
  }
  .email-signup-strip--dark .email-signup-form input[type="email"] {
    background: #2a2a28;
    border-color: #444;
    color: #fff;
  }
  .email-signup-form input[type="email"]:focus {
    border-color: var(--accent, #6657ff);
  }
  .email-signup-form .button {
    max-width: 100%;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .email-signup-form {
      flex-direction: column;
    }
    .email-signup-form input[type="email"],
    .email-signup-form .button {
      width: 100%;
    }
    /* Once the form stacks, the 220px basis applies to height, not width,
       which stretches the field into a giant box. */
    .email-signup-form input[type="email"] {
      flex: 0 0 auto;
    }
  }
  .email-signup-fine {
    font-size: 0.78rem;
    color: var(--muted, #888);
    margin: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
</style>
