---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { buildBreadcrumbSchema } from "../lib/schema";
import { siteConfig } from "../site";

const dimensions = [
  {
    dimension: "Positioning clarity",
    description: "Can a stranger say what you sell, who it's for, and why now, in one sentence?",
    scoreLabels: ["Weak", "Improving", "Clear"],
    weight: "High, drives every other channel"
  },
  {
    dimension: "Acquisition system",
    description: "Are paid, SEO, outbound, and content working as one system with shared ICP and offer?",
    scoreLabels: ["Siloed", "Partially linked", "One system"],
    weight: "High, compounds when fixed"
  },
  {
    dimension: "Conversion flow",
    description: "Does the homepage → demo/lead capture convert at 3%+ for your ICP traffic?",
    scoreLabels: ["<1%", "1–3%", "3%+"],
    weight: "Medium, often a quick win"
  },
  {
    dimension: "Reporting & decisions",
    description: "Is there one weekly view that says what to scale, stop, or fix this week?",
    scoreLabels: ["No view", "Activity only", "Decision view"],
    weight: "High, without this, growth stays founder-led"
  },
  {
    dimension: "Team ownership",
    description: "Can the team run the growth rhythm without founder input for 2+ weeks?",
    scoreLabels: ["Founder only", "Mixed", "Team-owned"],
    weight: "High, the exit condition for fractional work"
  },
  {
    dimension: "Offer & pricing",
    description: "Is the offer sharp for one ICP segment, with pricing that signals confidence?",
    scoreLabels: ["Blurry", "Clear but broad", "Sharp & segmented"],
    weight: "Medium, positioning flows from this"
  },
  {
    dimension: "Experiment cadence",
    description: "Are 2–4 growth experiments live at any time, with owners and decision rules?",
    scoreLabels: ["None", "Ad-hoc", "2–4 active"],
    weight: "Medium, speed of learning"
  },
  {
    dimension: "Founder time",
    description: "How many growth hours per week does the founder spend, and is it the right 5 hours?",
    scoreLabels: [">15 hrs", "8–15 hrs", "<8 hrs"],
    weight: "High, founder bottleneck score"
  }
];

const schema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "WSS Scale Score", path: "/wss-scale-score" }
  ])
];
---

<BaseLayout
  title="WSS Scale Score | We Scale Startups"
  description="Score your startup across 8 growth dimensions: positioning, acquisition, conversion, reporting, team ownership, offer, experimentation, and founder time."
  keywords="growth scorecard, startup growth assessment, fractional CMO audit, post-PMF growth checklist, acquisition system score"
  path="/wss-scale-score"
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "WSS Scale Score", path: "/wss-scale-score" }
  ]}
  schema={schema}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">WSS Scale Score</p>
      <h1>How ready is your growth system?</h1>
      <p class="lede">
        Score your startup across 8 dimensions in 5 minutes.
        At the end you'll see which constraint will block scale first, and what to fix.
      </p>
      <div class="hero-actions">
        <a class="button button-brand" href={siteConfig.bookingUrl} data-cta="scale-score-book">
          {siteConfig.bookingLabel}
          <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="button button-light" href="/resources#growth-bottleneck-scorecard" data-cta="scale-score-resource">
          Or use the simpler scorecard →
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="The 8 dimensions" title="What we measure, and why it predicts scale." />
      <div class="scale-dimension-grid">
        {dimensions.map((dim, i) => (
          <article class="feature-card scale-dimension">
            <div class="scale-dimension-head">
              <h3>{String(i + 1).padStart(2, "0")}. {dim.dimension}</h3>
              <span class="scale-dimension-weight">{dim.weight}</span>
            </div>
            <p>{dim.description}</p>
            <ol class="scale-band-row">
              {dim.scoreLabels.map((label, j) => (
                <li class:list={["scale-band", { "is-target": j === dim.scoreLabels.length - 1 }]}>
                  <span class="scale-band-index">{j + 1}</span>
                  {label}
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="How to use this" title="A diagnostic tool, not a vanity quiz." />
      <div class="scale-howto-grid">
        <article class="feature-card scale-howto">
          <h3>01. Score honestly</h3>
          <p>Get a founder, a growth lead, and one IC in the room. Score each dimension separately, then compare.</p>
        </article>
        <article class="feature-card scale-howto">
          <h3>02. Find the low score</h3>
          <p>The dimension with the lowest score is usually the constraint that's blocking repeatable pipeline.</p>
        </article>
        <article class="feature-card scale-howto">
          <h3>03. Book a diagnostic</h3>
          <p>Bring the scores to a 20-minute diagnostic. We'll confirm the constraint and recommend the engagement shape.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="What the score predicts" title="Low scores here are why pipeline plateaus." />
      <div class="scale-predict-grid">
        <article class="feature-card scale-predict">
          <h3>Positioning + Offer below 2/3</h3>
          <p>Acquisition spend leaks. Channels attract the wrong ICP. CAC climbs while conversion falls.</p>
        </article>
        <article class="feature-card scale-predict">
          <h3>Acquisition system below 2/3</h3>
          <p>Channels work in isolation but pipeline arrives in waves. No compound effect week over week.</p>
        </article>
        <article class="feature-card scale-predict">
          <h3>Reporting &amp; Decisions below 2/3</h3>
          <p>Activity gets reported but no one decides what to scale, stop, or fix. Weeks pass without a sharp call.</p>
        </article>
        <article class="feature-card scale-predict">
          <h3>Team Ownership below 2/3</h3>
          <p>Growth still depends on founder heroics. The system isn't transferable. Fractional work can't finish.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Ready to diagnose?</p>
        <h2>Book a 20-minute growth diagnostic.</h2>
        <p>
          Bring your WSS Scale Score. In {siteConfig.bookingCallDurationPhrase} we'll confirm the constraint and recommend the engagement that fits, or tell you where else to go.
        </p>
      </div>
      <div class="hero-actions">
        <a class="button button-brand button-with-subcopy" href={siteConfig.bookingUrl} data-cta="scale-score-final-book">
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="button button-light" href="/services" data-cta="scale-score-services">
          Compare services →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The page was almost entirely inline `style=` attributes. Every rule here
     replaces one of those, keeping the same intent but making it reusable and
     legible. Nothing on this page is interactive — it is a reference list —
     so the design work is rhythm and scannability, not affordance. */
  .scale-dimension-grid,
  .scale-predict-grid,
  .scale-howto-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 1.25rem;
  }

  .scale-dimension {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: 1.6rem 1.5rem 1.75rem;
  }

  .scale-dimension-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .scale-dimension-head h3 {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .scale-dimension-weight {
    color: var(--muted);
    font-family: var(--v9-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scale-dimension p {
    margin: 0;
  }

  /* The three score labels are an ordered scale, so they are an <ol> with the
     top band marked. The old version painted the third chip violet with no
     way to tell a reader why — the numeral says it. */
  .scale-band-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scale-band {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .scale-band-index {
    color: var(--muted);
    font-family: var(--v9-mono);
    font-size: 0.62rem;
  }

  .scale-band.is-target {
    border-color: rgba(128, 108, 255, 0.4);
    background: rgba(128, 108, 255, 0.1);
    color: var(--v9-violet-deep);
  }

  .scale-band.is-target .scale-band-index {
    color: var(--v9-violet-deep);
  }

  .scale-howto,
  .scale-predict {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem 1.4rem;
  }

  /* A violet left rule instead of the old violet heading colour: it keeps the
     "this is the failure mode" signal without setting a heading in a colour
     that has to be re-checked for contrast at every size. */
  .scale-predict {
    border-left: 3px solid var(--v9-violet);
  }

  .scale-howto h3,
  .scale-predict h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .scale-howto p,
  .scale-predict p {
    margin: 0;
  }
</style>
