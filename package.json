{
  "name": "wescalestartups-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "precheck": "node scripts/patch-resources-generator.mjs && node scripts/apply-resources-audit.mjs",
    "check": "astro check",
    "prebuild": "node scripts/patch-resources-generator.mjs && node scripts/apply-resources-audit.mjs",
    "build": "node --check public/growth-tools/app.js && node scripts/generate-og-png.mjs && astro build && node scripts/check-site-theme.mjs && node scripts/capture-integrity-report.mjs",
    "check:theme": "node scripts/check-site-theme.mjs",
    "verify:build": "node scripts/verify-build-integrity.mjs",
    "verify:resources": "node scripts/verify-resources.mjs",
    "preview": "astro preview",
    "check:links:crawl": "node scripts/check-crawl-links.mjs --input=docs/crawls/latest.csv",
    "verify:agents": "node scripts/verify-agent-discovery.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sentry/astro": "^10.70.0",
    "astro": "^6.4.8",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.2",
    "vite": "^7.3.5",
    "volar-service-yaml": "0.0.71"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
