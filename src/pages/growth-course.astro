---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema } from "../lib/schema";
import { siteConfig, mauticNewsletter } from "../site";

const weeks = [
  {
    week: "0",
    focus: "Qualify + baseline",
    evidence: "Product live, buyer hypothesis, baseline, founder commitment"
  },
  {
    week: "1",
    focus: "Buyer + pipeline",
    evidence: "50–100 qualified accounts; 40 personalised approaches launched"
  },
  {
    week: "2",
    focus: "Conversations",
    evidence: "5 meaningful replies or 3 calls booked; 5 buyer conversations"
  },
  {
    week: "3",
    focus: "Offer, price, ask",
    evidence: "Tested offer + pricing hypothesis; 3 explicit commercial asks"
  },
  {
    week: "4",
    focus: "Decide",
    evidence: "Money-level signal, supported iteration, or evidence-backed pivot"
  }
];

const outcomes = [
  "One clearly defined customer and buying situation",
  "A tested problem and offer, priced",
  "A live target list and founder-led outbound motion",
  "At least three explicit commercial asks made",
  "A money-level signal — or an evidence-backed stop / reposition / pivot",
  "A practical 30-day GTM operating cadence after the sprint"
];

const path = "/growth-course";
const schemas = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "First Customers Sprint", path }
  ])
];
---

<BaseLayout
  title="First Customers Sprint | The AI Growth Accelerator"
  description="Four-week done-with-you sprint for technical B2B AI and SaaS founders with a live product but no repeatable pipeline. Leave with commercial evidence — or the proof you need to pivot."
  path={path}
  schema={schemas}
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "First Customers Sprint", path }
  ]}
  lastUpdated={siteConfig.lastUpdated}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">The AI Growth Accelerator</p>
      <h1>First Customers Sprint</h1>
      <p class="lede">
        You shipped the product. Now prove somebody will buy it. A four-week, done-with-you sprint for technical B2B AI and SaaS founders with a live product but no repeatable pipeline.
      </p>
      <div class="hero-actions">
        <a class="button button-brand" href="#waitlist" data-cta="fcs-waitlist">Join the founding waitlist</a>
        <a class="button button-light" href="/workshops" data-cta="fcs-workshops">Programme / workshop enquiry →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Who this is for</p>
      <h2>All of these must be true.</h2>
      <div class="grid-2" style="margin-top: 2rem;">
        <article class="feature-card">
          <h3>Fits</h3>
          <ul class="mt-3 space-y-2 text-[color:var(--muted)]">
            <li>Technical B2B AI or SaaS founder, product already live</li>
            <li>0–10 customers, or customers but no dependable pipeline</li>
            <li>You personally own sales; buyer can be reached directly</li>
            <li>4–6 hrs/week; willing to talk to prospects and make a real paid ask</li>
          </ul>
        </article>
        <article class="feature-card">
          <h3>Not for (this version)</h3>
          <ul class="mt-3 space-y-2 text-[color:var(--muted)]">
            <li>Consumer apps · pure self-serve / PLG</li>
            <li>Long-cycle enterprise with procurement reviews</li>
            <li>Idea-stage builders · agencies</li>
            <li>Founders mainly wanting prompts, tools, or passive lessons</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <p class="eyebrow">What you get</p>
      <h2>Four weeks. Commercial evidence and a justified decision.</h2>
      <p class="lede" style="max-width: 60ch; margin-top: 0.75rem;">
        We do not promise your first ten customers or a repeatable growth loop. We promise evidence that passes the ladder: word → action → money.
      </p>
      <div class="grid-2" style="margin-top: 2rem;">
        {outcomes.map((item) => (
          <article class="feature-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">The method</p>
      <h2>Four steps. Gates measure evidence quality, not activity.</h2>
      <div class="grid gap-4 mt-8">
        {weeks.map((item) => (
          <article class="feature-card" style="display: grid; gap: 0.35rem;">
            <p class="card-label">Week {item.week}</p>
            <h3>{item.focus}</h3>
            <p class="text-[color:var(--muted)]">{item.evidence}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-[color:var(--muted)]" style="max-width: 65ch;">
        A founder who sends 40 right messages, hears silence, and discovers a fatal positioning problem has succeeded — the pivot memo graduates with equal standing.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <p class="eyebrow">Founding cohort</p>
      <h2>Small on purpose. Real asks on your product.</h2>
      <div class="grid-3" style="margin-top: 2rem;">
        <article class="feature-card">
          <h3>4–8 founders</h3>
          <p>Every important customer interaction gets reviewed. Live working session + office hour each week.</p>
        </article>
        <article class="feature-card">
          <h3>£750–1,000 founding</h3>
          <p>Target price £1,200–1,500 from cohort two. One price, one experience. Halfway refund.</p>
        </article>
        <article class="feature-card">
          <h3>Entry path</h3>
          <p>Waitlist → £100 refundable deposit → Founder Diagnostic for accepted founders (credited to the sprint).</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="waitlist">
    <div class="shell">
      <div class="max-w-2xl mx-auto text-center">
        <p class="eyebrow">Founding waitlist</p>
        <h2>Join the list for the next First Customers Sprint.</h2>
        <p class="mt-4 text-lg leading-8 text-[color:var(--muted)]">
          Tell us where you are. Qualified founders get the £100 deposit link next — not a content drip.
        </p>

        <form class="mt-8 card p-8 md:p-10 text-left" id="course-waitlist" name="course-waitlist">
          <div class="grid gap-4 max-w-md mx-auto">
            <div>
              <label class="text-sm font-semibold" for="course-name">Name</label>
              <input class="input mt-1" type="text" id="course-name" name="name" required placeholder="Your name" />
            </div>
            <div>
              <label class="text-sm font-semibold" for="course-email">Email</label>
              <input class="input mt-1" type="email" id="course-email" name="email" required placeholder="you@company.com" />
            </div>
            <div>
              <label class="text-sm font-semibold" for="course-product">Is the product live?</label>
              <select class="input mt-1" id="course-product" name="product" required>
                <option value="">Select</option>
                <option>Yes — live and usable by customers</option>
                <option>Almost — days from live</option>
                <option>No — still building</option>
              </select>
            </div>
            <div>
              <label class="text-sm font-semibold" for="course-stage">Pipeline today</label>
              <select class="input mt-1" id="course-stage" name="stage" required>
                <option value="">Select</option>
                <option>0 customers, no dependable pipeline</option>
                <option>1–10 customers, no dependable pipeline</option>
                <option>Some customers, still founder-led and irregular</option>
                <option>Other / not sure</option>
              </select>
            </div>
            <div>
              <label class="text-sm font-semibold" for="course-time">Can you commit 4–6 hrs/week for 4 weeks?</label>
              <select class="input mt-1" id="course-time" name="time" required>
                <option value="">Select</option>
                <option>Yes</option>
                <option>Maybe</option>
                <option>No</option>
              </select>
            </div>
            <button class="button button-brand w-full" type="submit" data-cta="fcs-waitlist-submit">Join the waitlist</button>
            <p class="text-xs text-[color:var(--muted)] text-center">
              Founding price £750–1,000. Deposit link sent only if you look like a fit.
            </p>
          </div>
        </form>

        <p class="mt-6 text-sm text-[color:var(--muted)]">
          Running an accelerator or VC platform?{" "}
          <a class="link-arrow" href="/workshops" data-cta="fcs-to-workshops">See portfolio workshops →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Instructor</p>
        <h2>Daniel Johnson</h2>
        <p>
          Founder, We Scale Startups. Mentor: Google for Startups, Techstars. Taught startup growth at Cambridge Judge; lectured at Imperial. 479+ founder sessions.
        </p>
      </div>
      <a class="button button-brand" href={`mailto:${siteConfig.email}?subject=First%20Customers%20Sprint`} data-cta="fcs-email">
        Email Daniel →
      </a>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ email: siteConfig.email, mauticUrl: mauticNewsletter.submitUrl, mauticFormId: mauticNewsletter.formId }}>
  const waitlistForm = document.getElementById("course-waitlist");
  waitlistForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(waitlistForm);
    const subject = "First Customers Sprint waitlist";
    const body = [
      `Name: ${data.get("name") || ""}`,
      `Email: ${data.get("email") || ""}`,
      `Product live: ${data.get("product") || ""}`,
      `Pipeline: ${data.get("stage") || ""}`,
      `Time commitment: ${data.get("time") || ""}`
    ].join("\n");
    try {
      const leadEmail = (data.get("email") || "").toString().trim();
      if (leadEmail) {
        fetch(mauticUrl, {
          method: "POST",
          mode: "no-cors",
          keepalive: true,
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({
            "mauticform[formId]": mauticFormId,
            "mauticform[email]": leadEmail,
            "mauticform[source_type]": "course-waitlist-form",
            "mauticform[source_page]": window.location.href,
            "mauticform[lead_magnet]": "first-customers-sprint-waitlist"
          }).toString()
        }).catch(() => {});
      }
    } catch (_) {}

    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    let note = document.getElementById("waitlist-fallback");
    if (!note) {
      note = document.createElement("p");
      note.id = "waitlist-fallback";
      note.setAttribute("role", "status");
      note.style.cssText = "margin-top:1rem;font-size:0.9rem;";
      waitlistForm.appendChild(note);
    }
    note.innerHTML = `Your email draft should have opened. If it didn't, email <a href="mailto:${email}">${email}</a> with the subject "First Customers Sprint waitlist".`;
  });
</script>
