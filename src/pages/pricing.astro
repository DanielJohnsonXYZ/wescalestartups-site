---
import OfferRoutingCards from "../components/OfferRoutingCards.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../lib/schema";
import { pricingRelatedReading, pricingTrustBullets, pricingTiers, siteConfig } from "../site";

const pricingFaqs = [
  {
    question: "Why publish starting prices?",
    answer: "The ranges help founders self-qualify before a call. Final scope still depends on team size, channel mix, urgency, and execution depth."
  },
  {
    question: "Which engagement do most founders start with?",
    answer: "Most start with Growth Diagnosis when the bottleneck is unclear. If the constraint is already visible, a sprint, system build, or fractional CMO scope may be cleaner. If you only need senior judgement on one decision, book a mentoring session instead."
  },
  {
    question: "Do you work with US companies?",
    answer: "Yes. Engagements run remotely with a working overlap that covers UK and US hours. Contracting and invoicing stay in GBP unless we agree otherwise before we start, and the dollar figures on this page are indicative conversions for sizing, not quotes."
  },
  {
    question: "Are media spend and tools included?",
    answer: "No. WSS fees cover strategy, system design, execution support, and reporting. Media spend, tools, and third-party vendor costs are separate."
  }
];
---

<BaseLayout
  path="/pricing"
  title="Startup Growth Pricing | We Scale Startups"
  description="Published ranges for Growth Mentoring, Growth Diagnosis, the 90-Day Sprint, Acquisition System Build, and Fractional CMO, in GBP with indicative USD, so you can self-qualify."
  keywords="fractional CMO pricing, growth diagnosis cost, 90-day growth sprint price, acquisition system build, post-PMF startup consulting UK"
  schema={[buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Pricing", path: "/pricing" }
  ]), buildFaqSchema(pricingFaqs)]}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Pricing</p>
      <h1>Here is what everything costs.</h1>
      <p class="lede">
        Every tier is a range, because where you land depends on team size, scope and timeline. Nothing here is hidden
        behind a form. If the ranges do not work for you, an agency or an in-house hire is probably the better call, and
        we will say so.
      </p>
      <p class="pricing-currency-note">
        We contract in GBP and work with UK and US teams. The dollar figures below are indicative at current rates, for
        sizing rather than for invoicing.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="pricing-grid">
        {pricingTiers.map((tier) => {
          const isRecommended = "recommended" in tier && tier.recommended;
          return (
          <article
            class:list={[
              "pricing-card",
              { "is-recommended": isRecommended },
              { "is-most-popular": "mostPopular" in tier && tier.mostPopular }
            ]}
          >
            {isRecommended && <span class="recommended-badge">Most founders start here</span>}
            {/* The recommended badge already says "best starting point"; showing both
                puts two near-identical pills on the same card. */}
            {!isRecommended && "tierBadge" in tier && tier.tierBadge && (
              <span class="popular-badge">{tier.tierBadge}</span>
            )}
            <h3>{tier.name}</h3>
            <div class="pricing-meta">
              <span class="pricing-price">{tier.priceFrom}</span>
              {"priceFromUsd" in tier && tier.priceFromUsd && (
                <span class="pricing-price-usd">{tier.priceFromUsd}</span>
              )}
              <span class="pricing-duration">{tier.duration}</span>
            </div>
            <p>{tier.description}</p>
            {"popularRationale" in tier && tier.popularRationale && (
              <p class="pricing-popular-rationale">{tier.popularRationale}</p>
            )}
            <a class="card-link" href={tier.href}>Learn more →</a>
          </article>
          );
        })}
      </div>

      <div class="pricing-disclaimer">
        Final fee depends on team size, channel mix, and the depth of execution required.
        Every engagement starts with a {siteConfig.bookingCallShort} so we agree on scope before any contract.
        Limited number of clients each quarter. UK clients: VAT is added where it applies. US clients: invoiced in GBP
        unless we agree otherwise, no local entity or sales tax involved.
      </div>

      <ul class="pricing-trust-list" aria-label="How engagements work">
        {pricingTrustBullets.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </div>
  </section>

  <OfferRoutingCards />

  <section class="section section-alt">
    <div class="shell two-column">
      <div>
        <p class="eyebrow">What's not in the price</p>
        <h2 style="font-family:'Geist','Inter',ui-sans-serif,system-ui,sans-serif;font-size:clamp(2.2rem,3.8vw,3rem);line-height:1.05;font-weight:700;margin:0.4rem 0 1.4rem;">Media spend. Tools. Vendors.</h2>
        <p class="lead-copy">Our fee covers strategy, system design, execution, and reporting. Paid media spend, tooling subscriptions, and any third-party vendor fees are separate and pass through at cost.</p>
      </div>
      <div class="grid grid-2">
        <article class="feature-card compact-card"><p>Paid media spend (Google, Meta, LinkedIn, etc.)</p></article>
        <article class="feature-card compact-card"><p>Tools and subscriptions (analytics, CRM, automation)</p></article>
        <article class="feature-card compact-card"><p>Third-party vendors (linkbuilding, video, design)</p></article>
        <article class="feature-card compact-card"><p>Travel for events or trade shows (if applicable)</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Related reading</p>
      <h2>Context for the numbers.</h2>
      <ul class="related-insights-list">
        {pricingRelatedReading.map((item) => (
          <li>
            <a class="card-link" href={item.href}>
              {item.label} →
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Pricing FAQ</p>
      <div class="grid-3">
        {pricingFaqs.map((faq) => (
          <article class="feature-card">
            <h2>{faq.question}</h2>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Not sure which tier fits?</p>
        <h2>Find out on the call.</h2>
        <p>
          {siteConfig.bookingCallDurationPhrase}. We'll tell you which engagement (if any) actually solves your bottleneck, and which would be wasted spend.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="pricing-cta"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="button button-light" href={siteConfig.scorecardUrl} data-cta="pricing-scorecard">
          Or, {siteConfig.scorecardLabel} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-currency-note {
    max-width: 62ch;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }
  /* Price and its USD equivalent on one line, duration on its own beneath,
     so the three values stop reading as a single run-on string. */
  .pricing-meta {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: baseline;
    gap: 0.2rem 0.55rem;
  }
  .pricing-price-usd {
    grid-column: 2;
    color: var(--muted);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .pricing-duration { grid-column: 1 / -1; }

  /* Five tiers in a two-column grid leaves the last card stranded beside a
     hole; let it take the full row instead. */
  .pricing-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .pricing-trust-list {
    margin: 1.75rem 0 0;
    padding: 1.15rem 1.25rem 1.2rem 1.5rem;
    max-width: 52rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
    list-style: disc;
  }
  .pricing-trust-list li {
    margin: 0.35rem 0;
    padding-left: 0.15rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
