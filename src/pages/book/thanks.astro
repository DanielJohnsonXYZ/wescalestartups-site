---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../site";

const community = siteConfig.growingPains;
const hostName = siteConfig.founderName;
const defaultPending = siteConfig.bookingRequiresHostConfirmation;
---

<BaseLayout
  title={defaultPending ? `Request sent | ${siteConfig.bookingLabel}` : `Booking confirmed | ${siteConfig.bookingLabel}`}
  description={
    defaultPending
      ? `${hostName} still needs to confirm or decline this booking. Google Calendar and the Meet link are created only after he accepts.`
      : "Booking confirmed. Check your email for the Google Meet link and calendar invite, then bring the bottleneck you want named."
  }
  path="/book/thanks"
  metaRobots="noindex,follow"
  lastUpdated={false}
  showAnnouncement={false}
  stickyBookCta={false}
>
  <section class="page-hero" aria-labelledby="booked-heading">
    <div class="shell" data-booking-thanks data-requires-confirmation={defaultPending ? "true" : "false"}>
      <p class="eyebrow">
        <span data-thanks-copy="pending" hidden={!defaultPending ? true : undefined}>Request sent</span>
        <span data-thanks-copy="confirmed" hidden={defaultPending ? true : undefined}>Booking confirmed</span>
      </p>
      <h1 id="booked-heading">
        <span data-thanks-copy="pending" hidden={!defaultPending ? true : undefined}>Your Growth Audit is waiting on confirmation.</span>
        <span data-thanks-copy="confirmed" hidden={defaultPending ? true : undefined}>Your Growth Audit is on the calendar.</span>
      </h1>
      <p class="lede">
        <span data-thanks-copy="pending" hidden={!defaultPending ? true : undefined}>
          {hostName} still needs to confirm or decline this booking. Until he accepts, it will not appear on Google
          Calendar and there is no Meet link yet. Watch your email for the confirmation — the calendar invite and
          video URL arrive only after that.
        </span>
        <span data-thanks-copy="confirmed" hidden={defaultPending ? true : undefined}>
          Check your email for the Google Meet link and calendar invite. Before the call, jot the bottleneck you want named —
          positioning, acquisition, conversion, retention, or operating rhythm.
        </span>
      </p>
      <div class="hero-actions">
        <a class="button button-brand" href={siteConfig.calUrl} data-cta="book-thanks-manage" rel="noreferrer" target="_blank">
          Open booking details →
        </a>
        <a class="button button-light" href={siteConfig.scorecardUrl} data-cta="book-thanks-scorecard">
          Optional: run the {siteConfig.scorecardName} first →
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Come prepared</p>
      <h2>What helps most in {siteConfig.bookingCallDurationPhrase}.</h2>
      <ul class="bring-checklist">
        <li><strong>Rough funnel numbers</strong>, traffic, demos, close rate, or whatever you track weekly.</li>
        <li><strong>Main channels</strong>, where pipeline comes from today, even if it is messy.</li>
        <li><strong>One constraint hypothesis</strong>, what you think is blocking growth, so we can confirm or rewrite it.</li>
      </ul>
      <p class="lede" style="margin-top:1.25rem;max-width:56ch;">
        No deck. Default outcome: a named constraint and a clear next move — including a no if we are not the right help.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <p class="eyebrow">After the call</p>
      <h2>{community.name}</h2>
      <p class="lede" style="max-width:56ch;">
        {community.blurb} Optional, not a pitch — a WhatsApp group for founders who want to keep talking about what to do next.
      </p>
      <div class="hero-actions" style="margin-top:1.25rem;">
        <a
          class="button button-brand"
          href={community.whatsappUrl}
          data-cta="book-thanks-growing-pains"
          rel="noreferrer"
          target="_blank"
        >
          {community.whatsappLabel} →
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var KEY = "wss_booking_status";
      var root = document.querySelector("[data-booking-thanks]");
      if (!root) return;
      var requires = root.getAttribute("data-requires-confirmation") === "true";

      function state() {
        try {
          var params = new URLSearchParams(window.location.search);
          var qStatus = (params.get("status") || "").toLowerCase();
          if (params.get("pending") === "1" || qStatus === "pending") return "pending";
          if (params.get("confirmed") === "1" || qStatus === "confirmed" || qStatus === "accepted") {
            return "confirmed";
          }
          var stored = sessionStorage.getItem(KEY) || "";
          if (stored === "pending" || stored === "confirmed") return stored;
        } catch (_) {}
        return requires ? "pending" : "confirmed";
      }

      var current = state();
      var nodes = root.querySelectorAll("[data-thanks-copy]");
      for (var i = 0; i < nodes.length; i++) {
        nodes[i].hidden = nodes[i].getAttribute("data-thanks-copy") !== current;
      }
    })();
  </script>
</BaseLayout>
