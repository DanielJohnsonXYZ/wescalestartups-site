---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  buyerFaqs,
  canonicalProofMetrics,
  proofEcosystemLogos,
  serviceSnapshots,
  siteConfig,
  testimonials
} from "../site";
import { buildFaqSchema } from "../lib/schema";
import EmailSignup from "../components/EmailSignup.astro";
import WhatsAppCta from "../components/WhatsAppCta.astro";
import "../styles/home.css";

const faqSchema = buildFaqSchema([...buyerFaqs]);
const homepageQuotes = testimonials;

// Optional real photos: add `image: "/images/testimonials/<name>.webp"` to any
// testimonial in site.ts and it replaces the initials avatar automatically.
const quoteImage = (quote: (typeof testimonials)[number]): string | undefined =>
  "image" in quote ? (quote as { image?: string }).image : undefined;

const quoteInitials = (name: string) =>
  name
    .split(/\s+/)
    .map((word) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

// TODO(Daniel): drop the "What the hell is growth?" YouTube video ID in here
// (the bit after watch?v=) and the embed goes live automatically.
const growthVideoId = "";

const foundations = [
  "We can describe our best customer in one sentence",
  "We talk to customers every single week",
  "Growth ideas become experiments, not debates",
  "We trust our numbers enough to bet budget on them",
  "Growth runs on a weekly rhythm, not founder heroics"
];

const principles = [
  {
    number: "01",
    title: "Research. Know the customer cold.",
    body: "The teams that win understand their market better than anyone else in it. We build real customer evidence: interviews, data, objections and alternatives, sharp enough to bet budget on."
  },
  {
    number: "02",
    title: "Experiment. Place smart bets.",
    body: "Every growth idea becomes a structured experiment with a hypothesis, a threshold and an owner, so you learn faster than competitors can copy."
  },
  {
    number: "03",
    title: "Test. Let evidence decide.",
    body: "We test relentlessly and keep score honestly. What works gets more fuel. What does not gets killed quickly and cheaply, before it burns the quarter."
  }
];

const constraints = [
  {
    key: "customer",
    number: "01",
    label: "Customer",
    short: "ICP too broad",
    symptom: "Everyone could use it. Nobody feels it is built for them.",
    title: "The customer picture is too broad to convert.",
    description: "Narrowing is growth. We define exactly who this is for, who it is not for, and collect the customer evidence that earns the next budget decision.",
    service: "Growth Diagnosis",
    href: "/services/growth-diagnosis",
    meta: "£2k–£4k · 1 week"
  },
  {
    key: "positioning",
    number: "02",
    label: "Offer & positioning",
    short: "Story does not land",
    symptom: "Demos go well. Pipeline does not follow.",
    title: "Your story lands in the room, not in the market.",
    description: "We rebuild the offer and message against the customer's real alternatives, then test it live with a pre-agreed threshold for what counts as signal.",
    service: "90-Day Growth Sprint",
    href: "/services/90-day-growth-sprint",
    meta: "£8k–£12k · 12 weeks"
  },
  {
    key: "acquisition",
    number: "03",
    label: "Acquisition",
    short: "One-channel risk",
    symptom: "If one engine dips, the quarter dips with it.",
    title: "One channel is carrying the whole funnel.",
    description: "We design the second engine, connect the channels into one decision view, and install the weekly rule for what to scale, stop or repair.",
    service: "Acquisition System Build",
    href: "/services/acquisition-system-build",
    meta: "£15k–£25k · 8–12 weeks"
  },
  {
    key: "evidence",
    number: "04",
    label: "Experiments & evidence",
    short: "Decisions on opinion",
    symptom: "Dashboards disagree. Tests never conclude.",
    title: "Growth decisions are running on opinion.",
    description: "Every test gets a hypothesis, threshold and kill criterion. Your team gets one trusted weekly view and three possible calls: scale, stop or fix.",
    service: "Acquisition System Build",
    href: "/services/acquisition-system-build",
    meta: "£15k–£25k · 8–12 weeks"
  },
  {
    key: "team",
    number: "05",
    label: "Growth loop",
    short: "Founder bottleneck",
    symptom: "Every campaign and brief still routes through you.",
    title: "The founder is still the operating system.",
    description: "We install senior judgement, decision rights and a weekly cadence inside the team, then deliberately transfer ownership so pipeline no longer waits for you.",
    service: "Fractional CMO",
    href: "/services/fractional-cmo",
    meta: "£5k–£8k/mo · 3-month minimum"
  }
];

const selectedConstraint = constraints[4];

const fitFor = [
  "Post-PMF B2B SaaS and AI startups, Seed to Series B.",
  "Real traction, inconsistent pipeline.",
  "A founder who still owns too many growth decisions.",
  "A team that needs one operating system, not more disconnected execution.",
  "Leaders willing to share the numbers every week."
];

const notFor = [
  "Pre-PMF products still searching for fit.",
  "Teams wanting only ads management.",
  "Founders looking for a one-off campaign.",
  "Volume buyers who want more activity rather than fewer, sharper decisions.",
  "Companies unwilling to share numbers weekly."
];

const timeline = [
  {
    when: "Week 1",
    title: "Set the goal, then research",
    body: "Agree the growth goal and how it gets measured. Then the research: customer evidence, funnel data and founder context, plus the reporting baseline to measure against."
  },
  {
    when: "Weeks 2–4",
    title: "Design & launch",
    body: "ICP, offer and channel architecture. First tests live. The weekly decision meeting starts and keeps its slot."
  },
  {
    when: "Month 2",
    title: "Scale the signal",
    body: "Double down on the strongest channel and repair the conversion leaks the tests exposed. One dashboard, trusted."
  },
  {
    when: "Month 3",
    title: "Transfer ownership",
    body: "Cadence documented, dashboard owned and decisions made by the team. The founder leaves the loop deliberately."
  },
  {
    when: "Day 90",
    title: "Board-ready review",
    body: "What moved, what did not, and next quarter's plan, with a system your team can run on its own."
  }
];

const caseStudies = [
  {
    type: "Paid · Healthtech · Fractional CMO",
    name: "Healthtech (anon.)",
    logo: "/images/logos/healthtech-anon.svg",
    logoWidth: 189,
    logoHeight: 40,
    context: "Precision medicine · Marketing function from zero",
    body: "Built the marketing operation from scratch: outbound, events and agency coordination. The CEO moved from doing everything to a weekly review, with the system left in the team.",
    stats: [
      ["464", "Media placements"],
      ["18", "Clinicians in pilot"],
      ["30–40%", "LinkedIn accept rate"]
    ],
    href: "/case-studies/healthtech-precision-medicine",
    feature: true
  },
  {
    type: "Paid · Fintech",
    name: "Ned",
    logo: "/images/logos/ned.svg",
    logoWidth: 220,
    logoHeight: 72,
    context: "Funding platform · Paid search + SEO",
    body: "500+ sign-ups in two months from paid search, with an 8.6% CTR and $0.74 CPC.",
    stats: [
      ["500+", "Sign-ups"],
      ["8.6%", "CTR"]
    ],
    href: "/case-studies/ned",
    feature: false
  },
  {
    type: "Paid · Healthtech",
    name: "eQuoo",
    logo: "/images/logos/equoo.svg",
    logoWidth: 220,
    logoHeight: 72,
    context: "Mental-health app · Fractional CMO",
    body: "A clearer acquisition narrative and channel hierarchy for a trust-sensitive category.",
    stats: [
      ["1", "Clear narrative"],
      ["1", "Channel hierarchy"]
    ],
    href: "/case-studies/equoo",
    feature: false
  }
];

const subAudiences = [
  {
    title: "Investors & funds",
    body: "Diagnose growth across a portfolio in two weeks. The same framework, applied across companies.",
    href: "/resources/vc-portfolio-growth-diagnosis",
    label: "Portfolio diagnosis"
  },
  {
    title: "Corporate & accelerator partners",
    body: "Workshops, keynote talks and programme advisory for cohorts and innovation teams.",
    href: "/speaking",
    label: "Speaking & workshops"
  },
  {
    title: "Operators, advisors & referrers",
    body: "Refer a founder, come on Luck Doesn't Scale, or partner on a deal. Drop a line.",
    href: "/contact",
    label: "Get in touch"
  }
];
---

<BaseLayout
  title="Growth Systems for AI Startups & B2B SaaS | We Scale Startups"
  description="Growth systems for post-PMF AI startups and B2B SaaS: customer research, focused experiments, acquisition infrastructure, and a testing rhythm your team owns."
  path="/"
  schema={faqSchema}
 
  showAnnouncement={false}
  stickyBookCta={false}
>
  <div class="v9-scroll-progress" aria-hidden="true"></div>

  <section class="v9-hero" id="top" aria-labelledby="v9-hero-title">
    <div class="v9-aurora v9-aurora-one" aria-hidden="true"></div>
    <div class="v9-aurora v9-aurora-two" aria-hidden="true"></div>
    <div class="shell">
      <div class="v9-hero-grid">
        <div class="v9-hero-copy">
          <div class="eyebrow">
            <span class="v9-live-dot" aria-hidden="true"></span>
            Sustainable growth for AI startups &amp; B2B SaaS
          </div>
          <h1 id="v9-hero-title">Sustainable, high-quality growth for <em>AI startups.</em></h1>
          <p class="v9-hero-lede">Most startups do not stall because the product is weak. They stall because growth is a chase: a new channel every month, nothing that compounds. Our structured, proven, step-by-step process takes you from chasing growth to <strong>predictable, repeatable, scalable growth.</strong></p>
          <div class="v9-hero-actions">
            <a class="button button-brand" href={siteConfig.bookingUrl} data-cta="v9-hero-book">
              <span>Grow your AI startup</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="v9-text-link" href={siteConfig.scorecardUrl} data-cta="v9-hero-scorecard">
              Find my bottleneck <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="v9-hero-reassurance">
            <span>Free</span>
            <span>20 minutes</span>
            <span>No pitch</span>
            <span>Leave with your next move</span>
          </div>
        </div>

        <div class="v9-os-card v9-hover-glow">
          <div class="v9-os-head">
            <div>
              <span class="v9-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>WSS / Foundations Check</span>
            </div>
            <span class="v9-system-status"><i aria-hidden="true"></i> Live</span>
          </div>
          <div class="v9-found-list" role="group" aria-label="Growth foundations checklist. Toggle each statement that is true for your team.">
            {foundations.map((item) => (
              <button type="button" class="v9-found-item" aria-pressed="false">
                <i aria-hidden="true">✓</i>
                <span>{item}</span>
              </button>
            ))}
          </div>
          <div class="v9-found-score">
            <div class="v9-found-score-top">
              <span>Foundations in place</span>
              <strong id="v9-found-count">0 / 5</strong>
            </div>
            <div class="v9-found-bar" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            <p class="v9-found-verdict" id="v9-found-verdict" aria-live="polite">Tap everything that is true for your team. Thirty seconds, honest answers.</p>
            <a href={siteConfig.bookingUrl} data-cta="v9-hero-foundations">Talk it through with Daniel →</a>
          </div>
        </div>
      </div>

      <div class="v9-metric-rail" aria-label="We Scale Startups track record">
        {canonicalProofMetrics.slice(0, 4).map((metric, index) => (
          <div class="v9-metric">
            <span class="v9-metric-index">0{index + 1}</span>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-community" aria-labelledby="v9-community-title">
    <div class="shell">
      <div class="v9-section-intro">
        <span class="v9-section-number">Stay close</span>
        <p>Two low-effort ways to keep learning between calls. No pitch either way.</p>
      </div>
      <div class="v9-community-heading">
        <h2 id="v9-community-title">Get the note. <em>Or join the room.</em></h2>
      </div>
      <div class="v9-community-grid">
        <div class="v9-community-newsletter v9-hover-glow">
          <EmailSignup
            variant="light"
            formId="home-community-newsletter"
            sourceType="newsletter"
            buttonLabel="Get the note ->"
          />
        </div>
        <div class="v9-community-whatsapp v9-hover-glow">
          <span class="v9-community-kicker">Founder WhatsApp group</span>
          <h3>Compare notes with founders in the same fight</h3>
          <p>
            A WhatsApp group for founders and operators working the same problem: pipeline,
            positioning, and growth systems that actually hold up. No pitching, no noise,
            just people comparing what's working right now.
          </p>
          <WhatsAppCta
            class="button button-acid"
            label="Join the WhatsApp group"
            cta="home-community-whatsapp"
          />
          <p class="v9-community-fine">Free to join. Leave any time.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="v9-credibility" aria-labelledby="v9-credibility-title">
    <div class="shell">
      <div class="v9-credibility-head">
        <p id="v9-credibility-title">Trusted across startup programmes, classrooms and founder teams</p>
        <span>Relationships labelled clearly. No implied client logos.</span>
      </div>
      <div class="v9-logo-track">
        {proofEcosystemLogos.map((logo) => (
          <div class="v9-logo-item">
            <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
            <span>{logo.relationship}</span>
          </div>
        ))}
      </div>
    </div>
  </section>


  <div class="v9-ticker" aria-hidden="true">
    <div class="v9-ticker-track">
      {Array.from({ length: 6 }).map(() => (
        <span>Research <i>→</i> Experiment <i>→</i> Test <i>→</i> Scale <i>→</i></span>
      ))}
    </div>
  </div>

  <section class="v9-thesis" id="approach" aria-labelledby="v9-thesis-title">
    <div class="shell">
      <div class="v9-section-intro v9-section-intro-dark">
        <span class="v9-section-number">01 / The thesis</span>
        <p>Why good products still get stuck</p>
      </div>
      <div class="v9-thesis-grid">
        <div>
          <h2 id="v9-thesis-title">Most post-PMF startups do not have a product problem. They have a <em>customer understanding problem.</em></h2>
          <p class="v9-thesis-lede">You cannot grow a market you do not understand. When nobody owns customer insight, every channel, message and launch is a guess, and guesses do not compound.</p>
        </div>
        <figure class="v9-teaching-card v9-hover-glow">
          <img src="/images/speaking/daniel-speaking-nomad-960.webp" alt="Daniel Johnson teaching the growth system to a founder cohort" width="960" height="640" loading="lazy" decoding="async" />
          <figcaption>
            <span>In the room, not on the sidelines</span>
            <strong>Teaching acquisition systems to a founder cohort</strong>
          </figcaption>
        </figure>
      </div>
      <div class="v9-principle-grid">
        {principles.map((principle) => (
          <article class="v9-principle v9-hover-glow">
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-system" id="system" aria-labelledby="v9-system-title">
    <div class="shell">
      <div class="v9-section-intro">
        <span class="v9-section-number">02 / Find your constraint</span>
        <p>Click the constraint that sounds like your team</p>
      </div>
      <div class="v9-system-heading">
        <h2 id="v9-system-title">Growth gets simpler when you <em>understand your customers.</em></h2>
        <p>Five places where customer understanding usually breaks down. Click the one that sounds most like your team, <strong>and see the way through.</strong></p>
      </div>

      <div class="v9-diagnostic">
        <div class="v9-constraint-tabs" role="tablist" aria-label="Growth constraints">
          {constraints.map((constraint) => (
            <button
              type="button"
              class:list={["v9-constraint-tab", { "is-active": constraint.key === selectedConstraint.key }]}
              role="tab"
              aria-selected={constraint.key === selectedConstraint.key ? "true" : "false"}
              tabindex={constraint.key === selectedConstraint.key ? 0 : -1}
              data-constraint={constraint.key}
              data-number={constraint.number}
              data-label={constraint.label}
              data-title={constraint.title}
              data-description={constraint.description}
              data-service={constraint.service}
              data-href={constraint.href}
              data-meta={constraint.meta}
            >
              <span>{constraint.number}</span>
              <span>
                <strong>{constraint.short}</strong>
                <small>{constraint.label}</small>
              </span>
              <i aria-hidden="true">↗</i>
            </button>
          ))}
        </div>

        <div class="v9-diagnostic-output v9-hover-glow" role="tabpanel" aria-live="polite">
          <div class="v9-output-topline">
            <span id="v9-output-meta">{selectedConstraint.number} / {selectedConstraint.label}</span>
            <span>Recommended next move</span>
          </div>
          <div class="v9-output-signal">
            <span>Constraint detected</span>
            <i aria-hidden="true"></i>
          </div>
          <h3 id="v9-output-title">{selectedConstraint.title}</h3>
          <p id="v9-output-description">{selectedConstraint.description}</p>
          <div class="v9-output-recommendation">
            <div>
              <span>Best-fit engagement</span>
              <strong id="v9-output-service">{selectedConstraint.service}</strong>
              <small id="v9-output-price">{selectedConstraint.meta}</small>
            </div>
            <a id="v9-output-link" class="button button-dark" href={selectedConstraint.href}>Explore this engagement <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v9-fit" aria-labelledby="v9-fit-title">
    <div class="shell">
      <div class="v9-section-intro">
        <span class="v9-section-number">03 / Self-qualify</span>
        <p>Better to know in 30 seconds than 15 minutes into a call</p>
      </div>
      <h2 id="v9-fit-title">Built for some teams. <em>Not for others.</em></h2>
      <div class="v9-fit-grid">
        <div class="v9-fit-card v9-fit-yes">
          <div class="v9-fit-card-head"><span>✓</span><strong>Built for</strong></div>
          <ul>{fitFor.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="v9-fit-card v9-fit-no">
          <div class="v9-fit-card-head"><span>×</span><strong>Not for</strong></div>
          <ul>{notFor.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>

      <div class="v9-fit-video v9-hover-glow">
        <div>
          <span class="v9-section-number">For the "not yet" teams</span>
          <h3>What the hell is growth, anyway?</h3>
          <p>If you read the right-hand column and thought "that's us", don't book a call yet. Watch this first: what growth actually is, and the foundations to build before you spend a pound on channels.</p>
        </div>
        {growthVideoId ? (
          <div class="v9-video-frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${growthVideoId}`}
              title="What the hell is growth?"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        ) : (
          <a class="v9-video-frame v9-video-placeholder" href="/growth-operating-system">
            <span aria-hidden="true">→</span>
            <strong>Read: What a growth operating system actually does</strong>
            <small>A practical guide to the research, experiment, test, and transfer rhythm</small>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="v9-work" id="work" aria-labelledby="v9-work-title">
    <div class="shell">
      <div class="v9-section-intro v9-section-intro-dark">
        <span class="v9-section-number">04 / Four engagements, one ladder</span>
        <p>Start with the smallest commitment that answers the biggest question</p>
      </div>
      <div class="v9-work-heading">
        <h2 id="v9-work-title">Different relationships come in <em>all shapes and sizes.</em></h2>
        <a class="v9-text-link" href="/pricing">Compare all pricing →</a>
      </div>
      <div class="v9-service-grid">
        {serviceSnapshots.map((service, index) => (
          <article class:list={["v9-service-card", "v9-hover-glow", { "is-featured": index === 2 }]}>
            <div class="v9-service-head">
              <span>0{index + 1}</span>
              <span>{service.badge}</span>
            </div>
            <h3>{service.title}</h3>
            <div class="v9-service-price"><strong>{service.price}</strong><span>{service.timeline}</span></div>
            <p>{service.bestFor}</p>
            <ul>{service.keyDeliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
            <a href={service.href}>{service.cta} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>

      <div class="v9-timeline-wrap" aria-labelledby="v9-timeline-title">
        <div class="v9-timeline-heading">
          <span>After you book</span>
          <h3 id="v9-timeline-title">What actually happens in 90 days</h3>
          <p>Not a strategy deck and a wave goodbye. A week-by-week operating programme with a handoff date.</p>
        </div>
        <ol class="v9-timeline">
          {timeline.map((step, index) => (
            <li class:list={{ "is-final": index === timeline.length - 1 }}>
              <div class="v9-timeline-marker"><span>{index + 1}</span></div>
              <span>{step.when}</span>
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="v9-results" id="results" aria-labelledby="v9-results-title">
    <div class="shell">
      <div class="v9-section-intro">
        <span class="v9-section-number">05 / Real engagements</span>
        <p>Paid work is labelled as paid work. Teaching is labelled as teaching.</p>
      </div>
      <div class="v9-results-heading">
        <h2 id="v9-results-title">We've worked with some lovely people <em>along the way.</em></h2>
        <a class="v9-text-link" href="/case-studies">All case studies →</a>
      </div>
      <div class="v9-case-grid">
        {caseStudies.map((study) => (
          <article class:list={["v9-case-card", "v9-hover-glow", { "is-featured": study.feature }]}>
            <div class="v9-case-topline"><span>{study.type}</span><img src={study.logo} alt="" width={study.logoWidth} height={study.logoHeight} loading="lazy" decoding="async" /></div>
            <h3>{study.name}</h3>
            <span class="v9-case-context">{study.context}</span>
            <p>{study.body}</p>
            <div class="v9-case-stats">
              {study.stats.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
            </div>
            <a href={study.href}>Read the case study <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>


  <div class="v9-ticker" aria-hidden="true">
    <div class="v9-ticker-track">
      {Array.from({ length: 6 }).map(() => (
        <span>Research <i>→</i> Experiment <i>→</i> Test <i>→</i> Scale <i>→</i></span>
      ))}
    </div>
  </div>

  <section class="v9-voices" aria-labelledby="v9-voices-title">
    <div class="shell">
      <div class="v9-voices-heading">
        <div>
          <span class="v9-section-number">06 / Founder voices</span>
          <h2 id="v9-voices-title">What it feels like when growth finally has a rhythm.</h2>
        </div>
        <div class="v9-rating-lockup">
          <strong>4.93/5</strong>
