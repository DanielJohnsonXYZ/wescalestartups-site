---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  buyerFaqs,
  canonicalProofMetrics,
  proofEcosystemLogos,
  serviceSnapshots,
  siteConfig,
  testimonials
} from "../site";
import { buildFaqSchema } from "../lib/schema";
import "../styles/home-v9.css";

const faqSchema = buildFaqSchema([...buyerFaqs]);
const homepageQuotes = testimonials
  .filter((testimonial) => testimonial.category === "paid-client" || testimonial.category === "paid-advisory")
  .slice(0, 3);

const principles = [
  {
    number: "01",
    title: "Name the constraint first.",
    body: "More budget against an unnamed bottleneck buys activity, not pipeline. We begin by naming the one constraint binding growth."
  },
  {
    number: "02",
    title: "Install a rhythm, not a hero.",
    body: "A weekly decision cadence your team owns beats a brilliant operator who leaves. We build the system, then transfer it."
  },
  {
    number: "03",
    title: "Build to hand off.",
    body: "Success is the quarter the system runs without us: reporting trusted, decisions made on schedule, founder out of the loop."
  }
];

const constraints = [
  {
    key: "customer",
    number: "01",
    label: "Customer",
    short: "ICP too broad",
    symptom: "Everyone could use it. Nobody feels it is built for them.",
    title: "The customer picture is too broad to convert.",
    description: "Narrowing is growth. We define exactly who this is for, who it is not for, and collect the customer evidence that earns the next budget decision.",
    service: "Growth Diagnosis",
    href: "/services/growth-diagnosis",
    meta: "from £2k · 1 week"
  },
  {
    key: "positioning",
    number: "02",
    label: "Offer & positioning",
    short: "Story does not land",
    symptom: "Demos go well. Pipeline does not follow.",
    title: "Your story lands in the room, not in the market.",
    description: "We rebuild the offer and message against the customer's real alternatives, then test it live with a pre-agreed threshold for what counts as signal.",
    service: "90-Day Growth Sprint",
    href: "/services/90-day-growth-sprint",
    meta: "from £8k · 12 weeks"
  },
  {
    key: "acquisition",
    number: "03",
    label: "Acquisition",
    short: "One-channel risk",
    symptom: "If one engine dips, the quarter dips with it.",
    title: "One channel is carrying the whole funnel.",
    description: "We design the second engine, connect the channels into one decision view, and install the weekly rule for what to scale, stop or repair.",
    service: "Acquisition System Build",
    href: "/services/acquisition-system-build",
    meta: "from £15k · 8–12 weeks"
  },
  {
    key: "evidence",
    number: "04",
    label: "Experiments & evidence",
    short: "Decisions on opinion",
    symptom: "Dashboards disagree. Tests never conclude.",
    title: "Growth decisions are running on opinion.",
    description: "Every test gets a hypothesis, threshold and kill criterion. Your team gets one trusted weekly view and three possible calls: scale, stop or fix.",
    service: "Acquisition System Build",
    href: "/services/acquisition-system-build",
    meta: "from £15k · 8–12 weeks"
  },
  {
    key: "team",
    number: "05",
    label: "Growth loop",
    short: "Founder bottleneck",
    symptom: "Every campaign and brief still routes through you.",
    title: "The founder is still the operating system.",
    description: "We install senior judgement, decision rights and a weekly cadence inside the team—then deliberately transfer ownership so pipeline no longer waits for you.",
    service: "Fractional CMO",
    href: "/services/fractional-cmo",
    meta: "from £5k/mo · 3-month minimum"
  }
];

const selectedConstraint = constraints[4];

const fitFor = [
  "Post-PMF B2B SaaS and AI startups, Seed to Series B.",
  "Real traction, inconsistent pipeline.",
  "A founder who still owns too many growth decisions.",
  "A team that needs one operating system, not more disconnected execution.",
  "Leaders willing to share the numbers every week."
];

const notFor = [
  "Pre-PMF products still searching for fit.",
  "Teams wanting only ads management.",
  "Founders looking for a one-off campaign.",
  "Volume buyers who want more activity rather than fewer, sharper decisions.",
  "Companies unwilling to share numbers weekly."
];

const timeline = [
  {
    when: "Week 1",
    title: "Name the constraint",
    body: "Evidence review, funnel data and founder context. One bottleneck named in plain English, with a reporting baseline."
  },
  {
    when: "Weeks 2–4",
    title: "Design & launch",
    body: "ICP, offer and channel architecture. First tests live. The weekly decision meeting starts and keeps its slot."
  },
  {
    when: "Month 2",
    title: "Scale the signal",
    body: "Double down on the strongest channel and repair the conversion leaks the tests exposed. One dashboard, trusted."
  },
  {
    when: "Month 3",
    title: "Transfer ownership",
    body: "Cadence documented, dashboard owned and decisions made by the team. The founder leaves the loop deliberately."
  },
  {
    when: "Day 90",
    title: "Board-ready review",
    body: "What moved, what did not, and next quarter's plan—with a system that runs without you in every decision."
  }
];

const caseStudies = [
  {
    type: "Paid · Healthtech · Fractional CMO",
    name: "Healthtech (anon.)",
    logo: "/images/logos/healthtech-anon.svg",
    context: "Precision medicine · Marketing function from zero",
    body: "Built the marketing operation from scratch: outbound, events and agency coordination. The CEO moved from doing everything to a weekly review, with the system left in the team.",
    stats: [
      ["464", "Media placements"],
      ["18", "Clinicians in pilot"],
      ["30–40%", "LinkedIn accept rate"]
    ],
    href: "/case-studies/healthtech-precision-medicine",
    feature: true
  },
  {
    type: "Paid · Fintech",
    name: "Ned",
    logo: "/images/logos/ned.svg",
    context: "Funding platform · Paid search + SEO",
    body: "500+ sign-ups in two months from paid search, with an 8.6% CTR and $0.74 CPC.",
    stats: [
      ["500+", "Sign-ups"],
      ["8.6%", "CTR"]
    ],
    href: "/case-studies/ned",
    feature: false
  },
  {
    type: "Paid · Healthtech",
    name: "eQuoo",
    logo: "/images/logos/equoo.svg",
    context: "Mental-health app · Fractional CMO",
    body: "A clearer acquisition narrative and channel hierarchy for a trust-sensitive category.",
    stats: [
      ["1", "Clear narrative"],
      ["1", "Channel hierarchy"]
    ],
    href: "/case-studies/equoo",
    feature: false
  }
];

const subAudiences = [
  {
    title: "Investors & funds",
    body: "Diagnose growth across a portfolio in two weeks. The same framework, applied across companies.",
    href: "/resources/vc-portfolio-growth-diagnosis",
    label: "Portfolio diagnosis"
  },
  {
    title: "Corporate & accelerator partners",
    body: "Workshops, keynote talks and programme advisory for cohorts and innovation teams.",
    href: "/speaking",
    label: "Speaking & workshops"
  },
  {
    title: "Operators, advisors & referrers",
    body: "Refer a founder, come on the podcast or partner on a deal. Drop a line.",
    href: "/contact",
    label: "Get in touch"
  }
];
---

<BaseLayout
  title="We Scale Startups | Growth Systems for Seed–Series B B2B SaaS & AI"
  description="We diagnose the growth bottleneck, install the acquisition system, and transfer the weekly rhythm so post-PMF B2B SaaS and AI teams can run pipeline without founder heroics."
  path="/"
  schema={faqSchema}
  bodyClass="page-home-v9"
  showAnnouncement={false}
  stickyBookCta={false}
>
  <div class="v9-scroll-progress" aria-hidden="true"></div>

  <section class="v9-hero" id="top" aria-labelledby="v9-hero-title">
    <div class="v9-aurora v9-aurora-one" aria-hidden="true"></div>
    <div class="v9-aurora v9-aurora-two" aria-hidden="true"></div>
    <div class="v9-shell">
      <div class="v9-hero-grid">
        <div class="v9-hero-copy">
          <div class="v9-kicker">
            <span class="v9-live-dot" aria-hidden="true"></span>
            Growth systems for Seed–Series B B2B SaaS &amp; AI
          </div>
          <h1 id="v9-hero-title">Build a growth system your team can run <em>without you.</em></h1>
          <p class="v9-hero-lede">Your product is ahead of your pipeline. We diagnose the constraint, install the acquisition system and transfer the weekly growth rhythm in 90 days—<strong>so revenue compounds without the founder in every decision.</strong></p>
          <div class="v9-hero-actions">
            <a class="v9-button v9-button-primary" href={siteConfig.bookingUrl} data-cta="v9-hero-book">
              <span>{siteConfig.bookingLabel}</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="v9-text-link" href={siteConfig.scorecardUrl} data-cta="v9-hero-scorecard">
              Find my bottleneck <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="v9-hero-reassurance">
            <span>Free</span>
            <span>20 minutes</span>
            <span>No pitch</span>
            <span>Leave with the constraint named</span>
          </div>
        </div>

        <div class="v9-os-card v9-hover-glow">
          <div class="v9-os-head">
            <div>
              <span class="v9-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>WSS / Growth OS</span>
            </div>
            <span class="v9-system-status"><i aria-hidden="true"></i> System online</span>
          </div>
          <div class="v9-os-stage">
            <div class="v9-os-input">
              <span>Current state</span>
              <strong>Founder-dependent growth</strong>
              <small>Scattered activity · slow decisions · one-person bottleneck</small>
            </div>
            <div class="v9-os-flow" role="img" aria-label="Diagnose, prove, install and transfer the growth system">
              <div class="v9-flow-line" aria-hidden="true"></div>
              <div class="v9-flow-step"><span>01</span><strong>Diagnose</strong><i aria-hidden="true"></i></div>
              <div class="v9-flow-step"><span>02</span><strong>Prove</strong><i aria-hidden="true"></i></div>
              <div class="v9-flow-step"><span>03</span><strong>Install</strong><i aria-hidden="true"></i></div>
              <div class="v9-flow-step"><span>04</span><strong>Transfer</strong><i aria-hidden="true"></i></div>
            </div>
            <div class="v9-os-output">
              <span>Day 90 state</span>
              <strong>Team-owned pipeline</strong>
              <small>One cadence · trusted reporting · decisions on schedule</small>
            </div>
          </div>
          <div class="v9-os-proof">
            <div>
              <span>Selected client signal</span>
              <strong>500+ sign-ups</strong>
              <small>in two months · Fintech</small>
            </div>
            <div class="v9-os-proof-chart" aria-hidden="true">
              <i style="--bar: 30%"></i><i style="--bar: 45%"></i><i style="--bar: 38%"></i><i style="--bar: 58%"></i><i style="--bar: 74%"></i><i style="--bar: 96%"></i>
            </div>
            <a href="/case-studies/ned" aria-label="Read the Ned fintech case study">View proof →</a>
          </div>
        </div>
      </div>

      <div class="v9-metric-rail" aria-label="We Scale Startups track record">
        {canonicalProofMetrics.slice(0, 4).map((metric, index) => (
          <div class="v9-metric">
            <span class="v9-metric-index">0{index + 1}</span>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-credibility" aria-labelledby="v9-credibility-title">
    <div class="v9-shell">
      <div class="v9-credibility-head">
        <p id="v9-credibility-title">Trusted across startup programmes, classrooms and founder teams</p>
        <span>Relationships labelled clearly. No implied client logos.</span>
      </div>
      <div class="v9-logo-track">
        {proofEcosystemLogos.map((logo) => (
          <div class="v9-logo-item">
            <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
            <span>{logo.relationship}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-thesis" id="approach" aria-labelledby="v9-thesis-title">
    <div class="v9-shell">
      <div class="v9-section-intro v9-section-intro-dark">
        <span class="v9-section-number">01 / The thesis</span>
        <p>Why good products still get stuck</p>
      </div>
      <div class="v9-thesis-grid">
        <div>
          <h2 id="v9-thesis-title">Most post-PMF startups do not have a product problem. They have a <em>distribution problem.</em></h2>
          <p class="v9-thesis-lede">Every growth decision still routes through the founder, so pipeline moves at the speed of one person.</p>
        </div>
        <figure class="v9-teaching-card v9-hover-glow">
          <img src="/images/speaking/daniel-speaking-nomad-960.webp" alt="Daniel Johnson teaching the growth system to a founder cohort" width="960" height="640" loading="lazy" decoding="async" />
          <figcaption>
            <span>In the room, not on the sidelines</span>
            <strong>Teaching acquisition systems to a founder cohort</strong>
          </figcaption>
        </figure>
      </div>
      <div class="v9-principle-grid">
        {principles.map((principle) => (
          <article class="v9-principle v9-hover-glow">
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-system" id="system" aria-labelledby="v9-system-title">
    <div class="v9-shell">
      <div class="v9-section-intro">
        <span class="v9-section-number">02 / The operating system</span>
        <p>Click the constraint that sounds like your team</p>
      </div>
      <div class="v9-system-heading">
        <h2 id="v9-system-title">Growth gets simpler when you name what is <em>actually</em> stuck.</h2>
        <p>Five constraints. One binding bottleneck. No decision earns budget on opinion alone—evidence must move from <strong>word → action → money.</strong></p>
      </div>

      <div class="v9-diagnostic">
        <div class="v9-constraint-tabs" role="tablist" aria-label="Growth constraints">
          {constraints.map((constraint) => (
            <button
              type="button"
              class:list={["v9-constraint-tab", { "is-active": constraint.key === selectedConstraint.key }]}
              role="tab"
              aria-selected={constraint.key === selectedConstraint.key ? "true" : "false"}
              tabindex={constraint.key === selectedConstraint.key ? 0 : -1}
              data-constraint={constraint.key}
              data-number={constraint.number}
              data-label={constraint.label}
              data-title={constraint.title}
              data-description={constraint.description}
              data-service={constraint.service}
              data-href={constraint.href}
              data-meta={constraint.meta}
            >
              <span>{constraint.number}</span>
              <span>
                <strong>{constraint.short}</strong>
                <small>{constraint.label}</small>
              </span>
              <i aria-hidden="true">↗</i>
            </button>
          ))}
        </div>

        <div class="v9-diagnostic-output v9-hover-glow" role="tabpanel" aria-live="polite">
          <div class="v9-output-topline">
            <span id="v9-output-meta">{selectedConstraint.number} / {selectedConstraint.label}</span>
            <span>Recommended next move</span>
          </div>
          <div class="v9-output-signal">
            <span>Constraint detected</span>
            <i aria-hidden="true"></i>
          </div>
          <h3 id="v9-output-title">{selectedConstraint.title}</h3>
          <p id="v9-output-description">{selectedConstraint.description}</p>
          <div class="v9-output-recommendation">
            <div>
              <span>Best-fit engagement</span>
              <strong id="v9-output-service">{selectedConstraint.service}</strong>
              <small id="v9-output-price">{selectedConstraint.meta}</small>
            </div>
            <a id="v9-output-link" class="v9-button v9-button-dark" href={selectedConstraint.href}>Explore this engagement <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v9-fit" aria-labelledby="v9-fit-title">
    <div class="v9-shell">
      <div class="v9-section-intro">
        <span class="v9-section-number">03 / Self-qualify</span>
        <p>Better to know in 30 seconds than 15 minutes into a call</p>
      </div>
      <h2 id="v9-fit-title">Built for some teams. <em>Not for others.</em></h2>
      <div class="v9-fit-grid">
        <div class="v9-fit-card v9-fit-yes">
          <div class="v9-fit-card-head"><span>✓</span><strong>Built for</strong></div>
          <ul>{fitFor.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="v9-fit-card v9-fit-no">
          <div class="v9-fit-card-head"><span>×</span><strong>Not for</strong></div>
          <ul>{notFor.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="v9-work" id="work" aria-labelledby="v9-work-title">
    <div class="v9-shell">
      <div class="v9-section-intro v9-section-intro-dark">
        <span class="v9-section-number">04 / Four engagements, one ladder</span>
        <p>Start with the smallest commitment that answers the biggest question</p>
      </div>
      <div class="v9-work-heading">
        <h2 id="v9-work-title">Diagnosis names it. A sprint proves it. A build installs it. Embed operates it.</h2>
        <a class="v9-text-link v9-text-link-light" href="/pricing">Compare all pricing →</a>
      </div>
      <div class="v9-service-grid">
        {serviceSnapshots.map((service, index) => (
          <article class:list={["v9-service-card", "v9-hover-glow", { "is-featured": index === 2 }]}>
            <div class="v9-service-head">
              <span>0{index + 1}</span>
              <span>{service.badge}</span>
            </div>
            <h3>{service.title}</h3>
            <div class="v9-service-price"><strong>{service.price}</strong><span>{service.timeline}</span></div>
            <p>{service.bestFor}</p>
            <ul>{service.keyDeliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
            <a href={service.href}>{service.cta} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>

      <div class="v9-timeline-wrap" aria-labelledby="v9-timeline-title">
        <div class="v9-timeline-heading">
          <span>After you book</span>
          <h3 id="v9-timeline-title">What actually happens in 90 days</h3>
          <p>Not a strategy deck and a wave goodbye. A week-by-week operating programme with a handoff date.</p>
        </div>
        <ol class="v9-timeline">
          {timeline.map((step, index) => (
            <li class:list={{ "is-final": index === timeline.length - 1 }}>
              <div class="v9-timeline-marker"><span>{index + 1}</span></div>
              <span>{step.when}</span>
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="v9-results" id="results" aria-labelledby="v9-results-title">
    <div class="v9-shell">
      <div class="v9-section-intro">
        <span class="v9-section-number">05 / Real engagements</span>
        <p>Paid work is labelled as paid work. Teaching is labelled as teaching.</p>
      </div>
      <div class="v9-results-heading">
        <h2 id="v9-results-title">Proof that the system leaves the room with your team.</h2>
        <a class="v9-text-link" href="/case-studies">All case studies →</a>
      </div>
      <div class="v9-case-grid">
        {caseStudies.map((study) => (
          <article class:list={["v9-case-card", "v9-hover-glow", { "is-featured": study.feature }]}>
            <div class="v9-case-topline"><span>{study.type}</span><img src={study.logo} alt="" loading="lazy" decoding="async" /></div>
            <h3>{study.name}</h3>
            <span class="v9-case-context">{study.context}</span>
            <p>{study.body}</p>
            <div class="v9-case-stats">
              {study.stats.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
            </div>
            <a href={study.href}>Read the case study <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-voices" aria-labelledby="v9-voices-title">
    <div class="v9-shell">
      <div class="v9-voices-heading">
        <div>
          <span class="v9-section-number">06 / Founder voices</span>
          <h2 id="v9-voices-title">What it feels like when growth finally has a rhythm.</h2>
        </div>
        <div class="v9-rating-lockup">
          <strong>4.93/5</strong>
          <span>GrowthMentor rating<br />across 479+ sessions</span>
        </div>
      </div>
      <div class="v9-quote-grid">
        {homepageQuotes.map((quote, index) => (
          <figure class:list={["v9-quote", { "is-primary": index === 0 }]}>
            <blockquote>“{quote.quote}”</blockquote>
            <figcaption>
              <strong>{quote.name}{quote.role ? ` · ${quote.role}` : ""}</strong>
              <span>{quote.company}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-founder" id="about" aria-labelledby="v9-founder-title">
    <div class="v9-shell">
      <div class="v9-founder-grid">
        <div class="v9-founder-visual">
          <div class="v9-founder-main-image">
            <img src="/images/daniel-headshot-960.webp" alt="Daniel Johnson, founder of We Scale Startups" width="960" height="960" loading="lazy" decoding="async" />
          </div>
          <div class="v9-founder-small-image">
            <img src="/images/daniel-aircraft-640.webp" alt="Daniel Johnson in the cockpit of an aircraft" width="640" height="640" loading="lazy" decoding="async" />
          </div>
          <span class="v9-founder-caption">Daniel Johnson · Founder · Operator</span>
        </div>
        <div class="v9-founder-copy">
          <span class="v9-section-number">07 / Why I built this</span>
          <h2 id="v9-founder-title">The operator I wished had been in the room.</h2>
          <p>After 15 years operating inside SaaS, fintech, healthtech and EdTech startups—including two exits—I kept seeing the same pattern: founders with great products, stuck running marketing themselves because nobody else on the team could read the numbers and decide what to scale.</p>
          <p><strong>We Scale Startups exists to diagnose the bottleneck, install the acquisition system and transfer the weekly rhythm—so you do not need us forever.</strong></p>
          <div class="v9-founder-track">
            <span>Two operator-side exits</span>
            <span>£18M+ revenue influenced</span>
            <span>£6M+ paid acquisition spend</span>
            <span>Cambridge Judge · Imperial · Techstars</span>
          </div>
          <a class="v9-text-link" href="/about/daniel">More about Daniel →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="v9-scorecard" aria-labelledby="v9-scorecard-title">
    <div class="v9-shell">
      <div class="v9-scorecard-card">
        <div class="v9-scorecard-copy">
          <span class="v9-section-number">Free diagnostic · 5 minutes</span>
          <h2 id="v9-scorecard-title">Find the constraint costing this quarter's pipeline.</h2>
          <p>Ten questions across positioning, acquisition, conversion, reporting and team ownership. Built from 479+ founder sessions.</p>
          <div class="v9-scorecard-actions">
            <a class="v9-button v9-button-primary" href={siteConfig.scorecardUrl}>Take the scorecard <span aria-hidden="true">↗</span></a>
            <a class="v9-text-link v9-text-link-light" href={siteConfig.bookingUrl}>Or book the 20-minute call →</a>
          </div>
        </div>
        <div class="v9-scorecard-visual" aria-hidden="true">
          <div class="v9-scorecard-ring">
            <span>Growth</span>
            <strong>Bottleneck</strong>
            <small>Scorecard</small>
          </div>
          <div class="v9-scorecard-label v9-scorecard-label-one">Positioning</div>
          <div class="v9-scorecard-label v9-scorecard-label-two">Acquisition</div>
          <div class="v9-scorecard-label v9-scorecard-label-three">Ownership</div>
        </div>
      </div>
    </div>
  </section>

  <section class="v9-faq" aria-labelledby="v9-faq-title">
    <div class="v9-shell v9-faq-grid">
      <div class="v9-faq-intro">
        <span class="v9-section-number">08 / Before you book</span>
        <h2 id="v9-faq-title">Questions founders ask before the first call.</h2>
        <p>Short answers for teams deciding whether they need more execution, sharper diagnosis or senior growth ownership.</p>
        <a class="v9-text-link" href="/contact">Ask a different question →</a>
      </div>
      <div class="v9-faq-list">
        {buyerFaqs.map((faq, index) => (
          <details class="v9-faq-item" open={index === 0}>
            <summary><span>0{index + 1}</span><strong>{faq.question}</strong><i aria-hidden="true"></i></summary>
            <div><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-other" aria-label="Other ways to work with We Scale Startups">
    <div class="v9-shell">
      <span class="v9-section-number">Not a founder?</span>
      <div class="v9-other-grid">
        {subAudiences.map((audience) => (
          <article>
            <h2>{audience.title}</h2>
            <p>{audience.body}</p>
            <a href={audience.href}>{audience.label} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v9-final" aria-labelledby="v9-final-title">
    <div class="v9-shell">
      <span class="v9-final-orbit" aria-hidden="true"></span>
      <p>One honest conversation. One constraint named.</p>
      <h2 id="v9-final-title">The next step is a <em>20-minute call.</em></h2>
      <p>Bring your current growth picture. Leave with your bottleneck named in plain English and an honest read on whether we are the right call.</p>
      <a class="v9-button v9-button-primary" href={siteConfig.bookingUrl}>{siteConfig.bookingLabel} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var progress = document.querySelector(".v9-scroll-progress");
      var frame = 0;

      function updateProgress() {
        frame = 0;
        if (!progress) return;
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var value = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        progress.style.transform = "scaleX(" + value + ")";
      }

      window.addEventListener("scroll", function () {
        if (!frame) frame = requestAnimationFrame(updateProgress);
      }, { passive: true });
      window.addEventListener("resize", updateProgress, { passive: true });
      updateProgress();

      var tabs = Array.from(document.querySelectorAll(".v9-constraint-tab"));
      var outputMeta = document.getElementById("v9-output-meta");
      var outputTitle = document.getElementById("v9-output-title");
      var outputDescription = document.getElementById("v9-output-description");
      var outputService = document.getElementById("v9-output-service");
      var outputPrice = document.getElementById("v9-output-price");
      var outputLink = document.getElementById("v9-output-link");

      function selectConstraint(tab, track) {
        tabs.forEach(function (item) {
          var active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", active ? "true" : "false");
          item.tabIndex = active ? 0 : -1;
        });

        if (outputMeta) outputMeta.textContent = tab.dataset.number + " / " + tab.dataset.label;
        if (outputTitle) outputTitle.textContent = tab.dataset.title || "";
        if (outputDescription) outputDescription.textContent = tab.dataset.description || "";
        if (outputService) outputService.textContent = tab.dataset.service || "";
        if (outputPrice) outputPrice.textContent = tab.dataset.meta || "";
        if (outputLink) outputLink.href = tab.dataset.href || "/services";

        if (track) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "home_system_constraint_select",
            constraint: tab.dataset.constraint || "unknown"
          });
        }
      }

      tabs.forEach(function (tab, index) {
        tab.addEventListener("click", function () { selectConstraint(tab, true); });
        tab.addEventListener("keydown", function (event) {
          if (event.key !== "ArrowDown" && event.key !== "ArrowUp" && event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
          event.preventDefault();
          var direction = event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : -1;
          var next = tabs[(index + direction + tabs.length) % tabs.length];
          next.focus();
          selectConstraint(next, true);
        });
      });

      document.querySelectorAll(".v9-hover-glow").forEach(function (card) {
        card.addEventListener("pointermove", function (event) {
          var rect = card.getBoundingClientRect();
          card.style.setProperty("--pointer-x", ((event.clientX - rect.left) / rect.width * 100) + "%");
          card.style.setProperty("--pointer-y", ((event.clientY - rect.top) / rect.height * 100) + "%");
        });
      });
    })();
  </script>
</BaseLayout>
