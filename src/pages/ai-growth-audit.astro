---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../lib/schema";
import { canonicalProofMetrics, siteConfig, testimonials } from "../site";

const path = "/ai-growth-audit";
const bookHref = "#book-calendly";
const calUrl = `${siteConfig.calLink}?utm_source=outbound&utm_medium=email&utm_campaign=ai-growth-audit`;

const proofMetrics = canonicalProofMetrics.slice(0, 4);

const outcomes = [
  {
    title: "Your named bottleneck",
    body: "The one constraint holding pipeline back, in plain English. Not a laundry list."
  },
  {
    title: "The likely cause",
    body: "Positioning, acquisition, conversion, reporting, or ownership. One primary call."
  },
  {
    title: "What not to spend on yet",
    body: "Where campaign volume, tool sprawl, or a CMO hire would amplify the wrong thing."
  },
  {
    title: "An honest fit call",
    body: "Whether We Scale Startups is the right help now, or a clear no with a better next step."
  }
];

const builtFor = [
  "Post-PMF AI / B2B SaaS with real customers, not a pitch deck",
  "You still own the weekly growth decisions (no CMO or VP Marketing yet)",
  "Seed–Series A capital in, or board pressure for a cleaner pipeline story",
  "Willing to bring numbers: funnel, channels, what’s working and what’s noise"
];

const notFor = [
  "Pre-PMF or still hunting for fit",
  "You already have a senior marketing owner in seat",
  "You want a campaign sprint with no diagnosis",
  "You want junior execution, not a named constraint"
];

const featuredTestimonial = testimonials.find((t) => t.category === "paid-client")!;

const faqs = [
  {
    question: "What should I bring?",
    answer:
      "No deck. Bring the current picture: stage, traction, main channels, and what you think is blocking pipeline. Rough numbers beat a polished story."
  },
  {
    question: "Is there a pitch at the end?",
    answer:
      "Only if there is a genuine fit. The default outcome is a named bottleneck and a clear next step, including telling you not to hire us yet when that is the honest answer."
  },
  {
    question: "We just raised. Should we hire a CMO instead?",
    answer:
      "Often not yet. A senior hire before the constraint is named is expensive to reverse. The audit tells you whether the bottleneck is strategy, channel, conversion, reporting, or ownership, then whether fractional help or a hire is the right next move."
  },
  {
    question: "How is this different from an agency call?",
    answer:
      "Agencies produce once the channel plan is clear. This call works one level up: name the bottleneck first, then decide what to build, buy, or hire."
  }
];

const schema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "AI SaaS Growth Audit", path }
  ]),
  buildFaqSchema(faqs)
];
---

<BaseLayout
  path={path}
  title="AI SaaS Growth Audit | We Scale Startups"
  description="20-minute Growth Audit for Post-PMF AI SaaS founders who still own growth. Leave with the pipeline constraint named before you hire more marketing capacity."
  keywords="AI SaaS growth audit, post-PMF AI startup marketing, founder-led growth, fractional CMO AI startup"
  schema={schema}
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "AI SaaS Growth Audit", path }
  ]}
  stickyBookCta={false}
  showAnnouncement={false}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">We Scale Startups</p>
      <h1>
        Your product is ahead of your growth system.<br />
        <em>Let’s name the constraint in 20 minutes.</em>
      </h1>
      <p class="lede">
        For Post-PMF AI SaaS founders who still own growth. Free Growth Audit with We Scale Startups. You leave
        with the bottleneck named in plain English, before you hire marketers or an agency around a guess.
      </p>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={bookHref}
          data-cta="ai-audit-hero-pick-time"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">Pick a time</span>
          <span class="button-subcopy">Inline calendar below · {siteConfig.bookingCallDurationPhrase}</span>
        </a>
        <a class="button button-light" href={siteConfig.calUrl} data-cta="ai-audit-hero-calendly-tab" rel="noreferrer" target="_blank">
          Open calendar in a new tab →
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="hero-proof" style="grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: none; padding-top: 0; margin-top: 0;">
        {proofMetrics.map((metric) => (
          <div>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <p class="eyebrow">What you leave with</p>
      <h2>Four things by the end of the call.</h2>
      <div class="grid-2" style="margin-top: 1.75rem;">
        {outcomes.map((item) => (
          <article class="feature-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">How the {siteConfig.bookingCallDurationPhrase} run</p>
      <h2>No deck. Direct diagnosis.</h2>
      <ol class="call-phase-list" style="margin-top: 1.5rem;">
        {siteConfig.bookingCallPhases.map((step) => (
          <li>
            <strong>{step.phase}</strong>
            <span>{step.detail}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <p class="eyebrow">Self-qualify</p>
      <h2>Built for this stage. Not for every founder.</h2>
      <p class="lede" style="max-width: 52ch; margin-top: 0.5rem;">
        Better you know in 30 seconds than 15 minutes into a call.
      </p>
      <div class="fit-grid">
        <div class="fit-card for">
          <span class="fit-label yes">Built for</span>
          <ul>
            {builtFor.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="fit-card against">
          <span class="fit-label no">Not for</span>
          <ul>
            {notFor.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="book-calendly" aria-labelledby="book-calendly-heading">
    <div class="shell">
      <p class="eyebrow">Next step</p>
      <h2 id="book-calendly-heading">Pick a time. That’s it.</h2>
      <p class="lede" style="max-width: 52ch; margin-top: 0.5rem;">
        Free · {siteConfig.bookingCallDurationPhrase}. Bring where pipeline is stuck. You’ll leave with the
        constraint named.
      </p>
      <div
        id="book-cal-inline"
        class="calendly-inline-widget"
        data-url={calUrl}
        style="min-width: 320px; height: 700px; overflow: auto; margin-top: 1.5rem;"
      >
      </div>
      <p class="calendly-lede" style="margin-top:1rem;">
        <strong>Calendar not loading?</strong>
        {" "}
        Some privacy blockers stop the embed.
        {" "}
        <a href={siteConfig.calUrl} rel="noreferrer" target="_blank">Open the booking page in a new tab</a>
        , or
        {" "}
        <a href="/contact#growth-enquiry">send context via the enquiry form</a>.
      </p>
    </div>
  </section>

  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  <script is:inline>
    (function () {
      function isCalendlyEvent(e) {
        return (
          e.origin === "https://calendly.com" &&
          e.data &&
          typeof e.data.event === "string" &&
          e.data.event.indexOf("calendly.") === 0
        );
      }
      window.addEventListener("message", function (e) {
        if (!isCalendlyEvent(e)) return;
        window.dataLayer = window.dataLayer || [];
        if (e.data.event === "calendly.event_scheduled") {
          window.dataLayer.push({
            event: "booking_completed",
            booking_source: "calendly_inline",
            page_path: window.location.pathname
          });
        } else if (e.data.event === "calendly.date_and_time_selected") {
          window.dataLayer.push({
            event: "booking_time_selected",
            booking_source: "calendly_inline",
            page_path: window.location.pathname
          });
        }
      });
    })();
  </script>

  <section class="section section-alt">
    <div class="shell">
      <p class="eyebrow">Founder voice</p>
      <figure class="quote-card">
        <blockquote>
          <p>“{featuredTestimonial.quote}”</p>
        </blockquote>
        <figcaption>
          <strong>{featuredTestimonial.name}</strong>
          <span>
            {featuredTestimonial.role} · {featuredTestimonial.company}
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Before you book</p>
      <h2>Usual questions.</h2>
      <div class="grid-2" style="margin-top: 1.75rem;">
        {faqs.map((faq) => (
          <article class="feature-card">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .call-phase-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .call-phase-list li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .call-phase-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .call-phase-list strong {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violet);
  }

  .call-phase-list span {
    color: var(--ink-2);
    line-height: 1.55;
  }

  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 760px) {
    .fit-grid {
      grid-template-columns: 1fr;
    }
  }

  .fit-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.5rem 1.4rem;
  }

  .fit-label {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    display: inline-block;
    border-radius: 100px;
    padding: 0.3rem 0.75rem;
    margin-bottom: 1rem;
  }

  .fit-label.yes {
    color: #0e9f6e;
    background: rgba(14, 159, 110, 0.09);
  }

  .fit-label.no {
    color: #e05d38;
    background: rgba(224, 93, 56, 0.09);
  }

  .fit-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fit-card li {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.5;
    padding: 0.65rem 0 0.65rem 1.6rem;
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .fit-card li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .fit-card li::before {
    position: absolute;
    left: 0.1rem;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.75rem;
  }

  .fit-card.for li::before {
    content: "✓";
    color: #0e9f6e;
  }

  .fit-card.against li::before {
    content: "✕";
    color: #e05d38;
  }

  .quote-card {
    margin: 1.5rem 0 0;
    padding: 1.75rem 1.75rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    border-left: 3px solid var(--violet);
  }

  .quote-card blockquote {
    margin: 0;
  }

  .quote-card blockquote p {
    margin: 0;
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink);
  }

  .quote-card figcaption {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .quote-card figcaption strong {
    font-size: 0.92rem;
    color: var(--ink);
  }

  .quote-card figcaption span {
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
