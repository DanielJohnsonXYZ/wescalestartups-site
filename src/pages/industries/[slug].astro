---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../../lib/schema";
import { indexableIndustrySlugs, industryDetailRelatedReading, siteConfig } from "../../site";

export async function getStaticPaths() {
  const industries = await getCollection("industries");
  return industries.map((industry) => ({
    params: { slug: industry.id },
    props: { industry }
  }));
}

const { industry } = Astro.props;
const path = `/industries/${industry.id}`;
// Titles that already end in "Growth" (e.g. "SaaS Growth") would otherwise
// render as "SaaS Growth Growth Systems". Append only the missing words.
const industrySystemsLabel = /\bGrowth$/.test(industry.data.title)
  ? `${industry.data.title} Systems`
  : `${industry.data.title} Growth Systems`;
const industryMetaTitle =
  industry.id === "vc-support"
    ? "VC Portfolio Growth Systems | We Scale Startups"
    : `${industrySystemsLabel} | We Scale Startups`;

const industryFaqs = [
  {
    question: `What usually breaks for ${industry.data.title} teams post-PMF?`,
    answer: industry.data.buyerProblem
  },
  {
    question: "What is the first step if we might be a fit?",
    answer: `Run the scorecard or ${siteConfig.bookingLabel.replace(/^Book /, "book ")} with your current funnel and proof context. The goal is to name the bottleneck before adding more channel activity.`
  },
  {
    question: "Do you only work with companies in this sector?",
    answer:
      "No. This page translates common buyer, proof, and channel economics patterns for the sector. If your motion is similar, trust-heavy, committee buying, proof bar, the diagnostic still applies."
  }
];

// Thin-content guard: only industry pages backed by a named case study stay indexable.
// The rest remain useful for navigation but are noindexed until they carry unique proof
// (a real case study + sector-specific insight), to avoid doorway-page classification.
const indexableIndustries = new Set<string>(indexableIndustrySlugs);
const industryRobots = indexableIndustries.has(industry.id)
  ? undefined
  : "noindex,follow";

const industrySchema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Industries", path: "/industries" },
    { name: industry.data.title, path }
  ]),
  buildFaqSchema(industryFaqs)
];
---

<BaseLayout
  title={industryMetaTitle}
  description={industry.data.description}
  path={path}
  schema={industrySchema}
  metaRobots={industryRobots}
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "Industries", path: "/industries" },
    { name: industry.data.title, path }
  ]}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Industry</p>
      <h1>{industry.data.title}</h1>
      <div class="hero-support">
        <p>{industry.data.description}</p>
        <div class="hero-actions">
          <a
            class="button button-dark button-with-subcopy"
            href={siteConfig.bookingUrl}
            data-cta="industry-book"
            title={siteConfig.bookingCallReassurance}
          >
            <span class="button-label">{siteConfig.bookingLabel}</span>
            <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
          </a>
          <a class="link-arrow" href={siteConfig.scorecardUrl} data-cta="industry-hero-scorecard">
            Or, {siteConfig.scorecardLabel} →
          </a>
          <a class="button button-light" href="/industries">All industries</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro band. The buyer problem is the page's thesis, so it takes the
       homepage's device: a mono label over a display-scale statement on the
       night surface. Copy is the `buyerProblem` string verbatim. -->
  <section class="section industry-problem" aria-labelledby={`industry-problem-${industry.id}`}>
    <div class="shell industry-problem-grid">
      <p class="eyebrow">Buyer problem</p>
      <div>
        <h2 id={`industry-problem-${industry.id}`}>{industry.data.buyerProblem}</h2>
        <p class="industry-problem-meta">{industry.data.title}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="01" title="Useful when" />
      <div class="wss-ledger">
        {industry.data.usefulWhen.map((item, index) => (
          <article>
            <span class="wss-ledger-index">{String(index + 1).padStart(2, "0")}</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="02" title="Growth system" />
      <div class="wss-ledger">
        {industry.data.growthSystem.map((item, index) => (
          <article>
            <span class="wss-ledger-index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof band. Every industry record carries exactly two proof strings
       today, but the rail is a flow row so it reads correctly at one or five. -->
  <section class="section industry-proof">
    <div class="shell">
      <SectionIntro eyebrow="03" title="Market-specific proof" />
      <div class="industry-proof-rail">
        {industry.data.proof.map((item, index) => (
          <article class="feature-card">
            <span class="card-kicker">{String(index + 1).padStart(2, "0")}</span>
            <p>{item}</p>
          </article>
        ))}
        <article class="feature-card industry-magnet">
          <span class="card-kicker">Lead magnet</span>
          <p>
            {siteConfig.scorecardLabelLong} and use it to decide whether the issue is positioning, acquisition, conversion,
            reporting, or leadership capacity in this market.
          </p>
          <a class="card-link" href={siteConfig.scorecardUrl} data-cta="industry-scorecard">
            {siteConfig.scorecardLabel} →
          </a>
        </article>
      </div>
    </div>
  </section>

  {industry.data.readingBlocks && industry.data.readingBlocks.length > 0 && (
    <section class="section section-alt">
      <div class="shell">
        <div class="industry-reading">
          {industry.data.readingBlocks.map((block) => (
            <article class="content-block">
              <h2>{block.heading}</h2>
              {block.paragraphs?.map((p) => (
                <p>{p}</p>
              ))}
              {block.bullets && block.bullets.length > 0 ? (
                <ul>
                  {block.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              ) : null}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="Related reading" title="Hubs that pair with this market." />
      <ul class="related-insights-list">
        {industryDetailRelatedReading.map((item) => (
          <li>
            <a class="card-link" href={item.href}>
              {item.label} →
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="FAQ" title="Questions founders ask on industry fit." />
      <div class="grid-3">
        {industryFaqs.map((item) => (
          <article class="feature-card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Market-specific diagnosis</p>
        <h2>Want a clearer growth path for {industry.data.title.toLowerCase()}?</h2>
        <p>We will connect the buyer problem, proof requirement, channel economics, and team capacity into a practical next step.</p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="industry-final-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="link-arrow" href={siteConfig.scorecardUrl} data-cta="industry-final-scorecard">
          Or, {siteConfig.scorecardLabel} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Only the rules that have no competing shared selector live here. The
     dark intro band is in site-v9.css instead: `.section` is set to the paper
     background at 0-3-0 by the shared layer, which outranks anything an Astro
     scoped style can reach (0-2-0), so a page-local `background` was silently
     dropped and the band rendered white text on white. */
  .industry-proof-rail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1rem;
  }
  .industry-proof-rail .feature-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.5rem 1.4rem;
  }
  .industry-magnet {
    background: linear-gradient(150deg, rgba(128, 108, 255, 0.08), var(--v9-white) 62%);
    border-color: rgba(128, 108, 255, 0.3);
  }
  .industry-reading {
    display: grid;
    gap: 1rem;
  }
  .industry-reading .content-block {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
</style>
