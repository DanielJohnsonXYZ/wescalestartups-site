---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../lib/schema";
import { proofClients, proofEcosystemLogos, siteConfig, testimonials } from "../site";

const path = "/ai-growth-audit";
const bookHref = "#book-calendly";
const calUrl = `${siteConfig.calLink}?utm_source=outbound&utm_medium=email&utm_campaign=ai-growth-audit`;
const primaryCtaLabel = "Book a free 20-minute Growth Audit";
const primaryCtaSubcopy = `Free · ${siteConfig.bookingCallDurationPhrase} · Leave with your bottleneck named`;
const scorecardSoftLink = "Not ready to talk? Take the 5-minute scorecard.";

const proofMetrics = [
  {
    value: "£18M+",
    label: "in client revenue influenced",
    detail: "Across client and operator-side engagements"
  },
  {
    value: "£6M+",
    label: "in paid media managed",
    detail: "Acquisition spend directed and reviewed"
  },
  {
    value: "479+",
    label: "founders and teams advised",
    detail: "Founder sessions across programmes and clients"
  },
  {
    value: "4.93/5",
    label: "on GrowthMentor",
    detail: "Average mentor rating across 479+ sessions",
    href: siteConfig.growthMentorReviews
  }
];

const logoStrip = [
  ...proofClients
    .filter((c) => c.logoSrc && c.label !== "Healthtech (anonymous)")
    .slice(0, 4)
    .map((c) => ({
      src: c.logoSrc!,
      alt: c.label,
      name: c.label
    })),
  ...proofEcosystemLogos
    .filter((l) => ["Google for Startups", "Techstars", "GrowthMentor"].includes(l.name))
    .map((l) => ({ src: l.src, alt: l.alt, name: l.name }))
];

const outcomes = [
  {
    title: "Your named bottleneck",
    body: "The one constraint holding pipeline back, in plain English."
  },
  {
    title: "The likely cause",
    body: "Positioning, acquisition, conversion, retention, or operating rhythm."
  },
  {
    title: "The clearest next move",
    body: "What to do this week, including what not to spend on yet."
  },
  {
    title: "An honest fit call",
    body: "Whether WSS is the right help now, or a clear no."
  }
];

const afterAudit = [
  {
    title: "Do nothing yet",
    body: "If the constraint isn’t urgent, you leave with clarity and wait."
  },
  {
    title: "Fix it internally",
    body: "A named bottleneck your team can act on without hiring WSS."
  },
  {
    title: "Short Growth Diagnosis",
    body: "Evidence review and a 90-day plan when you need more depth (£2k–£4k)."
  },
  {
    title: "Work with WSS",
    body: "Only if there’s a genuine fit for sprint, system build, or fractional leadership."
  }
];

const fitRows = [
  { yes: "Post-PMF AI / B2B SaaS with real customers", no: "Pre-PMF or still hunting for fit" },
  { yes: "You still own weekly growth decisions", no: "You already have a CMO / VP Marketing" },
  { yes: "Willing to bring rough funnel numbers", no: "You want a campaign sprint with no diagnosis" }
];

const featuredTestimonial =
  testimonials.find((t) => t.name === "Greg Weinstein") ??
  testimonials.find((t) => t.category === "paid-advisory")!;

const faqs = [
  {
    question: "What should I bring?",
    answer:
      "No deck. Stage, traction, main channels, and what you think is blocking pipeline. Rough numbers beat a polished story."
  },
  {
    question: "Is there a pitch at the end?",
    answer:
      "Only if there’s a genuine fit. Default outcome: named bottleneck, next move, and an honest yes/no on working together."
  },
  {
    question: "We just raised. Should we hire a CMO instead?",
    answer:
      "Often not yet. A senior hire before the constraint is named is expensive to reverse. The audit tells you whether the bottleneck is strategy, channel, conversion, retention, or ownership."
  }
];

const schema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "AI SaaS Growth Audit", path }
  ]),
  buildFaqSchema(faqs)
];
---

<BaseLayout
  path={path}
  title="AI SaaS Growth Audit | We Scale Startups"
  description="A 20-minute Growth Audit for post-PMF AI SaaS founders. Name the pipeline constraint before you hire, increase spend, or add another agency."
  keywords="AI SaaS growth audit, post-PMF AI startup marketing, founder-led growth, fractional CMO AI startup"
  schema={schema}
  stickyBookCta={true}
  stickyBookHref={bookHref}
  stickyBookCtaLabel="Book a Growth Audit →"
  headerCtaLabel="Book a Growth Audit"
  headerCtaHref={bookHref}
  showFooterScorecard={false}
  showFooterNewsletter={false}
  showAnnouncement={false}
>
  <section class="page-hero audit-hero">
    <div class="shell audit-hero-grid">
      <div class="audit-hero-copy">
        <p class="eyebrow">We Scale Startups · Growth Audit</p>
        <h1>
          Post-PMF AI SaaS, but growth still runs through the founder?<br />
          <em>Find the bottleneck before you hire, increase spend, or add another agency.</em>
        </h1>
        <p class="lede">
          In a free 20-minute Growth Audit, we identify whether the constraint is positioning, acquisition,
          conversion, retention, or operating rhythm, then give you the clearest next move.
        </p>
        <div class="hero-actions audit-hero-actions">
          <a
            class="button button-brand button-with-subcopy"
            href={bookHref}
            data-cta="ai-audit-hero-book"
            title={siteConfig.bookingCallReassurance}
          >
            <span class="button-label">{primaryCtaLabel}</span>
            <span class="button-subcopy">{primaryCtaSubcopy}</span>
          </a>
        </div>
        <p class="soft-secondary">
          <a href={siteConfig.scorecardUrl} data-cta="ai-audit-hero-scorecard">{scorecardSoftLink}</a>
        </p>
      </div>

      <aside class="daniel-card" aria-label="Delivered by Daniel Johnson">
        <img
          src="/images/daniel-headshot-640.webp"
          alt="Daniel Johnson, Founding Partner at We Scale Startups"
          width="640"
          height="640"
          loading="eager"
          decoding="async"
        />
        <div class="daniel-card-body">
          <p class="daniel-card-kicker">Your audit is with</p>
          <p class="daniel-card-name">Daniel Johnson</p>
          <p class="daniel-card-role">Founding Partner, We Scale Startups</p>
          <p class="daniel-card-proof">
            £18M+ revenue influenced · £6M+ media managed · advisor to post-PMF SaaS teams
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section audit-tight">
    <div class="shell">
      <div class="hero-proof audit-proof">
        {proofMetrics.map((metric) => (
          <div>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
            {metric.href ? (
              <a class="proof-source" href={metric.href} rel="noreferrer" target="_blank">
                {metric.detail} →
              </a>
            ) : (
              <small>{metric.detail}</small>
            )}
          </div>
        ))}
      </div>

      <div class="logo-strip" aria-label="Clients and programmes">
        {logoStrip.map((logo) => (
          <img src={logo.src} alt={logo.alt} title={logo.name} width="120" height="40" loading="lazy" decoding="async" />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt audit-tight">
    <div class="shell">
      <p class="eyebrow">What you leave with</p>
      <h2>Four things by the end of the call.</h2>
      <div class="grid-2 audit-outcomes">
        {outcomes.map((item) => (
          <article class="feature-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section audit-tight">
    <div class="shell">
      <p class="eyebrow">Fit check</p>
      <h2>Built for this stage. Clear on who it is not for.</h2>
      <div class="fit-table">
        <div class="fit-table-head">
          <span>Good fit</span>
          <span>Not a fit</span>
        </div>
        {fitRows.map((row) => (
          <div class="fit-table-row">
            <p><span class="fit-mark yes">✓</span>{row.yes}</p>
            <p><span class="fit-mark no">✕</span>{row.no}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt audit-tight">
    <div class="shell">
      <p class="eyebrow">After the audit</p>
      <h2>What happens after the audit.</h2>
      <p class="lede audit-lede">
        The answer may be to do nothing, fix it internally, complete a short diagnosis, or work with WSS. The call
        decides that. It does not assume a retainer.
      </p>
      <div class="grid-2 audit-outcomes">
        {afterAudit.map((item) => (
          <article class="feature-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section audit-tight">
    <div class="shell">
      <p class="eyebrow">Founder voice</p>
      <figure class="quote-card">
        <blockquote>
          <p>“{featuredTestimonial.quote}”</p>
        </blockquote>
        <figcaption>
          <strong>{featuredTestimonial.name}</strong>
          <span>
            {featuredTestimonial.role} · {featuredTestimonial.company} · {featuredTestimonial.result}
          </span>
          <a href={siteConfig.growthMentorReviews} rel="noreferrer" target="_blank">
            Read GrowthMentor reviews →
          </a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-alt audit-tight" id="book-calendly" aria-labelledby="book-calendly-heading">
    <div class="shell">
      <p class="eyebrow">Book now</p>
      <h2 id="book-calendly-heading">Book a free 20-minute Growth Audit.</h2>
      <p class="lede audit-lede">
        Choose a slot below. Bring where pipeline is stuck. You’ll leave with the constraint named in plain
        English.
      </p>
      <div class="book-primary-cta">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.calUrl}
          data-cta="ai-audit-book-section"
          rel="noreferrer"
          target="_blank"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{primaryCtaLabel}</span>
          <span class="button-subcopy">{primaryCtaSubcopy}</span>
        </a>
        <p class="soft-secondary">
          <a href={siteConfig.scorecardUrl} data-cta="ai-audit-book-scorecard">{scorecardSoftLink}</a>
        </p>
      </div>
      <div
        id="book-cal-inline"
        class="calendly-inline-widget"
        data-url={calUrl}
        style="min-width: 320px; height: 700px; overflow: auto; margin-top: 1.25rem;"
      >
      </div>
      <p class="calendly-lede">
        <strong>Calendar not loading?</strong>
        {" "}
        <a href={siteConfig.calUrl} rel="noreferrer" target="_blank" data-cta="ai-audit-calendly-fallback">
          Open the booking page in a new tab
        </a>
        .
      </p>
    </div>
  </section>

  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  <script is:inline>
    (function () {
      function isCalendlyEvent(e) {
        return (
          e.origin === "https://calendly.com" &&
          e.data &&
          typeof e.data.event === "string" &&
          e.data.event.indexOf("calendly.") === 0
        );
      }
      window.addEventListener("message", function (e) {
        if (!isCalendlyEvent(e)) return;
        window.dataLayer = window.dataLayer || [];
        if (e.data.event === "calendly.event_scheduled") {
          window.dataLayer.push({
            event: "booking_completed",
            booking_source: "calendly_inline",
            page_path: window.location.pathname
          });
        } else if (e.data.event === "calendly.date_and_time_selected") {
          window.dataLayer.push({
            event: "booking_time_selected",
            booking_source: "calendly_inline",
            page_path: window.location.pathname
          });
        }
      });
    })();
  </script>

  <section class="section audit-tight">
    <div class="shell">
      <p class="eyebrow">FAQ</p>
      <h2>Usual questions.</h2>
      <div class="grid-2 audit-outcomes">
        {faqs.map((faq) => (
          <article class="feature-card">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
      <div class="book-primary-cta final-cta">
        <a
          class="button button-brand button-with-subcopy"
          href={bookHref}
          data-cta="ai-audit-faq-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{primaryCtaLabel}</span>
          <span class="button-subcopy">{primaryCtaSubcopy}</span>
        </a>
        <p class="soft-secondary">
          <a href={siteConfig.scorecardUrl} data-cta="ai-audit-faq-scorecard">{scorecardSoftLink}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .audit-tight {
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
  }

  .audit-hero {
    padding-bottom: 1.5rem;
  }

  .audit-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
    gap: 2rem;
    align-items: start;
  }

  .audit-hero-copy h1 {
    max-width: 18ch;
  }

  .audit-hero-copy .lede {
    max-width: 54ch;
    font-size: 1.08rem;
    color: var(--ink-2);
  }

  .audit-hero-actions {
    margin-top: 1.25rem;
  }

  .soft-secondary {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
  }

  .soft-secondary a {
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .soft-secondary a:hover {
    color: var(--violet);
  }

  .daniel-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(16, 17, 20, 0.06);
  }

  .daniel-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .daniel-card-body {
    padding: 1.15rem 1.2rem 1.35rem;
  }

  .daniel-card-kicker {
    margin: 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--violet);
  }

  .daniel-card-name {
    margin: 0.35rem 0 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
  }

  .daniel-card-role {
    margin: 0.15rem 0 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .daniel-card-proof {
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .audit-proof {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: none;
    padding-top: 0;
    margin-top: 0;
    gap: 1rem;
  }

  .audit-proof small,
  .audit-proof .proof-source {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .audit-proof .proof-source:hover {
    color: var(--violet);
  }

  .logo-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .logo-strip img {
    height: 28px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
  }

  .audit-outcomes {
    margin-top: 1.25rem;
  }

  .audit-lede {
    max-width: 54ch;
    margin-top: 0.5rem;
    color: var(--ink-2);
  }

  .fit-table {
    margin-top: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--surface);
  }

  .fit-table-head,
  .fit-table-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .fit-table-head {
    background: color-mix(in srgb, var(--violet) 8%, white);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--violet);
  }

  .fit-table-head span,
  .fit-table-row p {
    padding: 0.9rem 1.1rem;
    margin: 0;
    border-right: 1px solid var(--line);
  }

  .fit-table-head span:last-child,
  .fit-table-row p:last-child {
    border-right: none;
  }

  .fit-table-row + .fit-table-row {
    border-top: 1px solid var(--line);
  }

  .fit-table-row p {
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.45;
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .fit-mark {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .fit-mark.yes {
    color: #22c55e;
  }

  .fit-mark.no {
    color: #f97316;
  }

  .quote-card {
    margin: 1.25rem 0 0;
    padding: 1.5rem 1.5rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    border-left: 3px solid var(--violet);
  }

  .quote-card blockquote {
    margin: 0;
  }

  .quote-card blockquote p {
    margin: 0;
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: clamp(1.12rem, 2vw, 1.3rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink);
  }

  .quote-card figcaption {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .quote-card figcaption strong {
    font-size: 0.95rem;
    color: var(--ink);
  }

  .quote-card figcaption span,
  .quote-card figcaption a {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .quote-card figcaption a:hover {
    color: var(--violet);
  }

  .book-primary-cta {
    margin-top: 1.25rem;
  }

  .final-cta {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .calendly-lede {
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  :global(.page-hero.audit-hero .eyebrow),
  .eyebrow {
    margin-bottom: 0.65rem;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 1;
    color: var(--violet);
  }

  :global(.audit-tight p),
  :global(.audit-tight .feature-card p) {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  :global(.audit-tight h2) {
    margin-top: 0.15rem;
    max-width: 22ch;
  }

  @media (max-width: 900px) {
    .audit-hero-grid {
      grid-template-columns: 1fr;
    }

    .daniel-card {
      max-width: 360px;
    }

    .audit-proof {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .fit-table-head,
    .fit-table-row {
      grid-template-columns: 1fr;
    }

    .fit-table-head span,
    .fit-table-row p {
      border-right: none;
    }

    .fit-table-head span + span,
    .fit-table-row p + p {
      border-top: 1px solid var(--line);
    }

    .audit-proof {
      grid-template-columns: 1fr;
    }
  }
</style>
