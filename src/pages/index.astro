  <script is:inline>
    (function () {
      var progress = document.querySelector(".v9-scroll-progress");
      var frame = 0;

      function updateProgress() {
        frame = 0;
        if (!progress) return;
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var value = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        progress.style.transform = "scaleX(" + value + ")";
      }

      window.addEventListener("scroll", function () {
        if (!frame) frame = requestAnimationFrame(updateProgress);
      }, { passive: true });
      window.addEventListener("resize", updateProgress, { passive: true });
      updateProgress();

      var tabs = Array.from(document.querySelectorAll(".v9-constraint-tab"));
      var outputMeta = document.getElementById("v9-output-meta");
      var outputTitle = document.getElementById("v9-output-title");
      var outputDescription = document.getElementById("v9-output-description");
      var outputService = document.getElementById("v9-output-service");
      var outputPrice = document.getElementById("v9-output-price");
      var outputLink = document.getElementById("v9-output-link");

      function selectConstraint(tab, track) {
        tabs.forEach(function (item) {
          var active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", active ? "true" : "false");
          item.tabIndex = active ? 0 : -1;
        });

        if (outputMeta) outputMeta.textContent = tab.dataset.number + " / " + tab.dataset.label;
        if (outputTitle) outputTitle.textContent = tab.dataset.title || "";
        if (outputDescription) outputDescription.textContent = tab.dataset.description || "";
        if (outputService) outputService.textContent = tab.dataset.service || "";
        if (outputPrice) outputPrice.textContent = tab.dataset.meta || "";
        if (outputLink) outputLink.href = tab.dataset.href || "/services";

        if (track) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "home_system_constraint_select",
            constraint: tab.dataset.constraint || "unknown"
          });
        }
      }

      tabs.forEach(function (tab, index) {
        tab.addEventListener("click", function () { selectConstraint(tab, true); });
        tab.addEventListener("keydown", function (event) {
          if (event.key !== "ArrowDown" && event.key !== "ArrowUp" && event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
          event.preventDefault();
          var direction = event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : -1;
          var next = tabs[(index + direction + tabs.length) % tabs.length];
          next.focus();
          selectConstraint(next, true);
        });
      });

      var foundItems = Array.from(document.querySelectorAll(".v9-found-item"));
      var foundCount = document.getElementById("v9-found-count");
      var foundVerdict = document.getElementById("v9-found-verdict");
      var foundBars = Array.from(document.querySelectorAll(".v9-found-bar i"));
      var foundVerdicts = [
        "Foundations first. Spending on channels now would leak, start with customer research.",
        "One foundation is not a system yet. Nail the customer picture before scaling spend.",
        "Some signal, plenty of guesswork. A diagnosis would name what to fix first.",
        "Close. One or two missing foundations are capping how fast you can compound.",
        "Nearly there. Tighten the last foundation and growth stops depending on heroics.",
        "Solid foundations. Now it is about compounding, let's talk about scaling."
      ];

      function updateFoundations() {
        var on = foundItems.filter(function (item) { return item.getAttribute("aria-pressed") === "true"; }).length;
        if (foundCount) foundCount.textContent = on + " / " + foundItems.length;
        if (foundVerdict) foundVerdict.textContent = foundVerdicts[on] || foundVerdicts[0];
        foundBars.forEach(function (bar, index) { bar.classList.toggle("is-on", index < on); });
      }

      foundItems.forEach(function (item) {
        item.addEventListener("click", function () {
          item.setAttribute("aria-pressed", item.getAttribute("aria-pressed") === "true" ? "false" : "true");
          updateFoundations();
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: "home_foundations_toggle" });
        });
      });

      var quoteCards = Array.prototype.slice.call(document.querySelectorAll(".v9-quote"));
      var quotesMore = document.getElementById("v9-quotes-more");
      if (quotesMore && quoteCards.length > 6) {
        quoteCards.slice(6).forEach(function (quote) { quote.classList.add("is-collapsed"); });
        quotesMore.addEventListener("click", function () {
          quoteCards.forEach(function (quote) { quote.classList.remove("is-collapsed"); });
          quotesMore.remove();
        });
      } else if (quotesMore) {
        quotesMore.remove();
      }

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        var revealTargets = document.querySelectorAll(
          ".v9-principle, .v9-service-card, .v9-case-card, .v9-quote, .v9-fit-card, .v9-timeline li, .v9-diagnostic-output, .v9-constraint-tabs, .v9-fit-video, .v9-scorecard-card, .v9-other-grid article, .v9-metric"
        );
        var revealObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        revealTargets.forEach(function (el, index) {
          el.classList.add("v9-reveal");
          el.style.transitionDelay = (index % 3) * 70 + "ms";
          revealObserver.observe(el);
        });
      }

      document.querySelectorAll(".v9-hover-glow").forEach(function (card) {
        card.addEventListener("pointermove", function (event) {
          var rect = card.getBoundingClientRect();
          card.style.setProperty("--pointer-x", ((event.clientX - rect.left) / rect.width * 100) + "%");
          card.style.setProperty("--pointer-y", ((event.clientY - rect.top) / rect.height * 100) + "%");
        });
      });
    })();
  </script>

