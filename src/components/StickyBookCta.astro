---
import { siteConfig } from "../site";
import WhatsAppCta from "./WhatsAppCta.astro";

interface Props {
  /** Set false on /book and pages that already end in a full-width booking block. */
  enabled?: boolean;
  /** ScrollY (px) after which the bar appears. */
  revealAfter?: number;
  /** Override destination (e.g. #book-cal on dedicated audit pages). */
  href?: string;
  /** Override sticky button label. */
  ctaLabel?: string;
  /** Override hint under the sticky label. */
  hint?: string;
}

const {
  enabled = true,
  revealAfter = 640,
  href = siteConfig.bookingUrl,
  ctaLabel = `${siteConfig.bookingLabel} →`,
  hint = `Free · ${siteConfig.bookingCallDurationPhrase} · No pitch`
} = Astro.props;
---

{enabled && (
  <div
    class="sticky-book-cta"
    data-reveal-after={revealAfter}
    role="complementary"
    inert
  >
    <div class="sticky-book-cta-inner">
      <div class="sticky-book-cta-copy">
        <span class="sticky-book-cta-label">{siteConfig.bookingLabel}</span>
        <span class="sticky-book-cta-hint">{hint}</span>
      </div>
      <button
        class="sticky-book-cta-dismiss"
        type="button"
        aria-label="Dismiss booking bar"
      >
        ×
      </button>
      <div class="sticky-book-cta-actions">
        <a
          class="button button-brand sticky-book-cta-primary"
          href={href}
          data-cta="sticky-book-cta"
        >
          {ctaLabel}
        </a>
        <a
          class="sticky-book-cta-ghost"
          href="/newsletter"
          data-cta="sticky-newsletter"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          Subscribe to {siteConfig.newsletterName}
        </a>
        <WhatsAppCta
          class="sticky-book-cta-ghost"
          label="Join the WhatsApp group"
          cta="sticky-whatsapp"
        />
      </div>
    </div>
  </div>
)}

<style>
  .sticky-book-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 1rem;
    z-index: 45;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
    opacity: 0;
    transform: translateY(120%);
    transition: opacity 280ms ease, transform 320ms cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .sticky-book-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .sticky-book-cta.is-dismissed {
    display: none;
  }

  /* Two rows: the booking line (with the dismiss control) above a row of
     labelled CTAs, so the newsletter and the WhatsApp group read as real
     offers rather than mystery icons. */
  .sticky-book-cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "copy dismiss"
      "actions actions";
    align-items: center;
    gap: 0.6rem 0.75rem;
    width: min(720px, 100%);
    padding: 0.85rem 0.9rem 0.9rem 1.25rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--ink, #0b0b0c) 96%, transparent);
    color: #fff;
    box-shadow:
      0 18px 42px -12px color-mix(in srgb, var(--ink, #0b0b0c) 65%, transparent),
      0 2px 8px -1px color-mix(in srgb, var(--ink, #0b0b0c) 50%, transparent);
    backdrop-filter: saturate(140%) blur(6px);
  }

  .sticky-book-cta-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .sticky-book-cta-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-book-cta-hint {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, #fff 60%, transparent);
    margin-top: 2px;
  }

  .sticky-book-cta-actions {
    grid-area: actions;
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Secondary CTAs carry their label and icon — outlined rather than solid so
     the booking CTA still leads, but they read as buttons, not decoration.
     The WhatsApp link is rendered by a child component, so its element never
     carries this file's scope attribute: match it through :global too. */
  .sticky-book-cta-primary,
  .sticky-book-cta-ghost,
  .sticky-book-cta-actions :global(.whatsapp-cta) {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.4rem;
    min-width: 0;
    padding-block: 0.5rem;
    padding-inline: 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
  }

  .sticky-book-cta-ghost,
  .sticky-book-cta-actions :global(.whatsapp-cta) {
    border: 1px solid color-mix(in srgb, #fff 32%, transparent);
    background: color-mix(in srgb, #fff 8%, transparent);
    color: #fff;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .sticky-book-cta-ghost:hover,
  .sticky-book-cta-ghost:focus-visible,
  .sticky-book-cta-actions :global(.whatsapp-cta):hover,
  .sticky-book-cta-actions :global(.whatsapp-cta):focus-visible {
    background: color-mix(in srgb, #fff 18%, transparent);
    border-color: color-mix(in srgb, #fff 55%, transparent);
    outline: none;
  }

  .sticky-book-cta-ghost svg {
    flex-shrink: 0;
  }

  .sticky-book-cta-dismiss {
    grid-area: dismiss;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #fff 18%, transparent);
    background: transparent;
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .sticky-book-cta-dismiss:hover,
  .sticky-book-cta-dismiss:focus-visible {
    background: color-mix(in srgb, #fff 14%, transparent);
    outline: none;
  }

  @media (max-width: 640px) {
    /* One CTA per row — full-width targets beat a cramped row, and all three
       stay reachable instead of the secondary links being dropped. */
    .sticky-book-cta-primary,
    .sticky-book-cta-ghost,
    .sticky-book-cta-actions :global(.whatsapp-cta) {
      flex: 1 1 100%;
    }
  }

  @media (max-width: 520px) {
    .sticky-book-cta {
      bottom: 0.75rem;
    }
    .sticky-book-cta-inner {
      padding-left: 1rem;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-book-cta {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.querySelector(".sticky-book-cta");
    if (!bar) return;

    var revealAfter = Number(bar.getAttribute("data-reveal-after") || 640);
    var dismissKey = "wss-sticky-book-cta-dismissed";
    var dismissed = false;
    var overlapSelector = "footer, .site-footer, form, .cta-band, .book-embed, #book-cal-inline, #book-cal, .cal-inline-widget, #calendly-inline-widget, #book-calendly, .calendly-inline-widget";
    var overlapsSensitiveArea = false;
    var shownFired = false;

    try {
      dismissed = sessionStorage.getItem(dismissKey) === "1";
    } catch (err) {
      // sessionStorage may be blocked
    }

    if (dismissed) {
      bar.classList.add("is-dismissed");
      return;
    }

    function update() {
      if (dismissed) return;
      var shouldShow = window.scrollY > revealAfter && !overlapsSensitiveArea;
      bar.classList.toggle("is-visible", shouldShow);
      bar.toggleAttribute("inert", !shouldShow);
      if (shouldShow && !shownFired) {
        shownFired = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "sticky_book_cta_shown",
          page_path: window.location.pathname
        });
      }
    }

    var dismissBtn = bar.querySelector(".sticky-book-cta-dismiss");
    if (dismissBtn) {
      dismissBtn.addEventListener("click", function () {
        dismissed = true;
        bar.classList.remove("is-visible");
        bar.setAttribute("inert", "");
        bar.classList.add("is-dismissed");
        try {
          sessionStorage.setItem(dismissKey, "1");
        } catch (err) {
          // ignore
        }
      });
    }

    if ("IntersectionObserver" in window) {
      var observer = new IntersectionObserver(
        function (entries) {
          overlapsSensitiveArea = entries.some(function (entry) {
            return entry.isIntersecting;
          });
          update();
        },
        {
          rootMargin: "0px 0px -12% 0px",
          threshold: 0.02
        }
      );

      document.querySelectorAll(overlapSelector).forEach(function (el) {
        observer.observe(el);
      });
    }

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    update();
  })();
</script>
