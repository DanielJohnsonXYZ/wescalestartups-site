---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema } from "../lib/schema";

const steps = [
  { title: "Find the problem", detail: "Get specific about who you want to serve, what is frustrating them and how they solve it today. Talk to real people instead of guessing from a prompt.", outcome: "A customer problem worth testing", icon: "◎" },
  { title: "Validate demand", detail: "Find out whether the problem is important enough that people would change their behaviour or pay. Use conversations and tangible evidence, not compliments.", outcome: "Evidence of interest and willingness to pay", icon: "✳" },
  { title: "Build what matters", detail: "Prioritise the smallest changes that make the product more useful to the people most likely to buy. Avoid building features just because AI makes them easy.", outcome: "A sharper offer and product priorities", icon: "▱" },
  { title: "Get customers", detail: "Choose a practical way to reach the right buyers, start useful conversations and make a clear offer. Focus on doing, learning and improving.", outcome: "An acquisition experiment you can actually run", icon: "↗" },
  { title: "Repeat what works", detail: "Work out what caused progress and turn the useful parts into a simple repeatable process. Use AI to save time, not to replace customer understanding.", outcome: "A focused next-step growth plan", icon: "↻" }
];

const faqs = [
  {q:"Is this an AI course?",a:"The focus is finding customers, testing demand and making sales. You may use AI tools during the work, but you will still need to speak to potential buyers."},
  {q:"Who is it for?",a:"Solo founders and small teams using AI to build a product or service. You might be testing an idea, building an MVP or looking for your first customers."},
  {q:"What stage should I be at?",a:"You can apply with an idea, a prototype or a launched product. Tell us where you are stuck so we can see if the cohort is right for you."},
  {q:"How much does it cost and when does it start?",a:"Dates, format and pricing have not been confirmed. We are collecting interest now and will share the details before anyone commits."}
];
---

<BaseLayout
  title="WSS Solo | Built something with AI. Now what?"
  description="WSS Solo helps founders turn AI-built products into paying customers. Join the first-cohort waitlist for updates."
  keywords="WSS Solo, AI startup accelerator, solo founder, first customers, validate demand, AI-built businesses"
  path="/solo"
  schema={buildBreadcrumbSchema([{name:"Home",path:"/"},{name:"WSS Solo",path:"/solo"}])}
  showSiteHeader={false}
  bodyClass="solo-landing-body"
  showAnnouncement={false}
  stickyBookCta={false}
  newsletterPopup={false}
  showFooterNewsletter={false}
  showFooterScorecard={false}
>
  <main class="ws-solo">
    <header class="ws-nav">
      <div class="ws-wrap ws-nav-inner">
        <a href="/" class="ws-brand" aria-label="We Scale Startups home"><strong>WSS</strong><span aria-hidden="true">/</span><span>SOLO</span></a>
        <nav class="ws-nav-links" aria-label="WSS Solo navigation">
          <a href="#challenge">The challenge</a><a href="#how">How it works</a><a href="#fit">Who it's for</a>
          <a href="#waitlist" class="ws-nav-cta">Join the waitlist <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <section class="ws-hero" aria-labelledby="ws-title">
      <div class="ws-hero-planet" aria-hidden="true"></div>
      <div class="ws-wrap ws-hero-grid">
        <div class="ws-hero-copy">
          <p class="ws-eyebrow">THE AI-NATIVE ACCELERATOR FOR SOLO FOUNDERS</p>
          <h1 id="ws-title">You built it.<br />Now <em>make it grow.</em></h1>
          <p class="ws-hero-lead">Hands-on help to build the tools, workflows and growth systems your business actually needs.</p>
          <div class="ws-hero-actions">
            <a class="ws-btn ws-btn-lime" href="#waitlist">Join the waitlist <span aria-hidden="true">↗</span></a>
            <a class="ws-btn ws-btn-outline" href="#how">See how it works <span aria-hidden="true">↗</span></a>
          </div>
          <p class="ws-hero-note">Founding cohort in development <span aria-hidden="true">·</span> No equity <span aria-hidden="true">·</span> No commitment</p>
        </div>
        <div class="ws-visual" role="img" aria-label="An AI-built product connects to the systems that help a business grow">
          <div class="ws-visual-labels"><span>PRODUCT</span><span>CONVERSATIONS</span><span>CUSTOMERS</span></div>
          <svg class="ws-flow-art" viewBox="0 0 720 375" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="wsBeam" x1="0" x2="1"><stop offset="0%" stop-color="#A96AFF"/><stop offset="50%" stop-color="#EAC4FF"/><stop offset="100%" stop-color="#D7FF59"/></linearGradient>
              <linearGradient id="wsCard" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#8151ED" stop-opacity=".92"/><stop offset="100%" stop-color="#211338" stop-opacity=".94"/></linearGradient>
              <linearGradient id="wsLimeCard" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#E8FF85"/><stop offset="100%" stop-color="#83A632"/></linearGradient>
              <radialGradient id="wsHalo"><stop offset="0" stop-color="#9B52FF" stop-opacity=".55"/><stop offset="1" stop-color="#9B52FF" stop-opacity="0"/></radialGradient>
              <filter id="wsGlow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="8" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
              <filter id="wsSoft" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="17"/></filter>
            </defs>
            <ellipse cx="348" cy="226" rx="315" ry="143" fill="url(#wsHalo)"/>
            <g opacity=".34" stroke="#664393" stroke-width="1"><path d="M18 356H707M66 328H658M118 306H614M150 284H582M182 262H551M210 244H523"/><path d="M361 220L10 375M361 220L133 375M361 220L252 375M361 220L470 375M361 220L594 375M361 220L714 375"/></g>
            <g opacity=".65" fill="none" stroke="#CC76FF" stroke-width="1.4"><ellipse cx="365" cy="178" rx="122" ry="122" stroke-dasharray="3 8"/><ellipse cx="365" cy="178" rx="152" ry="91" transform="rotate(-17 365 178)"/></g>
            <g class="ws-beams" fill="none" stroke-linecap="round"><path d="M190 171C262 122 290 126 355 167S485 237 558 173" stroke="#995DFF" stroke-width="22" opacity=".27" filter="url(#wsSoft)"/><path d="M188 171C265 138 286 164 360 168S479 199 555 176" stroke="url(#wsBeam)" stroke-width="5" filter="url(#wsGlow)"/><path d="M196 179C263 231 309 226 359 196S490 136 555 170" stroke="#AA73FF" stroke-width="2.4" opacity=".84"/><path d="M196 160C267 105 298 110 366 146S474 218 555 182" stroke="#D9B8FF" stroke-width="1.8" opacity=".65"/></g>
            <g transform="translate(22 73)">
              <rect x="7" y="32" width="176" height="170" rx="16" fill="#6337C3" opacity=".35" stroke="#A87EFF" transform="rotate(-8 90 116)"/>
              <rect x="20" y="17" width="172" height="166" rx="15" fill="url(#wsCard)" stroke="#C69CFF" stroke-width="2" transform="rotate(7 100 100)"/>
              <rect x="0" y="0" width="176" height="162" rx="16" fill="url(#wsCard)" stroke="#D3A7FF" stroke-width="2.3"/>
              <rect x="0" y="0" width="176" height="32" rx="16" fill="#A675F1" opacity=".4"/>
              <circle cx="20" cy="17" r="4" fill="#E9D8FF"/><circle cx="34" cy="17" r="4" fill="#E9D8FF"/><circle cx="48" cy="17" r="4" fill="#E9D8FF"/>
              <rect x="23" y="49" width="131" height="76" rx="10" fill="#421D7C" stroke="#D3AEFF" opacity=".92"/>
              <path d="M33 107L67 75L89 91L116 63L147 110Z" fill="#B9A3FF" opacity=".75"/>
              <rect x="50" y="134" width="78" height="25" rx="7" fill="#2B1E4E" stroke="#CFAAFF"/>
              <text x="89" y="151" font-family="monospace" font-weight="700" font-size="19" fill="#EADEFF" text-anchor="middle">&lt;/&gt;</text>
            </g>
            <g class="ws-dots" fill="#DFFF6C" filter="url(#wsGlow)"><circle cx="246" cy="164" r="5"/><circle cx="308" cy="104" r="6"/><circle cx="365" cy="199" r="4"/><circle cx="454" cy="179" r="6"/><circle cx="530" cy="177" r="5"/></g>
            <g>
              <circle cx="331" cy="121" r="25" fill="#2A194B" stroke="#B99BFF" stroke-width="2"/><circle cx="331" cy="114" r="7" fill="#DBCAFF"/><path d="M316 136Q331 119 346 136Z" fill="#DBCAFF"/>
              <rect x="372" y="112" width="93" height="46" rx="16" fill="#7E50E3" stroke="#C4A4FF" stroke-width="2"/><path d="M388 155L383 167L406 156" fill="#7E50E3" stroke="#C4A4FF"/><circle cx="397" cy="135" r="4" fill="white"/><circle cx="418" cy="135" r="4" fill="white"/><circle cx="439" cy="135" r="4" fill="white"/>
              <circle cx="333" cy="243" r="24" fill="#2A194B" stroke="#B99BFF" stroke-width="2"/><circle cx="333" cy="237" r="7" fill="#DBCAFF"/><path d="M319 258Q333 241 347 258Z" fill="#DBCAFF"/>
              <rect x="373" y="224" width="82" height="43" rx="14" fill="#8350DF" stroke="#C4A4FF" stroke-width="2"/><circle cx="395" cy="245" r="4" fill="white"/><circle cx="415" cy="245" r="4" fill="white"/><circle cx="435" cy="245" r="4" fill="white"/>
            </g>
            <g transform="translate(559 72)" fill="url(#wsLimeCard)" stroke="#DBFF6E" stroke-width="1.6" filter="url(#wsGlow)">
              <rect x="0" y="0" width="58" height="62" rx="8"/><rect x="72" y="0" width="58" height="62" rx="8"/>
              <rect x="0" y="76" width="58" height="62" rx="8"/><rect x="72" y="76" width="58" height="62" rx="8"/>
              <rect x="0" y="152" width="58" height="62" rx="8"/><rect x="72" y="152" width="58" height="62" rx="8"/>
            </g>
            <g transform="translate(559 72)" fill="#597324">
              <circle cx="29" cy="24" r="10"/><path d="M10 49Q29 25 48 49Z"/><circle cx="101" cy="24" r="10"/><path d="M82 49Q101 25 120 49Z"/>
              <circle cx="29" cy="100" r="10"/><path d="M10 125Q29 101 48 125Z"/><circle cx="101" cy="100" r="10"/><path d="M82 125Q101 101 120 125Z"/>
              <circle cx="29" cy="176" r="10"/><path d="M10 201Q29 177 48 201Z"/><circle cx="101" cy="176" r="10"/><path d="M82 201Q101 177 120 201Z"/>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <section class="ws-proof" id="proof" aria-label="Experience behind WSS Solo">
      <div class="ws-wrap ws-proof-inner">
        <span class="ws-proof-kicker">FROM THE TEAM AT WE SCALE STARTUPS</span>
        <p><strong>£18M+</strong> revenue influenced through previous WSS work</p>
        <small>WSS Solo is new.<br />No cohort results yet.</small>
      </div>
    </section>

    <section class="ws-section ws-challenge" id="challenge">
      <div class="ws-wrap">
        <h2>You built the product.<br />Now build <em>what's around it.</em></h2>
        <div class="ws-problem-grid">
          <article class="ws-problem-card">
            <div class="ws-problem-icon" aria-hidden="true">
              <svg viewBox="0 0 90 90" fill="none"><circle cx="45" cy="45" r="31" stroke="#D7C1FA" stroke-width="6"/><circle cx="45" cy="45" r="20" stroke="#BA8BFF" stroke-width="6"/><circle cx="45" cy="45" r="8" fill="#6D30D0"/><path d="M45 45L75 15" stroke="#11121B" stroke-width="5" stroke-linecap="round"/><path d="M68 8L82 5L81 20Z" fill="#CFFF4B"/></svg>
            </div>
            <div><h3>Unclear next step</h3><p>Plenty of ideas. No clear priority.</p></div>
          </article>
          <article class="ws-problem-card">
            <div class="ws-problem-icon" aria-hidden="true"><svg viewBox="0 0 90 90"><path d="M15 36L45 18L75 36L45 54Z" fill="#A568F1"/><path d="M15 47L45 65L75 47" fill="none" stroke="#DBFF64" stroke-width="10" stroke-linejoin="round"/><path d="M15 59L45 77L75 59" fill="none" stroke="#5D35AB" stroke-width="10" stroke-linejoin="round"/></svg></div>
            <div><h3>Disconnected tools</h3><p>Too many moving parts, nothing joined up.</p></div>
          </article>
          <article class="ws-problem-card">
            <div class="ws-problem-icon" aria-hidden="true"><svg viewBox="0 0 90 90" fill="none"><path d="M50 8L22 49H44L36 82L70 36H48Z" fill="#CFFF4B"/><circle cx="45" cy="45" r="40" stroke="#BE92FD" stroke-width="2" stroke-dasharray="3 11"/></svg></div>
            <div><h3>No repeatable process</h3><p>Too much manual work to make progress.</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="ws-section ws-method" id="how">
      <div class="ws-wrap">
        <div class="ws-method-heading">
          <h2>Your goal.<br /><em>The setup to get there.</em></h2>
          <p>There's no single playbook for every startup. We work backwards from what you're trying to achieve and build the practical systems to help you get there.</p>
        </div>
        <div class="ws-method-grid">
          <article class="ws-method-card">
            <span class="ws-method-step">01</span>
            <span class="ws-method-icon" aria-hidden="true">◎</span>
            <p class="ws-method-kicker">GET CLEAR</p>
            <h3>Choose what<br />to work towards</h3>
            <p>Work out your next goal, what's getting in the way and where to focus.</p>
            <p class="ws-method-output"><span>THE OUTPUT</span><strong>A clear goal and a realistic plan.</strong></p>
          </article>
          <article class="ws-method-card">
            <span class="ws-method-step">02</span>
            <span class="ws-method-icon" aria-hidden="true">✳</span>
            <p class="ws-method-kicker">DESIGN THE SETUP</p>
            <h3>Find the right<br />way forward</h3>
            <p>Choose the channels, customer journey and processes that fit your business.</p>
            <p class="ws-method-output"><span>THE OUTPUT</span><strong>A setup designed for your business.</strong></p>
          </article>
          <article class="ws-method-card">
            <span class="ws-method-step">03</span>
            <span class="ws-method-icon" aria-hidden="true">↗</span>
            <p class="ws-method-kicker">BUILD IT</p>
            <h3>Put the tools<br />in place</h3>
            <p>Build what you actually need, whether that's a CRM, acquisition workflow, onboarding or AI automations.</p>
            <p class="ws-method-output"><span>THE OUTPUT</span><strong>Working tools and connected workflows.</strong></p>
          </article>
          <article class="ws-method-card">
            <span class="ws-method-step">04</span>
            <span class="ws-method-icon" aria-hidden="true">▥</span>
            <p class="ws-method-kicker">MAKE IT WORK</p>
            <h3>Run it. Learn.<br />Improve it.</h3>
            <p>Put your setup to use, see what moves the needle and keep refining it.</p>
            <p class="ws-method-output"><span>THE OUTPUT</span><strong>A system you can keep using and improving.</strong></p>
          </article>
        </div>
        <div class="ws-method-how">
          <div><span class="ws-method-how-symbol" aria-hidden="true">✳</span><strong>What the programme looks like</strong></div>
          <p>Hands-on working sessions, practical building and feedback. What we work on depends on your product, stage and goal, not a fixed list of homework.</p>
        </div>
        <div class="ws-method-footnote">Proposed first-cohort approach. Programme scope, duration and session format will be confirmed before anyone commits.</div>
      </div>
    </section>

        <section class="ws-section ws-fit" id="fit">
      <div class="ws-wrap ws-fit-grid">
        <div class="ws-fit-art" aria-hidden="true"><div class="ws-fit-window ws-fit-window-back"></div><div class="ws-fit-window ws-fit-window-front"><div class="ws-window-dots"><i></i><i></i><i></i></div><div class="ws-window-bars"><span></span><span></span><span></span><span></span></div><div class="ws-window-pointer">➤</div></div></div>
        <h2>Built something?<br /><em>This is for you.</em></h2>
        <ul class="ws-fit-list">
          <li>Solo founder or very small team</li>
          <li>AI-built or AI-enabled product</li>
          <li>Early in your customer journey</li>
          <li>Ready to test and take action</li>
        </ul>
      </div>
    </section>

    <section class="ws-callout">
      <div class="ws-wrap ws-callout-inner">
        <h2>Get on the<br />waitlist.</h2>
        <div class="ws-callout-action"><a href="#waitlist" class="ws-btn ws-btn-dark">Join the waitlist <span aria-hidden="true">↗</span></a><p>No payment. Get first-cohort updates.</p></div>
      </div>
    </section>

    <section class="ws-section ws-application" id="waitlist">
      <div class="ws-wrap ws-application-grid">
        <div class="ws-form-intro">
          <p class="ws-eyebrow-dark">WSS SOLO / FIRST COHORT</p>
          <h2>Get on<br />the <em>waitlist.</em></h2>
          <p>Be first to hear when WSS Solo opens. No payment, no commitment.</p>
          <div class="ws-form-tag"><span aria-hidden="true">✳</span> First cohort, currently gathering interest</div>
        </div>
        <div class="ws-form-wrap">
          <form id="ws-solo-waitlist" action="/api/solo-waitlist" method="post">
            <p class="ws-form-heading">Join the WSS Solo waitlist</p>
            <div class="ws-form-duo">
              <label>Your name <input name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Your name" /></label>
              <label>Email <input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@startup.com" /></label>
            </div>
            <label>Where are you now? <span class="ws-optional">(optional)</span>
              <select name="stage"><option value="">Choose your stage</option><option value="idea">Exploring an idea</option><option value="building">Building an MVP</option><option value="launched">Launched, looking for customers</option><option value="customers">Already have some customers</option></select>
            </label>
            <label class="ws-consent">
              <input type="checkbox" name="waitlist_consent" value="yes" required />
              <span>Email me about WSS Solo and its first cohort. I can unsubscribe at any time.</span>
            </label>
            <div class="ws-honeypot" aria-hidden="true"><label>Leave this blank<input type="text" name="wss_solo_auxiliary_7d2" autocomplete="off" tabindex="-1" aria-hidden="true"/></label></div>
            <input type="hidden" name="source_page" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <button class="ws-btn ws-btn-purple ws-submit" type="submit">Join the waitlist <span aria-hidden="true">↗</span></button>
            <p id="ws-waitlist-status" class="ws-form-message" role="status" aria-live="polite"></p>
            <p class="ws-form-info">Only WSS Solo updates. See our <a href="/privacy">privacy policy</a>.</p>
          </form>
          <div id="ws-waitlist-success" class="ws-waitlist-success" role="status" aria-live="polite" hidden>
            <div class="ws-success-icon" aria-hidden="true">✓</div>
            <p class="ws-eyebrow-dark">YOU'RE ON THE LIST</p>
            <h3>You're on the waitlist.</h3>
            <p>Thanks for your interest. We'll be in touch when there are updates about the first WSS Solo cohort.</p>
            <a href="/" class="ws-success-link">Explore We Scale Startups ↗</a>
          </div>
        </div>
      </div>
    </section>
    <footer class="ws-bottom"><div class="ws-wrap"><a href="/" aria-label="We Scale Startups homepage">WSS <span>/</span> SOLO</a><span>A new programme from We Scale Startups.</span></div></footer>
  </main>
  <script is:inline>
    (() => {
      const form = document.getElementById("ws-solo-waitlist");
      const success = document.getElementById("ws-waitlist-success");
      const notice = document.getElementById("ws-waitlist-status");
      if (!(form instanceof HTMLFormElement) || !success) return;

      const source = form.querySelector('[name="source_page"]');
      if (source) source.value = window.location.href;
      const query = new URLSearchParams(window.location.search);
      for (const field of ["utm_source", "utm_medium", "utm_campaign"]) {
        const input = form.querySelector('[name="' + field + '"]');
        if (input) input.value = (query.get(field) || "").slice(0, 150);
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const button = form.querySelector('button[type="submit"]');
        const payload = Object.fromEntries(new FormData(form).entries());
        payload.waitlist_consent = payload.waitlist_consent === "yes" ? "yes" : "no";
        payload.source_page = window.location.href;
        if (button) { button.disabled = true; button.textContent = "Joining..."; }
        if (notice) notice.textContent = "";
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Accept": "application/json" },
            body: JSON.stringify(payload)
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.ok !== true || result.joined !== true) {
            throw new Error(result.error || "Could not save your place. Please try again.");
          }
          form.hidden = true;
          success.hidden = false;
          success.scrollIntoView({ behavior: "smooth", block: "center" });
          if (window.dataLayer) window.dataLayer.push({ event: "solo_waitlist_joined", page_path: "/solo" });
        } catch (error) {
          if (notice) notice.textContent = error instanceof Error ? error.message : "Something went wrong. Please try again.";
        } finally {
          if (button) { button.disabled = false; button.innerHTML = 'Join the waitlist <span aria-hidden="true">↗</span>'; }
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap');
  .ws-solo{--night:#100F1F;--night2:#171126;--ink:#121124;--paper:#F9F7F4;--purple:#7339D6;--lime:#D7FF58;--muted:#5C596B;color:var(--ink);font-family:'DM Sans',Arial,sans-serif;overflow:hidden;background:#fff}
  .ws-solo *, .ws-solo *::before,.ws-solo *::after{box-sizing:border-box}
  .ws-wrap{width:min(1200px,calc(100% - 3.5rem));margin-inline:auto}
  .ws-solo a{text-underline-offset:4px}.ws-solo :focus-visible{outline:3px solid #9D63F5;outline-offset:4px}
  .ws-nav{position:relative;z-index:4;background:#100F1F;color:white}
  .ws-nav-inner{min-height:79px;display:flex;align-items:center;justify-content:space-between;gap:2rem}
  .ws-brand{display:inline-flex;align-items:center;gap:.38rem;color:#fff;font-size:1.65rem;letter-spacing:-.065em;text-decoration:none;white-space:nowrap}
  .ws-brand strong{font-weight:800}.ws-brand>span:first-of-type{color:var(--lime);margin:0 .15rem;font-weight:300}.ws-brand>span:last-of-type{font-weight:450}
  .ws-nav-links{display:flex;align-items:center;gap:clamp(.7rem,2.2vw,2rem)}.ws-nav-links a{font-size:.81rem;font-weight:650;color:#E9E5F5;text-decoration:none;white-space:nowrap}
