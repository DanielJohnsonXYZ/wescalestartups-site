---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema } from "../lib/schema";
import { studioProjects } from "../data/studioProjects";

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Studio", path: "/studio" }
]);
---

<BaseLayout
  path="/studio"
  title="WSS Studio | Things We're Building | We Scale Startups"
  description="Explore products, tools and experiments built by We Scale Startups, including Radar, Crux, Focus and WSS Solo."
  schema={breadcrumb}
  breadcrumbItems={[{ name: "Home", path: "/" }, { name: "Studio", path: "/studio" }]}
  showAnnouncement={false}
  stickyBookCta={false}
  newsletterPopup={false}
>
  <div class="studio-page">
    <section class="studio-hero" aria-labelledby="studio-heading">
      <div class="shell studio-hero-inner">
        <p class="studio-eyebrow"><span class="studio-eyebrow-dot" aria-hidden="true"></span> WSS / STUDIO</p>
        <h1 id="studio-heading">Things we're <span>building.</span></h1>
        <p class="studio-intro">A collection of products, tools and experiments we've created. Take a look around.</p>
      </div>
    </section>

    <section class="studio-collection" aria-label="Explore our projects">
      <div class="shell">
        <div class="studio-section-header">
          <p>THE COLLECTION</p>
          <span>{String(studioProjects.length).padStart(2, "0")} PROJECTS</span>
        </div>
        <div class="studio-grid">
          {studioProjects.map((project, index) => (
            <article class="studio-card">
              <a
                class="studio-card-link"
                href={project.href}
                target={project.external ? "_blank" : undefined}
                rel={project.external ? "noopener noreferrer" : undefined}
                aria-label={`Explore ${project.name}${project.external ? " in a new tab" : ""}`}
                data-cta="studio-project"
                data-project={project.name.toLowerCase().replaceAll(" ", "-")}
              >
                <div class="studio-card-media">
                  <img
                    src={project.image}
                    alt={project.imageAlt}
                    width="1280"
                    height="840"
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <span class="studio-preview-corner" aria-hidden="true">↗</span>
                </div>
                <div class="studio-card-content">
                  <div class="studio-card-meta">
                    <span>{project.category}</span>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                  </div>
                  <h2>{project.name}</h2>
                  <p>{project.description}</p>
                  <div class="studio-card-action">
                    <span>Explore project</span><span class="studio-arrow" aria-hidden="true">↗</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
        <p class="studio-footnote">A few of the ideas we're making real. More will find their way here.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .studio-page { background: #fff; overflow: hidden; }
  .studio-hero { position: relative; isolation: isolate; padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(3rem, 6vw, 5.5rem); background: #fff; }
  .studio-hero::before { content: ""; position: absolute; z-index: -1; top: -15rem; right: -19rem; width: 44rem; height: 44rem; background: radial-gradient(circle, rgba(128, 108, 255, .18), rgba(128, 108, 255, .06) 44%, transparent 70%); pointer-events: none; }
  .studio-hero-inner { position: relative; }
  .studio-eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0 0 1.45rem; color: var(--v9-violet-deep); font: 700 .77rem/1.4 var(--v9-mono); letter-spacing: .095em; }
  .studio-eyebrow-dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--v9-violet-deep); box-shadow: 0 0 0 .27rem rgba(128, 108, 255, .12); }
  .studio-hero h1 { font-family: var(--v9-sans); font-size: clamp(3.3rem, 7.4vw, 7rem); font-weight: 750; letter-spacing: -.075em; line-height: 1.02; max-width: 1150px; margin: 0; color: var(--v9-ink); }
  .studio-hero h1 span { color: var(--v9-violet-deep); }
  .studio-intro { max-width: 630px; color: var(--v9-copy); font-size: clamp(1.1rem, 2vw, 1.45rem); line-height: 1.55; margin: 1.6rem 0 0; letter-spacing: -.02em; }
  .studio-collection { padding: 0 0 clamp(5rem, 9vw, 9rem); }
  .studio-section-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--v9-line); padding: 1.2rem 0 1.75rem; font: 650 .72rem/1.4 var(--v9-mono); color: #696772; letter-spacing: .075em; }
  .studio-section-header p { margin: 0; }
  .studio-section-header span { color: var(--v9-violet-deep); }
  .studio-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.2vw, 2rem); }
  .studio-card { min-width: 0; overflow: hidden; border: 1px solid rgba(17,17,23,.1); border-radius: 1.35rem; background: #fff; box-shadow: 0 12px 44px rgba(17, 17, 23, .035); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .studio-card:hover { transform: translateY(-4px); border-color: rgba(128,108,255,.38); box-shadow: 0 20px 56px rgba(17, 17, 23, .09); }
  .studio-card-link { display: flex; height: 100%; flex-direction: column; color: inherit; text-decoration: none; }
  .studio-card-link:hover { color: inherit; text-decoration: none; }
  .studio-card-link:focus-visible { outline: 3px solid var(--v9-violet-deep); outline-offset: -4px; border-radius: 1.2rem; }
  .studio-card-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: linear-gradient(145deg, #f3f0ff, #ecebf6); }
  .studio-card-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform .28s ease; }
  .studio-card:hover img { transform: scale(1.025); }
  .studio-preview-corner { position: absolute; top: 1rem; right: 1rem; display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border-radius: 50%; background: rgba(255,255,255,.94); box-shadow: 0 4px 17px rgba(0,0,0,.12); font-size: 1.15rem; color: var(--v9-violet-deep); }
  .studio-card-content { display: flex; flex-direction: column; flex: 1; min-height: 235px; padding: clamp(1.3rem, 2.4vw, 2.1rem); }
  .studio-card-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; font: 600 .7rem/1.5 var(--v9-mono); color: var(--v9-violet-deep); text-transform: uppercase; letter-spacing: .06em; }
  .studio-card-meta span:last-child { color: #888591; }
  .studio-card h2 { color: var(--v9-ink); font: 730 clamp(1.9rem, 2.8vw, 2.65rem)/1.1 var(--v9-sans); letter-spacing: -.055em; margin: .85rem 0 .6rem; }
  .studio-card p { color: var(--v9-copy); font-size: clamp(.97rem, 1.3vw, 1.08rem); line-height: 1.55; max-width: 38ch; margin: 0 0 1.6rem; }
  .studio-card-action { display: flex; align-items: center; gap: .6rem; margin-top: auto; color: var(--v9-violet-deep); font-size: .95rem; font-weight: 700; }
  .studio-arrow { transition: transform .2s ease; font-size: 1.25rem; }
  .studio-card:hover .studio-arrow { transform: translate(3px, -3px); }
  .studio-footnote { margin: 2.1rem 0 0; text-align: center; color: #77737d; font-size: .95rem; }
  @media (max-width: 760px) {
    .studio-hero { padding-top: 3.5rem; }
    .studio-grid { grid-template-columns: minmax(0,1fr); }
    .studio-card-content { min-height: 210px; }
    .studio-card-media { aspect-ratio: 16/9; }
    .studio-hero h1 { font-size: clamp(2.6rem, 10.5vw, 5.3rem); white-space: normal; }
    .studio-hero h1 span { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .studio-card, .studio-card-media img, .studio-arrow { transition: none; }
  }
</style>
