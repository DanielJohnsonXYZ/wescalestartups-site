---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailSignup from "../components/EmailSignup.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { buildBreadcrumbSchema } from "../lib/schema";
import { insightsHubRelatedReading, siteConfig } from "../site";

const schemas = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Newsletter", path: "/newsletter" }
  ])
];
---

<BaseLayout
  title={`${siteConfig.newsletterName}, newsletter | We Scale Startups`}
  description={`${siteConfig.newsletterDescription} ${siteConfig.newsletterFrequencyLine}`}
  path="/newsletter"
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "Newsletter", path: "/newsletter" }
  ]}
  schema={schemas}
  lastUpdated={siteConfig.lastUpdated}
>
  <section class="page-hero" aria-labelledby="wss-newsletter-title">
    <div class="shell">
      <p class="eyebrow">Newsletter</p>
      <h1 id="wss-newsletter-title">{siteConfig.newsletterName}</h1>
      <div class="hero-support">
        <p class="hero-copy">
          {siteConfig.newsletterDescription} {siteConfig.newsletterFrequencyLine} Sent from Daniel Johnson · {siteConfig.email}.
        </p>
        <p class="hero-copy">
          Same list as the site footer, one name and cadence everywhere.
        </p>
        <p class="hero-copy">
          For Daniel’s personal writing list (occasional growth notes from{" "}
          <a class="link-arrow" href={`${siteConfig.danielSite}/newsletter/`} rel="noopener">
            danieljohnson.xyz
          </a>
          ), use that page, this list is the We Scale Startups / operator lens.
        </p>
        <div class="hero-actions">
          <a class="button button-brand" href="#newsletter-subscribe" data-cta="newsletter-hero-subscribe">
            Subscribe below ↓
          </a>
          <a class="button button-light" href={siteConfig.bookingUrl} data-cta="newsletter-hero-book">
            Or, {siteConfig.bookingLabel} →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="newsletter-subscribe">
    <div class="shell">
      <SectionIntro
        eyebrow="Subscribe"
        title="Get the next issue"
        body="Single opt-in, you’ll get the next send automatically. Unsubscribe any time."
      />
      <EmailSignup
        variant="light"
        formId="page-newsletter-growth-bottleneck"
        heading={siteConfig.newsletterName}
        subtext={`${siteConfig.newsletterDescription} ${siteConfig.newsletterFrequencyLine}`}
      />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="Inside each issue" title="What you’ll read" />
      <div class="grid-2">
        {[
          "How to name the real constraint before you add channel spend",
          "Systems vs activity, what “repeatable acquisition” actually looks like",
          "Patterns from fractional CMO work with Seed–Series B teams",
          "Deeper essays on Insights when a topic deserves the long version"
        ].map((item) => (
          <article class="feature-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
      <p class="not-for-footnote">
        Prefer a call? <a class="link-arrow" href={siteConfig.bookingUrl}>{siteConfig.bookingLabel} →</a>
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="Keep exploring" title="Related on the site" />
      <div class="grid-2">
        {insightsHubRelatedReading.map((link) => (
          <a class="feature-card" href={link.href}>
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Rather talk it through?</p>
        <h2>Bring the current growth picture to a live call.</h2>
        <p>
          {siteConfig.bookingCallDurationPhrase}. We'll name the constraint in plain English, no pitch unless there's a clear fit.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="newsletter-final-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
