---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildServiceSchema } from "../lib/schema";

---

<BaseLayout
  title="WSS Solo | Built something with AI. Now what?"
  description="WSS Solo helps founders turn AI-built products into paying customers. Join the first-cohort waitlist for updates."
  keywords="WSS Solo, solo founder programme, AI-built product, first paying customers, founder cohort, growth systems for solo founders"
  aiRole="Small-cohort programme helping solo founders with AI-built products get their first paying customers"
  aiServes="Solo founders and very small teams with a launched AI-built product or MVP"
  path="/solo"
  ogImage="/og/solo.png"
  ogImageAlt="WSS Solo: you built it, now make it grow"
  schema={[
    buildBreadcrumbSchema([{name:"Home",path:"/"},{name:"WSS Solo",path:"/solo"}]),
    buildServiceSchema("WSS Solo", "A four-week small-cohort programme from We Scale Startups. Solo founders with AI-built products work out who their customer is, test their riskiest assumptions and build the setup that brings in paying customers.", "/solo")
  ]}
  showSiteHeader={false}
  bodyClass="solo-landing-body"
  showAnnouncement={false}
  stickyBookCta={false}
  newsletterPopup={false}
  showFooterNewsletter={false}
  showFooterScorecard={false}
>
  <main class="ws-solo">
    <header class="ws-nav">
      <div class="ws-wrap ws-nav-inner">
        <a href="/" class="ws-brand" aria-label="We Scale Startups home">WSS <span>Solo</span></a>
        <nav class="ws-nav-links" aria-label="WSS Solo navigation">
          <a href="#how">The four weeks</a><a href="#founder">Who runs it</a><a href="#faq">Questions</a>
          <a href="#waitlist" class="ws-btn ws-btn-small">Join the waitlist</a>
        </nav>
      </div>
    </header>

    <section class="ws-hero" aria-labelledby="ws-title">
      <div class="ws-wrap ws-hero-grid">
        <div>
          <h1 id="ws-title">You built it.<br />Now make it grow.</h1>
          <p class="ws-lead">WSS Solo is a four-week programme for solo founders who have built a product with AI and now need customers. You work on your own product, in a small group, with me.</p>
          <div class="ws-hero-actions">
            <a class="ws-btn" href="#waitlist">Join the waitlist</a>
            <a class="ws-textlink" href="#how">See the four weeks</a>
          </div>
        </div>
        <dl class="ws-glance" aria-label="WSS Solo at a glance">
          <div><dt>Length</dt><dd>Four weeks</dd></div>
          <div><dt>Format</dt><dd>One live session a week, plus help in between</dd></div>
          <div><dt>Group</dt><dd>Small, so everyone gets time on their own product</dd></div>
          <div><dt>Run by</dt><dd>Daniel Johnson. 479+ founder mentoring sessions, rated 4.97 out of 5</dd></div>
        </dl>
      </div>
    </section>

    <section class="ws-section ws-tint" id="challenge">
      <div class="ws-wrap ws-narrow">
        <h2>The product works. Finding customers is guesswork.</h2>
        <p>Most of the solo founders I mentor are in the same place.</p>
        <ul class="ws-plain">
          <li>You shipped, and nobody signed up.</li>
          <li>You post most days and can't tell what brings people in.</li>
          <li>Every idea sounds plausible, so you try a bit of everything.</li>
        </ul>
        <p class="ws-strong">Most products stall on an assumption nobody tested. Solo is four weeks of testing yours.</p>
      </div>
    </section>

    <section class="ws-section" id="how">
      <div class="ws-wrap">
        <h2>Four weeks, from guessing to knowing.</h2>
        <p class="ws-sub">One piece of work a week, on your own product. You keep everything you make.</p>
        <ol class="ws-weeks">
          <li>
            <span class="ws-week">Week 1</span>
            <div><h3>Know your customer</h3><p>Who it's for, who it isn't, and the problem you solve.</p></div>
            <p class="ws-out"><span>You leave with</span> A one-page customer picture</p>
          </li>
          <li>
            <span class="ws-week">Week 2</span>
            <div><h3>Sort fact from belief</h3><p>List what you're assuming. Pick the riskiest.</p></div>
            <p class="ws-out"><span>You leave with</span> Your assumptions, ranked</p>
          </li>
          <li>
            <span class="ws-week">Week 3</span>
            <div><h3>Test it cheaply</h3><p>Small tests with real people.</p></div>
            <p class="ws-out"><span>You leave with</span> A test plan and real results</p>
          </li>
          <li>
            <span class="ws-week">Week 4</span>
            <div><h3>Build what works</h3><p>Tools and workflows around what the tests back.</p></div>
            <p class="ws-out"><span>You leave with</span> A setup you keep using</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="ws-section ws-tint" id="fit">
      <div class="ws-wrap">
        <h2>Is it for you?</h2>
        <div class="ws-fit">
          <div>
            <h3>A good fit if</h3>
            <ul class="ws-plain">
              <li>You have an AI-built product or MVP that people can use today.</li>
              <li>You're a solo founder or a very small team.</li>
              <li>You want customers and aren't sure where to start.</li>
              <li>You want hands-on help, not another course.</li>
            </ul>
          </div>
          <div>
            <h3>Not a fit if</h3>
            <ul class="ws-plain">
              <li>You're still at the idea stage with nothing built.</li>
              <li>You want someone to run your marketing for you.</li>
              <li>You're a funded team with a marketing hire. <a href="/services">See how WSS works with funded teams.</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="ws-section" id="founder" aria-labelledby="ws-founder-title">
      <div class="ws-wrap">
        <div class="ws-founder">
          <picture class="ws-founder-photo">
            <source type="image/webp" srcset="/images/daniel-headshot-640.webp 640w, /images/daniel-headshot-960.webp 960w" sizes="(max-width: 850px) 60vw, 300px" />
            <img src="/images/daniel-headshot-960.webp" alt="Daniel Johnson, founder of We Scale Startups" width="960" height="1003" loading="lazy" decoding="async" />
          </picture>
          <div>
            <h2 id="ws-founder-title">Who runs it</h2>
            <p>I'm Daniel Johnson. I've spent 15 years growing startups, including two I helped take to exit. Most of that work has been with funded teams. WSS Solo is the same work, cut down for founders building on their own.</p>
            <p class="ws-facts">Two exits, eQuoo and Image To Painting. £18M+ revenue influenced for WSS clients. Mentor at Google for Startups.</p>
            <a class="ws-textlink" href="/about/daniel">More about Daniel</a>
          </div>
        </div>
        <h3 class="ws-quotes-title">What founders say after a session</h3>
        <div class="ws-quotes">
          <figure><blockquote>He helped me reframe the problem, pushing me to dig deeper into the why behind our customers' needs.</blockquote><figcaption>Greg Weinstein, GrowthMentor review</figcaption></figure>
          <figure><blockquote>Within 10 mins he identified the gaps in our funnel and actual problem that I oversaw.</blockquote><figcaption>Egor Donde, GrowthMentor review</figcaption></figure>
          <figure><blockquote>Daniel Johnson is the "no fluff", straight-to-the-point person to talk to for marketing.</blockquote><figcaption>Jawad Ahmed, GrowthMentor review</figcaption></figure>
        </div>
      </div>
    </section>

    <section class="ws-section ws-tint" id="faq">
      <div class="ws-wrap ws-narrow">
        <h2>Questions</h2>
        <details><summary>Is this a course?</summary><p>No. There are no lessons to sit through. Each week you do one piece of work on your own product and leave with something you can use.</p></details>
        <details><summary>What do I need to join?</summary><p>A product or MVP that people can use today. If you're still at the idea stage, it's too early.</p></details>
        <details><summary>How much time does it take?</summary><p>One live session a week, plus time between sessions to do the work.</p></details>
        <details><summary>When does it start, and what does it cost?</summary><p>Dates and price aren't set yet. People on the waitlist hear first.</p></details>
      </div>
    </section>

    <section class="ws-section" id="waitlist">
      <div class="ws-wrap ws-application-grid">
        <div>
          <h2>Join the waitlist</h2>
          <p class="ws-sub">The first cohort is a small group. People on the waitlist hear the dates first.</p>
        </div>
        <div class="ws-form-wrap">
          <form id="ws-solo-waitlist" action="/api/solo-waitlist" method="post">
            <p class="ws-form-heading">Join the WSS Solo waitlist</p>
            <div class="ws-form-duo">
              <label>Your name <input name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Your name" /></label>
              <label>Email <input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@startup.com" /></label>
            </div>
            <label>Where are you now? <span class="ws-optional">(optional)</span>
              <select name="stage"><option value="">Choose your stage</option><option value="launched">Launched, looking for customers</option><option value="customers">Already have some customers</option></select>
            </label>
            <label>Product URL <span class="ws-optional">(optional)</span>
              <input name="product_url" type="text" inputmode="url" autocomplete="url" maxlength="300" placeholder="yourproduct.com" />
            </label>
            <label class="ws-consent">
              <input type="checkbox" name="waitlist_consent" value="yes" required />
              <span>Email me about WSS Solo and its first cohort. I can unsubscribe at any time.</span>
            </label>
            <div class="ws-honeypot" aria-hidden="true"><label>Leave this blank<input type="text" name="wss_solo_auxiliary_7d2" autocomplete="off" tabindex="-1" aria-hidden="true"/></label></div>
            <input type="hidden" name="source_page" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <button class="ws-btn ws-btn-purple ws-submit" type="submit">Join the waitlist</button>
            <p id="ws-waitlist-status" class="ws-form-message" role="status" aria-live="polite"></p>
            <p class="ws-form-info">Only WSS Solo updates. See our <a href="/privacy">privacy policy</a>.</p>
          </form>
          <div id="ws-waitlist-success" class="ws-waitlist-success" role="status" aria-live="polite" hidden>
            <div class="ws-success-icon" aria-hidden="true">✓</div>
            <p class="ws-eyebrow-dark">YOU'RE ON THE LIST</p>
            <h3>You're on the waitlist.</h3>
            <p>Thanks for your interest. We'll be in touch when there are updates about the first WSS Solo cohort.</p>
            <a href="/" class="ws-success-link">Explore We Scale Startups</a>
          </div>
        </div>
      </div>
    </section>
    <footer class="ws-bottom"><div class="ws-wrap"><a href="/">We Scale Startups</a><span>WSS Solo is a new programme from We Scale Startups.</span></div></footer>
  </main>
  <script is:inline>
    (() => {
      const form = document.getElementById("ws-solo-waitlist");
      const success = document.getElementById("ws-waitlist-success");
      const notice = document.getElementById("ws-waitlist-status");
      if (!(form instanceof HTMLFormElement) || !success) return;

      const source = form.querySelector('[name="source_page"]');
      if (source) source.value = window.location.href;
      const query = new URLSearchParams(window.location.search);
      for (const field of ["utm_source", "utm_medium", "utm_campaign"]) {
        const input = form.querySelector('[name="' + field + '"]');
        if (input) input.value = (query.get(field) || "").slice(0, 150);
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const button = form.querySelector('button[type="submit"]');
        const payload = Object.fromEntries(new FormData(form).entries());
        payload.waitlist_consent = payload.waitlist_consent === "yes" ? "yes" : "no";
        payload.source_page = window.location.href;
        if (button) { button.disabled = true; button.textContent = "Joining..."; }
        if (notice) notice.textContent = "";
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Accept": "application/json" },
            body: JSON.stringify(payload)
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.ok !== true || result.joined !== true) {
            throw new Error(result.error || "Could not save your place. Please try again.");
          }
          form.hidden = true;
          success.hidden = false;
          success.scrollIntoView({ behavior: "smooth", block: "center" });
          if (window.dataLayer) window.dataLayer.push({ event: "solo_waitlist_joined", page_path: "/solo" });
        } catch (error) {
          if (notice) notice.textContent = error instanceof Error ? error.message : "Something went wrong. Please try again.";
        } finally {
          if (button) { button.disabled = false; button.textContent = 'Join the waitlist'; }
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .ws-solo{--ink:#17151F;--muted:#5A5668;--line:#E4E1EA;--tint:#F6F5F9;--purple:#5B2ED6;--purple-dark:#4A22B8;color:var(--ink);background:#fff;font-family:"Geist",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;font-size:1.0625rem;line-height:1.6}
  .ws-solo *,.ws-solo *::before,.ws-solo *::after{box-sizing:border-box}
  .ws-solo h1,.ws-solo h2,.ws-solo h3{font-family:inherit;color:var(--ink);margin:0;letter-spacing:-.025em;font-style:normal}
  .ws-solo p{margin:0}
  .ws-solo a{color:var(--purple);text-underline-offset:3px}
  .ws-solo :focus-visible{outline:3px solid var(--purple);outline-offset:3px}
  .ws-wrap{width:min(1080px,calc(100% - 3rem));margin-inline:auto}
  .ws-narrow{max-width:720px}

  .ws-nav{border-bottom:1px solid var(--line)}
  .ws-nav-inner{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
  .ws-solo .ws-brand{font-weight:700;font-size:1.15rem;color:var(--ink);text-decoration:none;letter-spacing:-.02em}
  .ws-brand span{font-weight:500;color:var(--purple)}
  .ws-nav-links{display:flex;align-items:center;gap:1.6rem}
  .ws-solo .ws-nav-links a:not(.ws-btn){font-size:.95rem;color:var(--ink);text-decoration:none}
  .ws-solo .ws-nav-links a:not(.ws-btn):hover{color:var(--purple)}

  .ws-solo .ws-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:.8rem 1.4rem;border:0;border-radius:8px;background:var(--purple);color:#fff;font:600 1rem/1.2 inherit;font-family:inherit;text-decoration:none;cursor:pointer}
  .ws-solo .ws-btn:hover{background:var(--purple-dark);color:#fff}
  .ws-solo .ws-btn-small{min-height:40px;padding:.55rem 1rem;font-size:.92rem}
  .ws-textlink{font-weight:600}

  .ws-hero{padding:clamp(3.5rem,8vw,6.5rem) 0 clamp(3rem,6vw,5rem)}
  .ws-hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(2rem,6vw,5rem);align-items:end}
  .ws-solo h1{font-size:clamp(2.8rem,6.4vw,5.2rem);line-height:1.02;font-weight:700;letter-spacing:-.045em}
  .ws-lead{font-size:clamp(1.15rem,1.7vw,1.35rem);line-height:1.5;color:#35323F;max-width:34em;margin-top:1.6rem!important}
  .ws-hero-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-top:2rem}
  .ws-glance{margin:0;border-top:2px solid var(--ink)}
  .ws-glance div{display:grid;grid-template-columns:5.5rem 1fr;gap:1rem;padding:.85rem 0;border-bottom:1px solid var(--line)}
  .ws-glance dt{color:var(--muted);font-size:.92rem}
  .ws-glance dd{margin:0;font-size:.98rem;line-height:1.45;font-weight:500}

  .ws-section{padding:clamp(3.5rem,7vw,5.5rem) 0}
  .ws-tint{background:var(--tint)}
  .ws-solo h2{font-size:clamp(1.9rem,3.6vw,2.75rem);line-height:1.12;font-weight:700;letter-spacing:-.035em;max-width:20em}
  .ws-solo h3{font-size:1.2rem;line-height:1.3;font-weight:600}
  .ws-sub{color:var(--muted);margin-top:.9rem!important;max-width:36em}
  .ws-narrow h2+p{margin-top:1.4rem}
  .ws-plain{list-style:none;margin:1.1rem 0 0;padding:0;display:grid;gap:.7rem}
  .ws-plain li{position:relative;padding-left:1.4rem}
  .ws-plain li::before{content:"";position:absolute;left:0;top:.72em;width:.6rem;height:2px;background:var(--purple)}
  .ws-strong{font-weight:600;font-size:1.2rem;line-height:1.45;margin-top:1.8rem!important}

  .ws-weeks{list-style:none;margin:2.4rem 0 0;padding:0;border-top:2px solid var(--ink)}
  .ws-weeks li{display:grid;grid-template-columns:6rem 1.2fr 1fr;gap:1.5rem;align-items:baseline;padding:1.5rem 0;border-bottom:1px solid var(--line)}
  .ws-week{font-weight:600;color:var(--purple)}
  .ws-weeks h3{font-size:1.35rem}
  .ws-weeks li div p{color:var(--muted);margin-top:.3rem}
  .ws-out{font-weight:500}
  .ws-out span{display:block;font-size:.88rem;font-weight:400;color:var(--muted)}

  .ws-fit{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);margin-top:2rem}

  .ws-founder{display:grid;grid-template-columns:260px 1fr;gap:clamp(1.5rem,5vw,4rem);align-items:start}
  .ws-founder-photo img{display:block;width:100%;height:auto;border-radius:10px;background:#EAE6F6}
  .ws-founder p{margin-top:1.1rem;max-width:36em}
  .ws-facts{color:var(--muted)}
  .ws-founder .ws-textlink{display:inline-block;margin-top:1.1rem}
  .ws-quotes-title{margin-top:3.5rem!important}
  .ws-quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:1.4rem}
  .ws-quotes figure{margin:0;padding-top:1.1rem;border-top:1px solid var(--line)}
  .ws-quotes blockquote{margin:0;font-size:1.05rem;line-height:1.5}
  .ws-quotes figcaption{margin-top:.8rem;font-size:.9rem;color:var(--muted)}

  .ws-solo details{border-bottom:1px solid var(--line)}
  .ws-solo details:first-of-type{margin-top:1.6rem;border-top:1px solid var(--line)}
  .ws-solo summary{cursor:pointer;font-weight:600;padding:1.05rem 0;list-style-position:outside}
  .ws-solo details p{padding:0 0 1.2rem;color:#35323F;max-width:38em}

  .ws-application-grid{display:grid;grid-template-columns:.8fr 1.1fr;gap:clamp(2rem,6vw,5rem);align-items:start}
  #waitlist{scroll-margin-top:1rem}
  .ws-form-wrap{border:1px solid var(--line);border-radius:12px;padding:clamp(1.3rem,3vw,2.2rem);background:#fff}
  .ws-form-wrap form{display:grid;gap:1.05rem}
  .ws-form-duo{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
  .ws-form-wrap label{font-size:.92rem;font-weight:600;display:grid;gap:.4rem}
  .ws-form-wrap input,.ws-form-wrap select{width:100%;font:400 1rem/1.4 inherit;font-family:inherit;min-height:48px;padding:.7rem .85rem;border:1px solid #CFCBD8;border-radius:8px;background:#fff;color:var(--ink)}
  .ws-form-wrap input:focus,.ws-form-wrap select:focus{outline:2px solid var(--purple);outline-offset:1px}
  .ws-optional{font-weight:400;color:var(--muted)}
  .ws-form-heading{font-size:1.15rem;font-weight:700;margin:0 0 .2rem}
  .ws-form-wrap .ws-consent{display:flex;align-items:flex-start;gap:.7rem;cursor:pointer;font-weight:400;line-height:1.5}
  .ws-form-wrap .ws-consent input{width:19px;height:19px;min-height:19px;margin:3px 0 0;flex:0 0 19px;accent-color:var(--purple)}
  .ws-submit{width:100%}
  .ws-submit:disabled{opacity:.65;cursor:wait}
  .ws-form-info{font-size:.85rem;color:var(--muted)}
  .ws-form-wrap .ws-form-message{font-size:.9rem;font-weight:600;color:#B41E32}
  .ws-honeypot{position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden}
  .ws-solo .ws-form-wrap form[hidden],.ws-solo .ws-waitlist-success[hidden]{display:none}
  .ws-waitlist-success{padding:1rem 0}
  .ws-success-icon{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--purple);color:#fff;font-weight:700;font-size:1.5rem;margin-bottom:1.2rem}
  .ws-eyebrow-dark{font-size:.9rem;color:var(--muted)}
  .ws-waitlist-success h3{font-size:1.6rem;margin:.3rem 0 .8rem}
  .ws-waitlist-success p:not(.ws-eyebrow-dark){color:#35323F;margin-bottom:1.2rem}
  .ws-success-link{font-weight:600}

  .ws-bottom{border-top:1px solid var(--line);padding:1.6rem 0;font-size:.92rem;color:var(--muted)}
  .ws-bottom .ws-wrap{display:flex;justify-content:space-between;gap:1.5rem;flex-wrap:wrap}
  .ws-solo .ws-bottom a{color:var(--ink);font-weight:600;text-decoration:none}

  @media(max-width:850px){
    .ws-hero-grid,.ws-fit,.ws-application-grid{grid-template-columns:1fr}
    .ws-weeks li{grid-template-columns:5rem 1fr;row-gap:.6rem}
    .ws-out{grid-column:2}
    .ws-founder{grid-template-columns:1fr}.ws-founder-photo{max-width:220px}
    .ws-quotes{grid-template-columns:1fr;gap:1.2rem}
    .ws-solo .ws-nav-links a:not(.ws-btn){display:none}
  }
  @media(max-width:520px){
    .ws-wrap{width:calc(100% - 2rem)}
    .ws-form-duo{grid-template-columns:1fr}
    .ws-weeks li{grid-template-columns:1fr;row-gap:.3rem}.ws-out{grid-column:auto;margin-top:.4rem!important}
  }
  :global(body.solo-landing-body > footer.site-footer){display:none}
</style>
