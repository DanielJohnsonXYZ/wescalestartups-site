---
// WhatsAppCta.astro — reusable link to the Growing Pains founder WhatsApp
// community. External destination only; no backend wiring.
//
// Destination and default label come from siteConfig.growingPains, the same
// source /book/thanks and the Cal.com follow-up copy already use.
import { siteConfig } from "../site";

interface Props {
  /** Extra classes on the outer link. Include a `.button` + colour class
   *  (e.g. `button button-acid`) from components.css for a full CTA button,
   *  or a layout-only class (e.g. for the sticky bar icon slot). */
  class?: string;
  /** Visible label. Ignored when iconOnly is true. */
  label?: string;
  /** Accessible name used when iconOnly is true (falls back to label). */
  ariaLabel?: string;
  /** data-cta analytics label, mirrors the sitewide cta_click convention. */
  cta?: string;
  /** Render the icon only (no visible label) — for compact slots like the sticky bar. */
  iconOnly?: boolean;
  /** Render as an icon badge + title + sub-line + arrow (the sticky bar's
   *  card shape). Takes precedence over iconOnly. */
  card?: boolean;
  /** Second line, card only. */
  sublabel?: string;
}

const WHATSAPP_URL = siteConfig.growingPains.whatsappUrl;

const {
  class: className = "",
  label = siteConfig.growingPains.whatsappLabel,
  ariaLabel,
  cta = "whatsapp-community",
  iconOnly = false,
  card = false,
  sublabel
} = Astro.props;

const accessibleName = ariaLabel || label;
const compact = iconOnly && !card;
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={`whatsapp-cta ${card ? "cta-card" : ""} ${className}`.trim()}
  data-cta={cta}
  aria-label={compact ? accessibleName : undefined}
  title={compact ? accessibleName : undefined}
>
  {card && <span class="cta-card-badge">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M12.04 2.003c-5.523 0-10 4.477-10 10 0 1.76.462 3.48 1.34 4.997L2 22l5.16-1.352a9.958 9.958 0 0 0 4.878 1.257h.004c5.522 0 9.998-4.477 9.998-10 0-2.652-1.03-5.144-2.902-7.017a9.935 9.935 0 0 0-7.096-2.885Zm5.828 14.28c-.243.685-1.416 1.31-1.958 1.392-.5.076-1.132.108-1.828-.115-.421-.135-.962-.313-1.658-.612-2.918-1.26-4.824-4.204-4.97-4.4-.145-.194-1.187-1.58-1.187-3.014 0-1.434.752-2.14 1.02-2.433.243-.267.53-.334.706-.334.177 0 .353.002.507.01.163.008.382-.062.598.457.243.588.826 2.028.9 2.176.073.147.121.32.024.514-.098.194-.147.315-.29.485-.146.17-.307.38-.438.51-.146.146-.298.304-.128.6.17.297.756 1.246 1.622 2.018 1.114.994 2.054 1.303 2.35 1.45.298.146.472.122.646-.073.174-.196.746-.87.945-1.168.194-.298.39-.243.657-.146.267.098 1.696.8 1.988.945.291.146.485.219.556.34.073.122.073.706-.17 1.39Z"
      ></path>
    </svg>
  </span>}
  {card && <span class="cta-card-copy">
    <span class="cta-card-title">{label}</span>
    {sublabel && <span class="cta-card-sub">{sublabel}</span>}
  </span>}
  {card && <span class="cta-card-arrow" aria-hidden="true">→</span>}
  {!card && <svg
    class="whatsapp-cta-icon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M12.04 2.003c-5.523 0-10 4.477-10 10 0 1.76.462 3.48 1.34 4.997L2 22l5.16-1.352a9.958 9.958 0 0 0 4.878 1.257h.004c5.522 0 9.998-4.477 9.998-10 0-2.652-1.03-5.144-2.902-7.017a9.935 9.935 0 0 0-7.096-2.885Zm5.828 14.28c-.243.685-1.416 1.31-1.958 1.392-.5.076-1.132.108-1.828-.115-.421-.135-.962-.313-1.658-.612-2.918-1.26-4.824-4.204-4.97-4.4-.145-.194-1.187-1.58-1.187-3.014 0-1.434.752-2.14 1.02-2.433.243-.267.53-.334.706-.334.177 0 .353.002.507.01.163.008.382-.062.598.457.243.588.826 2.028.9 2.176.073.147.121.32.024.514-.098.194-.147.315-.29.485-.146.17-.307.38-.438.51-.146.146-.298.304-.128.6.17.297.756 1.246 1.622 2.018 1.114.994 2.054 1.303 2.35 1.45.298.146.472.122.646-.073.174-.196.746-.87.945-1.168.194-.298.39-.243.657-.146.267.098 1.696.8 1.988.945.291.146.485.219.556.34.073.122.073.706-.17 1.39Z"
    ></path>
  </svg>}
  {!card && !iconOnly && <span class="whatsapp-cta-label">{label}</span>}
</a>

<style>
  .whatsapp-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .whatsapp-cta-icon {
    flex-shrink: 0;
  }
  .whatsapp-cta-label {
    font-weight: 600;
  }

  /* Default look for the `card` variant, the site's card/CTA vocabulary
     (surface, radius, hover lift) so this component is self-styled wherever
     it's dropped. StickyBookCta.astro layers a dark-context override on top
     via a more specific descendant selector when it renders this inside its
     own bar. */
  .cta-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--v9-line);
    border-radius: var(--v9-radius-small);
    background: var(--v9-white);
    color: var(--v9-ink);
    text-align: left;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }
  .cta-card:hover,
  .cta-card:focus-visible {
    border-color: color-mix(in srgb, var(--v9-violet) 38%, transparent);
    box-shadow: var(--v9-shadow);
    transform: translateY(-2px);
    outline: none;
  }
  .cta-card-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--v9-violet) 12%, transparent);
    color: var(--v9-violet-deep);
  }
  .cta-card-badge svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .cta-card-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .cta-card-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--v9-ink);
  }
  .cta-card-sub {
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--v9-copy);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .cta-card-arrow {
    margin-left: auto;
    padding-left: 0.35rem;
    font-size: 0.85rem;
    color: var(--v9-copy);
    transition: transform 160ms ease, color 160ms ease;
  }
  .cta-card:hover .cta-card-arrow,
  .cta-card:focus-visible .cta-card-arrow {
    transform: translateX(2px);
    color: var(--v9-violet-deep);
  }
</style>
