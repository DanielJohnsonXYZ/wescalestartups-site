---
import GrowthToolPage from "../../components/GrowthToolPage.astro";
import { growthTools } from "../../data/growthTools";

export function getStaticPaths() {
  return growthTools.map((tool) => ({
    params: { tool: tool.slug },
    props: tool
  }));
}

const tool = Astro.props;
---

<GrowthToolPage {...tool} />
