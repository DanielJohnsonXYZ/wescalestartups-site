---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../lib/schema";
import { methodologyBrand, strategicPageRelatedInsights, siteConfig } from "../site";

const gosFaqs = [
  {
    question: "What is a growth operating system?",
    answer:
      "A growth operating system is a repeatable structure for making acquisition decisions. It has four parts: a named growth constraint, a channel and experiment plan built around that constraint, a fixed weekly rhythm where evidence becomes a scale/stop/fix decision, and transfer artefacts that let the system run without one person holding it in their head. It is a way of working, not a piece of software."
  },
  {
    question: "Is a growth operating system the same as a growth tool or dashboard?",
    answer:
      "No. Analytics platforms, attribution software and CRM automation can support a growth operating system, but buying a tool does not create one. The system is the decision structure and the rhythm; the tool is only where you store the evidence. Several products now use “Growth OS” in their name, which is a category label, not the discipline."
  },
  {
    question: "Growth operating system vs a marketing agency retainer: what is the difference?",
    answer:
      "An agency retainer buys execution capacity. A growth operating system is the decision layer that tells whoever executes — agency, in-house team or founder — what to test next and why. Agencies can work inside a growth operating system; they rarely arrive with one, because that is not what the retainer is priced for. If you already know the channel and just need hands, an agency is the right buy."
  },
  {
    question: "Do we need a growth operating system yet?",
    answer:
      "The trigger is channel count, not revenue or headcount. If you run one channel well, can name your constraint in a sentence and hold a standing weekly decision, you likely already have one. If three or more channels are running, nobody agrees which is working, and every growth conversation restarts from scratch, you are overdue."
  },
  {
    question: "How does We Scale Startups build one?",
    answer:
      "In four phases: diagnosis of the constraint across positioning, acquisition, conversion, reporting and team ownership; design of the acquisition system; build and execution against a weekly decision cadence; then transfer of the playbooks, dashboards and rhythm so the system runs without us. Most engagements start with a Growth Diagnosis or a 90-Day Growth Sprint."
  }
];

const pageSchema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Growth operating system", path: "/growth-operating-system" }
  ]),
  buildFaqSchema(gosFaqs)
];

const systemComponents = [
  {
    phase: "Diagnosis",
    icon: "🔍",
    description: "Bottleneck constraint mapping across five layers: positioning, acquisition, conversion, reporting, team ownership."
  },
  {
    phase: "Design",
    icon: "📐",
    description: "Acquisition system architecture: channel strategy, offer map, landing briefs, and reporting cadence."
  },
  {
    phase: "Build",
    icon: "🔧",
    description: "Channel execution, campaign logs, experiment backlog, and weekly decision rules."
  },
  {
    phase: "Transfer",
    icon: "📋",
    description: "Playbooks, dashboards, handoff packs, and weekly rhythm that runs without founder involvement."
  }
];
---

<BaseLayout
  path="/growth-operating-system"
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "Growth operating system", path: "/growth-operating-system" }
  ]}
  title="Growth Operating System | We Scale Startups"
  description="A growth operating system is a repeatable structure for acquisition decisions: a named constraint, a channel plan, a weekly rhythm, transfer artefacts."
  keywords="growth operating system, startup growth system, fractional CMO, acquisition system, post-PMF growth, B2B SaaS growth"
  schema={pageSchema}
  lastUpdated={siteConfig.lastUpdated}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Cornerstone</p>
      <h1>Growth operating system.</h1>
      <div class="hero-support">
        <p class="lede">
          <strong>A growth operating system is a repeatable structure for making acquisition decisions.</strong> Four parts: a named growth constraint, a channel and experiment plan built around it, a fixed weekly rhythm where evidence becomes a scale/stop/fix decision, and transfer artefacts so the system survives any one person leaving. It is a way of working, not software.
        </p>
        <p class="lede">
          The <strong>{methodologyBrand.shortName}</strong> is the WSS version of that structure for post-PMF teams: diagnose the bottleneck, build the acquisition engine, and transfer the weekly rhythm, so growth stops depending on founder heroics. For the full definition and a five-question test for whether you need one yet, read <a href="/insights/what-is-a-growth-operating-system">what a growth operating system actually is</a>.
        </p>
        <div class="hero-actions">
          <a
            class="button button-brand button-with-subcopy"
            href={siteConfig.bookingUrl}
            data-cta="gos-book"
            title={siteConfig.bookingCallReassurance}
          >
            <span class="button-label">{siteConfig.bookingLabel}</span>
            <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
          </a>
          <a class="button button-light" href="/services" data-cta="gos-services">See services →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="Why it matters" title="Post-PMF startups usually die in the middle." />
      <p class="lede" style="max-width: 60ch; margin-top: 0.5rem;">
        You have traction. But pipeline arrives in bursts. The founder is still the best salesperson. Channels are running in isolation. Nobody can confidently say what's working.
      </p>
      <div class="grid-2" style="margin-top: 2rem;">
        <article class="feature-card">
          <h3>The problem</h3>
          <p>Founder dependency, disconnected channels, no shared acquisition narrative, reporting that tracks activity instead of outcomes.</p>
        </article>
        <article class="feature-card">
          <h3>The system solution</h3>
          <p>One coherent operating system: diagnosis → design → build → transfer. Not a deck, a working growth function.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="Four phases" title="How the system is built." />
      <div class="decision-grid" style="margin-top: 2rem;">
        {systemComponents.map((item) => (
          <article class="decision-card">
            <span class="decision-num">{item.icon}</span>
            <h3>{item.phase}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="What you get" title="Working artefacts, not slide decks." />
      <ul class="related-insights-list" style="margin-top: 1.5rem;">
        <li><a class="card-link" href="/diagnose">5-layer diagnostic framework</a>, names the constraint in plain English</li>
        <li><a class="card-link" href="/ai-growth-systems">AI growth systems</a>, narrow, repeatable workflows tied to revenue activity</li>
        <li><a class="card-link" href="/services/acquisition-system-build">Acquisition system build</a>, channels, offers, landing pages, reporting</li>
        <li><a class="card-link" href="/how-it-works">Transfer playbooks</a>, handoff packs your team can run without you</li>
        <li><a class="card-link" href="/first-30-days">First 30 days</a>, what happens when WSS joins the team</li>
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="Who this is for" title="Post-PMF B2B SaaS and AI startups." />
      <div class="grid-3" style="margin-top: 2rem;">
        <article class="feature-card">
          <h3>Seed to Series A</h3>
          <p>Founder still owns every revenue call. Pipeline is inconsistent. Need to professionalise acquisition.</p>
        </article>
        <article class="feature-card">
          <h3>Series B+</h3>
          <p>Growing team but no shared growth operating rhythm. Channels sprawling. Need system before full-time CMO.</p>
        </article>
        <article class="feature-card">
          <h3>AI-native startups</h3>
          <p>Great product, unclear GTM. Need to separate AI hype from commercial acquisition reality.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="FAQ" title="What founders ask about growth operating systems." />
      <div class="grid-2" style="margin-top: 2rem;">
        {gosFaqs.map((item) => (
          <article class="feature-card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="Related reading" title="Deeper context on the system." />
      <ul class="related-insights-list" style="margin-top: 1.5rem;">
        {strategicPageRelatedInsights["/growth-operating-system"]?.map((item) => (
          <li><a class="card-link" href={item.href}>{item.label} →</a></li>
        ))}
        <li><a class="card-link" href="/insights/acquisition-system-beats-channel-sprawl">Acquisition system vs channel sprawl →</a></li>
        <li><a class="card-link" href="/insights/diagnose-growth-bottleneck-before-spend">Diagnose the bottleneck before spend →</a></li>
        <li><a class="card-link" href="/ai-growth-systems">AI growth systems pillar →</a></li>
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Build the system</p>
        <h2>Stop guessing. Start operating.</h2>
        <p>Diagnose the bottleneck, build the acquisition system, transfer the weekly rhythm.</p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="gos-final-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="link-arrow" href={siteConfig.scorecardUrl} data-cta="gos-final-scorecard">
          Or, {siteConfig.scorecardLabel} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .decision-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .decision-grid { grid-template-columns: repeat(4, 1fr); }
  }
  /* Border/radius/background and the hover lift come from the shared card
     contract in site-v9.css. */
  .decision-card {
    padding: 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .decision-num {
    font-size: 1.5rem;
    line-height: 1;
  }
  .decision-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--ink);
  }
  .decision-card p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
</style>
