---
import SectionIntro from "../../components/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../../lib/schema";
import { leadMagnets, resourcesRelatedReading, siteConfig } from "../../site";

const resourcesFaqs = [
  {
    question: "Are these resources really free?",
    answer:
      "Yes. They exist to help founders self-diagnose and brief agencies or operators with clearer context. Downloads are instant; newsletter signup is optional."
  },
  {
    question: "Do resources replace an engagement?",
    answer:
      "No. They sharpen the question. If the bottleneck is still unclear after the scorecard or guides, diagnosis or a sprint is usually the next step."
  },
  {
    question: "How do I get a specific guide?",
    answer:
      "Open the resource page and download the markdown template, or use the download button on each card below."
  }
];

const resourcesSchema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Resources", path: "/resources" }
  ]),
  buildFaqSchema(resourcesFaqs)
];

const guides = [
  {
    id: "growth-bottleneck-scorecard",
    title: "Growth Bottleneck Scorecard",
    format: "Founder checklist",
    bestFor: "Post-PMF teams with activity but unclear priorities",
    sections: [
      "ICP clarity",
      "Channel signal",
      "Landing page conversion",
      "Founder-led sales dependency",
      "Reporting and decision cadence"
    ]
  },
  {
    id: "90-day-growth-sprint-planner",
    title: "90-Day Growth Sprint Planner",
    format: "Sprint planning worksheet",
    bestFor: "Leadership teams preparing a quarter of focused growth work",
    sections: [
      "Diagnosis inputs",
      "Experiment backlog",
      "Decision rules",
      "Weekly review rhythm",
      "Transfer checklist"
    ]
  },
  {
    id: "vc-portfolio-growth-diagnosis",
    title: "VC Portfolio Growth Diagnosis Template",
    format: "Portfolio workshop guide",
    bestFor: "Investors, accelerators, and venture studios supporting founder growth decisions",
    sections: [
      "Founder bottleneck prompts",
      "Channel and conversion questions",
      "Board-ready next steps",
      "Referral routes",
      "Sprint or fractional CMO fit"
    ]
  }
];

const guideIds = new Set(guides.map((g) => g.id));
const moreMagnets = leadMagnets.filter((m) => !guideIds.has(m.id));
const diagnosticTools = [
  {
    href: "/founder-led-growth-bottleneck-map",
    title: "Founder-Led Growth Bottleneck Map",
    audience: "Founder dependency",
    description: "Map how much of the GTM system still lives in the founder's head."
  },
  {
    href: "/ai-sameness-scorecard",
    title: "AI Sameness Scorecard",
    audience: "AI positioning",
    description: "Test whether your category, promise, and proof sound distinct enough to buy."
  },
  {
    href: "/hiring-readiness-scorecard",
    title: "Hiring Readiness Scorecard",
    audience: "First senior hire",
    description: "Check whether a Head of Marketing would inherit a working system or a mess."
  },
  {
    href: "/healthtech-buyer-confidence-matrix",
    title: "HealthTech Buyer Confidence Matrix",
    audience: "HealthTech",
    description: "Find where trust is breaking between product users and the economic buyer."
  },
  {
    href: "/portfolio-growth-readiness",
    title: "Portfolio Growth Readiness",
    audience: "Investors and M&A",
    description: "Assess commercial readiness across PE-backed and acquired businesses."
  }
] as const;
---

<BaseLayout
  title="Free Startup Growth Resources | We Scale Startups"
  description="Free growth diagnosis guides, sprint planners, and portfolio templates for post-PMF startups building repeatable growth systems."
  keywords="growth bottleneck scorecard, 90-day growth sprint, VC portfolio template, startup growth diagnosis, post-PMF GTM, fractional CMO resources"
  path="/resources"
  schema={resourcesSchema}
  lastUpdated={siteConfig.lastUpdated}
>
  <section class="page-hero resources-hero">
    <div class="shell resources-hero-layout">
      <div class="resources-hero-copy">
        <p class="eyebrow">Resources</p>
        <h1>Practical growth guides for teams between <em>traction and scale.</em></h1>
        <p>
          Diagnose the real constraint, make the next decision, and brief your team with more clarity. No generic playbooks and no decorative PDF funnel.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#guides" data-cta="resources-browse">
            Browse the resource library ↓
          </a>
          <a class="button button-light" href="/proof" data-cta="resources-proof">See the work →</a>
        </div>
      </div>

      <aside class="resource-router" aria-labelledby="resource-router-title">
        <div class="resource-router-head">
          <div>
            <span class="resource-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>WSS / Starting point</span>
          </div>
          <span class="resource-router-status"><i aria-hidden="true"></i> Free</span>
        </div>
        <div class="resource-router-body">
          <p class="resource-router-label">Not sure where to start?</p>
          <h2 id="resource-router-title">Find the bottleneck first.</h2>
          <p class="resource-router-copy">
            Score positioning, acquisition, conversion, reporting, and founder dependency before you add more activity.
          </p>
          <div class="resource-router-metrics" aria-label="Scorecard details">
            <span><strong>10</strong> questions</span>
            <span><strong>5</strong> minutes</span>
            <span><strong>£0</strong> cost</span>
          </div>
          <ol class="resource-router-steps">
            <li><span>01</span> Answer honestly</li>
            <li><span>02</span> See the constraint</li>
            <li><span>03</span> Get the next move</li>
          </ol>
          <a class="button resource-router-cta" href={siteConfig.scorecardUrl} data-cta="resources-scorecard">
            Take the Growth Bottleneck Scorecard <span aria-hidden="true">↗</span>
          </a>
          <p class="resource-router-note">No email required to see your result.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" id="guides">
    <div class="shell">
      <SectionIntro
        eyebrow="Guides & templates"
        title="Start with the tool that matches the decision."
        body="Read every outline on-page, then download the working guide or template when you need it. Each resource explains who it is for, what is inside, and how to use it."
      />
      <div class="grid-3">
        {guides.map((guide) => (
          <article class="feature-card" id={guide.id}>
            <p class="card-kicker">{guide.format}</p>
            <h3>{guide.title}</h3>
            <p><strong>Best for:</strong> {guide.bestFor}</p>
            <ul>
              {guide.sections.map((item) => <li>{item}</li>)}
            </ul>
            <p class="resource-outline-link">
              <a
                class="card-link"
                href={`/resources/${guide.id}`}
                data-cta={`resources-outline-${guide.id}`}
              >
                Open full resource page →
              </a>
            </p>
            {leadMagnets.find((m) => m.id === guide.id)?.downloadPath ? (
              <a
                class="button button-light"
                href={leadMagnets.find((m) => m.id === guide.id)!.downloadPath}
                download
                data-cta={`resources-download-${guide.id}`}
              >
                Download the guide
              </a>
            ) : (
              <a class="button button-light" href={`/resources/${guide.id}`} data-cta={`resources-open-${guide.id}`}>
                Open the guide
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {
    moreMagnets.length > 0 && (
      <section class="section section-alt">
        <div class="shell">
          <SectionIntro
            eyebrow="More templates"
            title="Additional worksheets and checklists."
            body="Each opens as a full resource page with outline, FAQ, and instant download."
          />
          <div class="grid-3">
            {moreMagnets.map((m) => (
              <article class="feature-card">
                <p class="card-kicker">{m.audience}</p>
                <h3>
                  <a href={m.href}>{m.title}</a>
                </h3>
                <p>{m.description}</p>
                <a class="card-link" href={m.href}>
                  Open resource page →
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Interactive diagnostics"
        title="Use the scorecard for the decision in front of you."
        body="Each tool gives an immediate result and a practical next move. No email is required to see the diagnosis."
      />
      <div class="grid-3">
        {diagnosticTools.map((tool) => (
          <article class="feature-card">
            <p class="card-kicker">{tool.audience}</p>
            <h3><a href={tool.href}>{tool.title}</a></h3>
            <p>{tool.description}</p>
            <a class="card-link" href={tool.href}>Run the diagnostic →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Board &amp; dashboard</p>
      <h2>Standalone templates.</h2>
      <div class="grid-3">
        <article class="feature-card">
          <p class="card-kicker">Leadership</p>
          <h3>
            <a href="/board-growth-report-template">Board growth report template</a>
          </h3>
          <p>What changed, what shipped, what to scale or stop, without vanity metrics.</p>
          <a class="card-link" href="/board-growth-report-template">
            View →
          </a>
        </article>
        <article class="feature-card">
          <p class="card-kicker">Measurement</p>
          <h3>
            <a href="/growth-dashboard-template">Growth dashboard template</a>
          </h3>
          <p>Weekly view tying pipeline to activity and decisions.</p>
          <a class="card-link" href="/growth-dashboard-template">
            View →
          </a>
        </article>
      </div>
    </div>
  </section>

      <section class="section section-alt">
        <div class="shell">
          <SectionIntro
            eyebrow="Deliverable examples"
            title="What the work looks like, before we tailor it to you."
            body="These are illustrative examples of the artefacts you take away: constraint maps, experiment cards, channel briefs, and weekly decision logs."
          />
          <div class="grid-3">
            <article class="feature-card">
              <p class="card-kicker">Constraint map</p>
              <h3>One-page diagnosis output</h3>
              <p>Positions the bottleneck across 5 dimensions, evidence table, and 90-day priority sequence. <a href="/proof#deliverables">See proof →</a></p>
            </article>
            <article class="feature-card">
              <p class="card-kicker">Experiment card</p>
              <h3>ICE-scored sprint backlog</h3>
              <p>Hypothesis, owner, success metric, and decision rule for every test. <a href="/diagnose">See diagnostic framework →</a></p>
            </article>
            <article class="feature-card">
              <p class="card-kicker">Channel brief</p>
              <h3>Campaign-ready acquisition brief</h3>
              <p>Audience, offer, landing page wireframe, and tracking spec for each channel. <a href="/services/acquisition-system-build">See acquisition build →</a></p>
            </article>
          </div>
        </div>
      </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Related reading</p>
      <h2>Frameworks, quizzes, and notes that pair with these guides.</h2>
      <ul class="related-insights-list">
        {resourcesRelatedReading.map((item) => (
          <li>
            <a class="card-link" href={item.href}>
              {item.label} →
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">FAQ</p>
      <h2>Using the resource hub.</h2>
      <div class="grid-3">
        {resourcesFaqs.map((item) => (
          <article class="feature-card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Need the diagnosis done with you?</p>
        <h2>Bring the current growth mess.</h2>
        <p>
          In {siteConfig.bookingCallDurationPhrase}, we will identify whether the constraint is positioning, acquisition, conversion, reporting, or senior leadership, no pitch unless there is a clear fit.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="resources-final-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="button button-light" href={siteConfig.scorecardUrl} data-cta="resources-final-scorecard">
          Or, {siteConfig.scorecardLabel} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resources-hero {
    padding-block: clamp(4.25rem, 7vw, 6.75rem);
  }

  .resources-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 6.75rem);
  }

  .resources-hero-copy {
    min-width: 0;
  }

  .resources-hero .resources-hero-copy h1 {
    max-width: 13ch;
    font-size: clamp(3.05rem, 5.1vw, 5.25rem);
  }

  .resources-hero .resources-hero-copy > p:not(.eyebrow) {
    max-width: 54ch;
  }

  .resource-router {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1.15rem;
    background:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      #16151d;
    background-size: 32px 32px, 32px 32px, auto;
    box-shadow: 0 30px 80px rgba(27, 23, 52, 0.22);
    color: #fff;
  }

  .resource-router-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.62);
    font-family: var(--v9-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resource-router-head > div,
  .resource-router-status {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .resource-window-dots {
    display: inline-flex;
    gap: 0.28rem;
  }

  .resource-window-dots i,
  .resource-router-status i {
    display: block;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
  }

  .resource-window-dots i:first-child {
    background: #ff887a;
  }

  .resource-window-dots i:nth-child(2) {
    background: #ffc86b;
  }

  .resource-window-dots i:last-child,
  .resource-router-status i {
    background: var(--v9-mint);
    box-shadow: 0 0 12px rgba(200, 255, 101, 0.55);
  }

  .resource-router-body {
    padding: clamp(1.5rem, 3.5vw, 2.35rem);
  }

  .resources-hero .resource-router-label {
    margin: 0 0 0.65rem;
    color: var(--v9-mint);
    font-family: var(--v9-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .resources-hero .resource-router h2 {
    max-width: 12ch;
    margin: 0;
    color: #fff;
    font-family: var(--v9-sans);
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    font-weight: 640;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .resources-hero .resource-router-copy {
    margin: 1rem 0 1.4rem;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .resource-router-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 1.35rem;
    border-block: 1px solid rgba(255, 255, 255, 0.12);
  }

  .resource-router-metrics span {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 0.75rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--v9-mono);
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .resource-router-metrics span:first-child {
    padding-left: 0;
  }

  .resource-router-metrics span:last-child {
    border-right: 0;
  }

  .resource-router-metrics strong {
    color: #fff;
    font-family: var(--v9-sans);
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }

  .resource-router-steps {
    display: grid;
    gap: 0.55rem;
    margin: 0 0 1.45rem;
    padding: 0;
    list-style: none;
  }

  .resource-router-steps li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.82rem;
  }

  .resource-router-steps span {
    color: var(--v9-violet-bright);
    font-family: var(--v9-mono);
    font-size: 0.62rem;
  }

  .resources-hero .resource-router-cta {
    display: flex;
    justify-content: space-between;
    width: 100%;
    min-height: 50px;
    padding: 0.9rem 1rem;
    border: 1px solid var(--v9-violet);
    border-radius: 999px;
    background: linear-gradient(135deg, var(--v9-violet-deep), var(--v9-violet));
    color: #fff;
    font-size: 0.77rem;
    box-shadow: 0 16px 36px rgba(77, 63, 196, 0.28);
  }

  .resources-hero .resource-router-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 44px rgba(77, 63, 196, 0.36);
  }

  .resources-hero .resource-router-note {
    margin: 0.75rem 0 0;
    color: rgba(255, 255, 255, 0.44);
    font-family: var(--v9-mono);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }

  .resource-outline-link {
    margin: 0.5rem 0 0.75rem;
    font-size: 0.9rem;
  }

  @media (max-width: 1000px) {
    .resources-hero-layout {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .resource-router {
      width: min(100%, 640px);
    }
  }

  @media (max-width: 620px) {
    .resources-hero {
      padding-block: 3.5rem;
    }

    .resources-hero .resources-hero-copy h1 {
      font-size: clamp(2.8rem, 14vw, 3.65rem);
    }

    .resource-router-head > div > span:last-child {
      display: none;
    }

    .resource-router-body {
      padding: 1.35rem;
    }

    .resource-router-metrics span {
      padding-inline: 0.5rem;
    }

    .resources-hero .resource-router-cta {
      font-size: 0.7rem;
    }
  }
</style>
