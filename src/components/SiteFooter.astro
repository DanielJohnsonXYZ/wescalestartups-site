---
// SiteFooter.astro, restructured into 5 clean groups:
// Work with us · Proof · Resources · Company · Legal
import EmailSignup from "./EmailSignup.astro";
import { siteConfig } from "../site";

interface Props {
  /** When false, hide the secondary scorecard CTA in the brand column. */
  showScorecardCta?: boolean;
  /** When false, hide the newsletter signup block. */
  showNewsletter?: boolean;
}

const { showScorecardCta = true, showNewsletter = true } = Astro.props;

const groups = [
  {
    label: "Work with us",
    links: [
      { href: "/services/growth-diagnosis", label: "Growth Diagnosis" },
      { href: "/services/90-day-growth-sprint", label: "90-Day Growth Sprint" },
      { href: "/services/acquisition-system-build", label: "Acquisition System Build" },
      { href: "/services/fractional-cmo", label: "Fractional CMO" },
      { href: "/ai-growth-audit", label: "AI Growth Audit" },
      { href: "/pricing", label: "Pricing" },
      { href: "/contact", label: "Contact" }
    ]
  },
  {
    label: "Results",
    links: [
      { href: "/proof", label: "All results" },
      { href: "/case-studies", label: "Case studies" },
      { href: "/testimonials", label: "Testimonials" },
      { href: "/industries", label: "Industries we serve" },
      { href: "/fractional-cmo-vs-agency", label: "WSS vs agency" }
    ]
  },
  {
    label: "Resources",
    links: [
      { href: "/start-here", label: "Start here" },
      { href: siteConfig.scorecardUrl, label: siteConfig.scorecardName },
      { href: "/post-raise", label: "Just raised? Read this" },
      { href: "/resources", label: "All resources & templates" },
      { href: "/growth-operating-system", label: "Growth Operating System" },
      { href: "/growth-course", label: "Free growth course" },
      { href: "/newsletter", label: siteConfig.newsletterName },
      { href: "/insights", label: "Insights" },
      { href: "/gtm-strategy", label: "GTM Strategy Guide" },
...(siteConfig.podcastLive ? [{ href: "/podcast", label: "Luck Doesn't Scale" }] : [])
    ]
  },
  {
    label: "Company",
    links: [
      { href: "/about", label: "About WSS" },
      { href: "/team", label: "Team" },
      { href: "/about/daniel", label: "About Daniel" },
      { href: "/facts/we-scale-startups", label: "Verified company facts" },
      { href: "/press", label: "Speaking & press" },
      { href: "/workshops", label: "Workshops" },
      { href: "/refer", label: "Refer a founder" },
      { href: siteConfig.linkedin, label: "LinkedIn", external: true }
    ]
  },
  {
    label: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" }
    ]
  }
];
---

<footer class="site-footer site-footer-v2">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src="/images/logos/wss-logo.webp" alt="We Scale Startups" width="128" height="72" loading="lazy" decoding="async" />
      <p class="footer-summary">
        We build the growth infrastructure AI startups and B2B SaaS teams need to hit the KPI that matters: customer research, experimentation and a testing rhythm your team owns, built from first principles.
      </p>
      <p class="footer-brand-arch">
        <strong>Brand note:</strong> This is the We Scale Startups commercial site (services, proof, systems). Daniel&apos;s personal brand, speaking, writing, media, lives at{" "}
        <a href={siteConfig.danielSite} rel="noopener" target="_blank">danieljohnson.xyz</a>.
      </p>
      <a
        class="button button-brand"
        href="/contact"
        data-cta="footer-contact"
        title="Contact We Scale Startups"
      >
        Contact →
      </a>
      <p class="footer-book-reassurance">Tell us where you are: stage, traction, the KPI you care about. We reply with the clearest next step, even if that step is not us.</p>
      {showScorecardCta && (
        <p class="footer-secondary-cta">
          Or, <a href={siteConfig.scorecardUrl}>{siteConfig.scorecardLabel} →</a>
        </p>
      )}
    </div>

    {groups.map((group) => (
      <div class="footer-col">
        <h3>{group.label}</h3>
        <nav class="footer-links" aria-label={`${group.label} links`}>
          {group.links.map((link) => (
            <a
              href={link.href}
              {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    ))}

    {showNewsletter && (
      <div class="footer-newsletter" aria-label="Newsletter signup">
        <EmailSignup
          variant="light"
          formId="footer-newsletter"
          heading={siteConfig.newsletterName}
          subtext={`${siteConfig.newsletterDescription} ${siteConfig.newsletterFrequencyLine}`}
        />
      </div>
    )}
  </div>

  <div class="shell footer-bottom">
    <p>© {new Date().getFullYear()} We Scale Startups. All rights reserved.</p>
    <p>{siteConfig.address}</p>
    <p class="founder-line">
      Founded by <a href="/about#daniel">{siteConfig.founderName}</a> ·
      <a href={siteConfig.danielSite} rel="noopener" target="_blank">danieljohnson.xyz</a>
    </p>
  </div>
</footer>

<style>
  .site-footer-v2 { padding-top: 4rem; padding-bottom: 2rem; }
  /* Two columns of links on small screens rather than one. Stacked single-file
     the six groups ran to ~2000px, which made the footer around 30% of the
     whole page on shorter routes. The brand and newsletter blocks stay full
     width since their content needs the measure. */
  .site-footer-v2 .footer-grid {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    margin-bottom: 3rem;
  }

  .site-footer-v2 .footer-brand,
  .site-footer-v2 .footer-newsletter {
    grid-column: 1 / -1;
  }
  @media (min-width: 720px) {
    .site-footer-v2 .footer-grid {
      gap: 2.5rem;
      grid-template-columns: repeat(3, 1fr);
    }
    /* The brand block is far taller than a link column; letting it span the
       row stops the remaining groups being pushed into a half-empty row. */
    .site-footer-v2 .footer-brand { grid-column: 1 / -1; }
  }
  @media (min-width: 1080px) {
    .site-footer-v2 .footer-grid {
      grid-template-columns: 1.6fr repeat(5, 1fr);
    }
    .site-footer-v2 .footer-brand { grid-column: auto; }
    /* align-items: start (set above) matters most here: stretched to the row
       height, a two-link group like Legal rendered as a 509px empty box. */
    .site-footer-v2 .footer-newsletter { grid-column: 1 / -1; }
  }

  .footer-brand p.footer-summary {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 1rem 0 1.25rem;
    max-width: 32ch;
  }
  .footer-brand-arch {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.55;
    margin: -0.5rem 0 1.25rem;
    max-width: 40ch;
  }
  .footer-brand-arch a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-book-reassurance {
    margin: 0.65rem 0 0;
    max-width: 42ch;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .footer-secondary-cta {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .footer-secondary-cta a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-newsletter {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .footer-newsletter :global(.email-signup-strip) {
    margin: 0;
    padding: 1.4rem 1.5rem;
  }
  .footer-newsletter :global(.email-signup-heading) {
    font-size: 1rem;
  }
  .footer-newsletter :global(.email-signup-sub) {
    font-size: 0.82rem;
  }

  .footer-col :is(h2, h3) {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--violet-deep);
    margin: 0 0 0.85rem;
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer-links a {
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .footer-links a:hover { color: var(--ink); }

  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .footer-bottom p { margin: 0; }
  .founder-line { margin-left: auto; }
  .founder-line a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .founder-line a:hover {
    border-bottom-color: var(--accent);
  }
</style>
