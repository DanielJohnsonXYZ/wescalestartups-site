---
import EmailSignup from "../../components/EmailSignup.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../../lib/schema";
import { growthTools } from "../../data/growthTools";
import { leadMagnets, siteConfig } from "../../site";

/**
 * Standalone landing page per lead magnet, replaces the buried anchor
 * fragments on /resources. Each /resources/{id} is now SEO-crawlable,
 * paid-ad-ready, and conversion-focused with one CTA.
 */

// Per-magnet content. Keys must match `id` in site.ts → leadMagnets.
const magnetDetails: Record<string, {
  format: string;
  bestFor: string;
  whatYouGet: string[];
  howToUse: string;
  whoItsNotFor: string;
  faq: Array<{ question: string; answer: string }>;
}> = {
  "growth-bottleneck-scorecard": {
    format: "Founder checklist · 10 questions · ~5 minutes",
    bestFor: "Post-PMF teams with marketing activity but unclear priorities",
    whatYouGet: [
      "Five-section diagnostic across ICP clarity, channel signal, landing-page conversion, founder-led sales dependency, and reporting cadence",
      "Scoring rubric so you can see where the constraint actually lives",
      "Founder-friendly language, no consultant jargon",
      "Built to be filled in by the founder in one sitting"
    ],
    howToUse:
      "Score each section honestly, usually one or two areas score noticeably worse than the rest. That's the bottleneck. Use the result to decide whether you need a 90-Day Growth Sprint, a fractional CMO engagement, or just a sharper plan you can run yourself.",
    whoItsNotFor:
      "Pre-revenue or pre-PMF teams. The scorecard assumes you have customers, traction, and the basic GTM mechanics in place.",
    faq: [
      {
        question: "Do I need to be a paying client to get the scorecard?",
        answer: "No. Use the interactive scorecard on this page, or download the printable companion. We use it as a diagnostic step before any engagement conversation."
      },
      {
        question: "What if my score is bad in every section?",
        answer: "Then the most likely truth is that you don't have a single bottleneck, you have foundational gaps. Book a Growth Diagnosis call and we'll work through which gap to close first."
      },
      {
        question: "Can I share the scorecard with my team?",
        answer: "Yes. Many founders run it as a 30-minute team exercise, each person scores independently, then you compare. Disagreement is information."
      }
    ]
  },
  "90-day-growth-sprint-planner": {
    format: "Editable Excel planner + 3-page field guide · 60 minutes to set up",
    bestFor: "Post-PMF startup teams that need a focused quarter of learning, not another channel list",
    whatYouGet: [
      "Start Here dashboard for one priority, baseline, target, and progress",
      "Experiment backlog with hypothesis prompts, ICE scoring, owners, metrics, and decision rules",
      "13-week plan with dates that update from your chosen quarter start",
      "Weekly review sheet built around keep, change, stop, or scale decisions",
      "Decision log that turns a quarter of activity into reusable growth judgement",
      "A concise PDF field guide with a worked B2B AI startup example"
    ],
    howToUse:
      "Block 60 minutes with the founder and growth owner. Set one measurable commercial priority, rank only the experiments the team can interpret, then protect a 30-minute Friday decision review for all 13 weeks.",
    whoItsNotFor:
      "Teams looking for a generic library of growth tactics. The planner is deliberately opinionated: one priority, a small experiment portfolio, and a decision every week.",
    faq: [
      {
        question: "What format is the planner?",
        answer: "You get an editable Excel workbook with five working sheets plus a three-page PDF field guide. The email sequence helps you install it over the following two weeks."
      },
      {
        question: "Do I have to use the full 90 days?",
        answer: "No. The structure works for shorter cycles, but 13 weeks is long enough to establish a baseline, run meaningful tests, and carry the learning into the next quarter."
      },
      {
        question: "What happens after I enter my email?",
        answer: "You are taken straight to both downloads and receive five practical emails over 16 days. The first delivers the files; the remaining four help you choose a priority, use a worked example, avoid common failure modes, and pressure-test the plan."
      }
