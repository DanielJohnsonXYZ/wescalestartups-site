---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { buildFaqSchema } from "../lib/schema";
import { absoluteUrl } from "../lib/utils";
import { siteConfig } from "../site";

const podcastFaqs = [
  {
    question: `What is ${siteConfig.podcastName} about?`,
    answer:
      "AI is rewriting the startup growth playbook. The show explores what that means in practice: which old growth assumptions are breaking, what AI makes possible, what remains uniquely human, and what startup leaders should do differently. Not another channel about AI tools or productivity hacks."
  },
  {
    question: "Who is the host?",
    answer:
      "Daniel Johnson, founder of We Scale Startups. Daniel works with post-PMF B2B SaaS and AI startups on growth strategy, experimentation, and practical AI adoption."
  },
  {
    question: "Where can I watch or listen?",
    answer: `Subscribe on YouTube at ${siteConfig.podcastYoutubeHandle}. Spotify and Apple Podcasts will go live with episode one. Join ${siteConfig.newsletterName} on this site if you want one email when the audio feed is ready.`
  },
  {
    question: "Can I apply to be a guest?",
    answer:
      "Yes. If you're a founder, marketer, investor, or operator with a practical perspective on how AI is changing growth, apply via the guest application page. We look for real examples, honest lessons, and useful takeaways."
  },
  {
    question: "How does this relate to WSS?",
    answer:
      "The podcast is part of how WSS shares practical thinking on AI and growth. Commercial work still runs through diagnosis and engagements on this site."
  }
];

const podcastSeriesSchema = siteConfig.podcastLive
  ? {
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      name: siteConfig.podcastName,
      description: siteConfig.podcastDescription,
      url: absoluteUrl("/podcast"),
      author: {
        "@type": "Organization",
        "@id": `${siteConfig.siteUrl}/#organization`
      },
      sameAs: [siteConfig.podcastYoutubeUrl, siteConfig.podcastYoutubeChannelUrl]
    }
  : null;

const podcastSchemas = [buildFaqSchema(podcastFaqs), ...(podcastSeriesSchema ? [podcastSeriesSchema] : [])];

/* The four themes are the show's spine, so they carry mono indices and read
   as a numbered ledger rather than four undifferentiated boxes. */
const showThemes = [
  {
    title: "Breaking assumptions",
    body: "Which old growth assumptions no longer hold when AI changes how companies build, sell, and compete."
  },
  {
    title: "What AI makes possible",
    body: "Practical shifts in products, customer understanding, content, decisions, and team structure."
  },
  {
    title: "What stays human",
    body: "Judgment, trust, taste, and the advantages that do not disappear when tools get cheaper."
  },
  {
    title: "What leaders do differently",
    body: "How founders and operators should adapt the growth playbook, without chasing every new tactic."
  }
];

/* Same three audiences and the same words that were hard-coded in the markup,
   split so the question can be set as the pulled quote it already is. */
const audiences = [
  {
    who: "Startup founders",
    thought: "AI changed the game, what should we actually do differently?"
  },
  {
    who: "Marketers & growth leaders",
    thought: "Which advantages are disappearing, and which ones are still ours?"
  },
  {
    who: "Investors & operators",
    thought: "What remains uniquely human when every team has the same tools?"
  }
];
---

<BaseLayout
  path="/podcast"
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "Podcast", path: "/podcast" }
  ]}
  title={`${siteConfig.podcastName} | We Scale Startups`}
  description={siteConfig.podcastDescription}
  keywords="Luck Doesn't Scale, startup podcast, AI growth, startup AI adoption, founder interviews, B2B SaaS podcast, growth playbook"
  schema={podcastSchemas}
  lastUpdated={siteConfig.lastUpdated}
  metaRobots={siteConfig.podcastLive ? "index,follow,max-image-preview:large" : "noindex,follow"}
>
  <!-- HERO -->
  <section class="page-hero podcast-hero">
    <div class="shell">
      <p class="eyebrow">Podcast</p>
      {/* Three-word title. Alone in the headline column it left the masthead
          lopsided, so the tagline runs under it as the deck — the same
          composition the service pages use. */}
      <div class="hero-headline">
        <h1>{siteConfig.podcastName}</h1>
        <p class="hero-deck">{siteConfig.podcastTagline}</p>
      </div>
      <div class="hero-support">
        <p class="lede">
          It is changing how companies build products, understand customers, create content, make decisions, structure teams and compete.
          {siteConfig.podcastName} explores what this means in practice, hosted by Daniel Johnson, founder of We Scale Startups.
        </p>
        <div class="hero-actions podcast-cta-group">
          <a
            class="button button-brand"
            href={siteConfig.podcastYoutubeUrl}
            target="_blank"
            rel="noopener"
            data-cta="podcast-youtube"
          >
            Subscribe on YouTube →
          </a>
          <a class="button button-light" href="/podcast-guest-application" data-cta="podcast-guest-page">
            Apply as a guest →
          </a>
        </div>
      </div>
      {/* The show has no published episodes yet. Rather than let the masthead
          imply a back catalogue, the rail states where it actually lives and
          what is still to come — the same facts the subscribe band and the FAQ
          already give, surfaced before the visitor has to scroll for them. */}
      <div class="hero-rail hero-rail-stack">
        <p class="hero-rail-label">Where the show lives</p>
        <div class="hero-ledger">
          <div class="hero-ledger-cell">
            <span class="hero-ledger-index">Host</span>
            <span class="hero-ledger-value">{siteConfig.founderName}</span>
            <span class="hero-ledger-label">Founder of We Scale Startups.</span>
          </div>
          <div class="hero-ledger-cell">
            <span class="hero-ledger-index">Watch</span>
            <span class="hero-ledger-value">{siteConfig.podcastYoutubeHandle}</span>
            <span class="hero-ledger-label">The YouTube channel is live.</span>
          </div>
          <div class="hero-ledger-cell">
            <span class="hero-ledger-index">Audio feeds</span>
            <span class="hero-ledger-value">With episode one</span>
            <span class="hero-ledger-label">Spotify and Apple Podcasts go live when the first episode ships.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SUBSCRIBE -->
  <section class="section section-alt podcast-subscribe">
    <div class="shell">
      <SectionIntro eyebrow="Watch &amp; follow" title="Subscribe on YouTube now. Audio directories follow with episode one." />
      <p class="lede">
        The channel is live at <strong>{siteConfig.podcastYoutubeHandle}</strong>. Spotify and Apple Podcasts will go live with episode one, we are not publishing placeholder directory URLs. Prefer email? Join <strong>{siteConfig.newsletterName}</strong> for one note when the feed is ready.
      </p>
      <div class="subscribe-buttons">
        <a
          class="subscribe-btn"
          href={siteConfig.podcastYoutubeUrl}
          target="_blank"
          rel="noopener"
          data-cta="podcast-youtube-card"
        >
          <strong>YouTube</strong>
          <span>{siteConfig.podcastYoutubeHandle} · subscribe for new episodes</span>
        </a>
        <a class="subscribe-btn" href="/newsletter" data-cta="podcast-newsletter">
          <strong>{siteConfig.newsletterName}</strong>
          <span>One email when the audio feed launches</span>
        </a>
        <a class="subscribe-btn" href="/podcast-guest-application" data-cta="podcast-guest-card">
          <strong>Guest application</strong>
          <span>Founders, marketers, investors, operators</span>
        </a>
      </div>
      {/* This was a whole section of its own — a SectionIntro and nothing
          else, announcing that there was nothing to show. It is one line of
          microcopy under the subscribe tiles now, which is the weight the
          fact deserves. */}
      <p class="podcast-episode-note">
        Each release will get a dedicated URL here with a summary, key takeaways, and links to the systems discussed.
      </p>
    </div>
  </section>

  <!-- WHAT THE SHOW IS -->
  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="What we examine"
        title="An ongoing investigation into how startup growth itself is changing."
        body="The show brings together founders, marketers, investors and operators. This is not another channel about AI tools or productivity hacks."
      />
      <div class="podcast-pillars">
        {showThemes.map((theme, index) => (
          <article class="pillar-card">
            <span class="pillar-num">{String(index + 1).padStart(2, "0")}</span>
            <h3>{theme.title}</h3>
            <p>{theme.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Audience"
        title="Built for people who run growth in ambitious startups."
        body="If you care about what still works, what is disappearing, and what the new playbook might look like, this show is for you."
      />
      {/* The three "Thinking: …" lines were already questions in quotation
          marks set as body copy. They are set as the pulled quotes they are,
          which gives the band a second typographic voice instead of a third
          row of identical grey paragraphs. */}
      <div class="audience-grid">
        {audiences.map((audience) => (
          <article class="audience-card">
            <h3>{audience.who}</h3>
            <p class="audience-thought-label">Thinking</p>
            {/* A <p>, not a <blockquote>: these are the questions the audience
                is assumed to be asking, not attributed quotations. */}
            <p class="audience-thought">{audience.thought}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GUEST CTA -->
  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Guest applications"
        title="Have a practical perspective on AI and growth?"
        body="If you're a founder, marketer, investor, or operator with honest lessons on how startup growth is changing, apply to be a guest."
      />
      <div class="hero-actions">
        <a class="button button-brand" href="/podcast-guest-application" data-cta="podcast-guest">
          Apply to be a guest →
        </a>
        <a class="button button-light" href="/press" data-cta="podcast-press">
          Press kit
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT THE HOST -->
  <section class="section">
    <div class="shell host-grid">
      <div class="host-photos" aria-label="Host photos">
        <figure class="host-photo">
          <picture>
            <source
              srcset="/images/daniel-headshot-640.webp 640w, /images/daniel-headshot-960.webp 960w"
              sizes="(max-width: 720px) 45vw, 140px"
              type="image/webp"
            />
            <img
              src="/images/daniel-headshot-640.webp"
              alt="Daniel Johnson, headshot"
              width="640"
              height="668"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
        <figure class="host-photo host-photo--context">
          <picture>
            <source
              srcset="/images/daniel-aircraft-640.webp 640w, /images/daniel-aircraft-960.webp 960w"
              sizes="(max-width: 720px) 45vw, 140px"
              type="image/webp"
            />
            <img
              src="/images/daniel-aircraft-640.webp"
              alt="Daniel Johnson, informal context photo"
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
      <div class="host-bio">
        <p class="eyebrow">Host</p>
        <h2>Daniel Johnson</h2>
        <p>
          Daniel is the founder of We Scale Startups, where he helps post-PMF B2B SaaS and AI startups build repeatable growth systems. He mentors founders through Google for Startups, Techstars, GrowthMentor and MentorCruise (479+ sessions, ★4.97/5 average).
        </p>
        <p>
          {siteConfig.podcastName} is where Daniel investigates how startup growth itself is changing: what still works, what is breaking, and what the new playbook might look like.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href={siteConfig.founderLinkedin} target="_blank" rel="noopener" data-cta="host-linkedin">
            Daniel on LinkedIn →
          </a>
          <a class="button button-light" href={siteConfig.danielSite} target="_blank" rel="noopener" data-cta="host-daniel-site">
            danieljohnson.xyz →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="FAQ" title="Common questions about the show." />
      <div class="grid-3">
        {podcastFaqs.map((faq) => (
          <article class="feature-card">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WSS COMMERCIAL CTA -->
  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Work with WSS</p>
        <h2>Turn AI advantage into a repeatable system.</h2>
        <p>
          The podcast explores what is changing. WSS builds the growth system so your team can run it without founder heroics.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="podcast-final-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="button button-light" href="/services" data-cta="podcast-services">
          Compare services →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* .podcast-tagline and .podcast-description are gone: the tagline is the
     shared .hero-deck now and the description is a plain .lede, so both
     inherit the interior-hero type scale instead of setting their own. */
  .podcast-cta-group {
    align-items: center;
  }

  /* Not .hero-microcopy: that recipe is uppercase mono at 0.72rem, built for
     three-word labels like "Free · 20 minutes · No pitch". A full sentence in
     it is close to unreadable. */
  .podcast-episode-note {
    max-width: 62ch;
    margin: 1.4rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .subscribe-buttons {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 2rem;
  }
  @media (min-width: 600px) {
    .subscribe-buttons { grid-template-columns: repeat(3, 1fr); }
  }
  /* The comment that used to sit here claimed the shared card contract in
     site-v9.css supplied border, radius, background and the hover lift. It
     does not: .subscribe-btn is not in that selector list, so these three
     tiles rendered as bare text on the paper-2 band — the page's primary
     subscribe affordances with no surface at all. The contract's own recipe
     is restated here rather than adding a class to a global list, because
     these are links, not cards, and only this page uses them. */
  .subscribe-btn {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--v9-radius);
    background: var(--surface);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset;
    text-decoration: none;
    color: var(--ink);
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }
  .subscribe-btn:hover {
    transform: translateY(-4px);
    border-color: rgba(128, 108, 255, 0.38);
    box-shadow: var(--v9-shadow);
  }
  /* The tile is the click target, so the arrow marks it as one without
     needing an icon set. */
  .subscribe-btn strong::after {
    content: " →";
    color: var(--accent);
  }
  .subscribe-btn strong {
    font-size: 1rem;
    color: var(--ink);
  }
  .subscribe-btn span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .podcast-pillars {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 2rem;
  }
  @media (min-width: 720px) {
    .podcast-pillars { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .podcast-pillars { grid-template-columns: repeat(4, 1fr); }
  }
  /* Border/radius/background come from the shared card contract in
     site-v9.css. */
  .pillar-card {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.35rem 1.25rem 1.5rem;
  }
  .pillar-num {
    font-family: var(--v9-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .pillar-card h3 {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    /* Was violet on white at 1rem/700, which read as four link headings. Ink
       here; the mono index above carries the accent. */
    color: var(--ink);
    margin: 0;
  }
  .pillar-card p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0.15rem 0 0;
  }

  .audience-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 2rem;
  }
  @media (min-width: 720px) {
    .audience-grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* Border, radius and background come from the shared card contract in
     site-v9.css, which already lists .audience-card; the local copies of
     those three properties only ever fought it (and pinned the radius one
     step smaller than every neighbouring card). */
  .audience-card {
    position: relative;
    padding: 1.35rem 1.25rem 1.5rem 1.6rem;
  }
  /* Mint as a fill, never as text: a 3px rule is the one place the palette's
     display green is legible on paper. */
  .audience-card::before {
    content: "";
    position: absolute;
    left: 0.75rem;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 3px;
    border-radius: 999px;
    background: var(--acid);
  }
  .audience-card h3 {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 0.6rem;
  }
  .audience-thought-label {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-family: var(--v9-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .audience-thought {
    margin: 0;
    color: var(--ink);
    font-family: var(--v9-display);
    font-size: 1.02rem;
    font-style: italic;
    font-weight: 440;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .audience-thought::before { content: "\201C"; }
  .audience-thought::after { content: "\201D"; }

  .host-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 720px) {
    .host-grid { grid-template-columns: minmax(200px, 280px) 1fr; }
  }
  .host-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    max-width: 300px;
    margin: 0 auto;
  }
  @media (min-width: 720px) {
    .host-photos {
      margin: 0;
      grid-template-columns: 1fr;
      max-width: 200px;
    }
  }
  .host-photo {
    margin: 0;
  }
  .host-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--v9-radius);
    border: 1px solid var(--line);
    display: block;
  }
  .host-photo--context img {
    aspect-ratio: 1 / 1;
    object-position: center 35%;
  }
  .host-bio p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .host-bio .hero-actions {
    margin-top: 1rem;
  }
</style>
