      <p class="reveal" data-d="1">Bring your current growth picture. You'll leave with your bottleneck named in plain English, and an honest read on whether we're the right call.</p>
      <a href={siteConfig.bookingUrl} class="btn-primary reveal" data-d="2">{siteConfig.bookingLabel} <span>→</span></a>
    </div>
  </section>

  <script is:inline>
    // =========== Scroll-reveal ===========
    (function(){
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { els.forEach(e => e.classList.add('in')); return; }
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      els.forEach(e => io.observe(e));
    })();

    // =========== Pointer-tracked glow on cards ===========
    (function(){
      if (window.matchMedia('(hover: none)').matches) return;
      document.querySelectorAll('.glow-card').forEach(card => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
          card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
        });
      });
    })();

    // =========== Growth Bottleneck Check, 3-question teaser ===========
    (function(){
      const card = document.getElementById('mini-check');
      if (!card) return;
      const questions = card.querySelectorAll('.mc-q');
      const total = questions.length;
      const verdicts = {
        loop: 'The growth loop still runs through you. The system, not another hire, is the fix.',
        acquisition: 'Acquisition is carried by one engine. Diversify before the dip.',
        customer: 'The customer picture is running on assumption, not evidence. Start there.',
        healthy: 'No obvious red flag. Run the full scorecard to pressure-test all five layers.'
      };
      const answers = {};
      function finish() {
        const firstNo = ['customer', 'acquisition', 'loop'].find(k => answers[k] === 'no');
        document.getElementById('mc-verdict-text').textContent = verdicts[firstNo || 'healthy'];
        document.getElementById('mc-verdict').hidden = false;
        document.getElementById('mc-cta').hidden = false;
        document.getElementById('mc-progress').textContent = 'First read below';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'home_scorecard_hook_select', constraint: firstNo || 'healthy' });
      }
      questions.forEach(q => {
        q.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', () => {
            answers[q.dataset.q] = btn.dataset.a;
            q.querySelectorAll('button').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            const done = Object.keys(answers).length;
            document.getElementById('mc-progress').textContent = done + ' of ' + total + ' answered';
            if (done === total) finish();
          });
        });
      });
    })();

    // =========== Find-your-bottleneck interactive ===========
    (function(){
      const data = {
        customer: { meta: '01 · CUSTOMER', title: 'The ICP is too broad to convert.', desc: 'Narrowing is growth. We define exactly who this is for, who it is not for, and gather the customer evidence that proves it.', svc: 'Growth Diagnosis', meta2: 'from £2k · 1 week · Best starting point', link: '/services/growth-diagnosis' },
        positioning: { meta: '02 · OFFER & POSITIONING', title: 'Your story lands in the room. Not in the market.', desc: 'The offer and message get rebuilt against your customer\'s real alternatives, then tested live with a pre-set threshold.', svc: '90-Day Growth Sprint', meta2: 'from £8k · 12 weeks · Best for fast signal', link: '/services/90-day-growth-sprint' },
        acquisition: { meta: '03 · ACQUISITION', title: 'One channel carries the funnel.', desc: 'Diversify before the dip: design the second engine and the weekly decision rule that scales it.', svc: 'Acquisition System Build', meta2: 'from £15k · 8–12 weeks · Flagship', link: '/services/acquisition-system-build' },
        evidence: { meta: '04 · EXPERIMENTS & EVIDENCE', title: 'Decisions run on opinion, not evidence.', desc: 'Every test gets a hypothesis, a threshold, and a kill criterion. One weekly decision view your team owns: scale, stop, or fix.', svc: 'Acquisition System Build', meta2: 'from £15k · 8–12 weeks · Flagship', link: '/services/acquisition-system-build' },
        team: { meta: '05 · GROWTH LOOP', title: 'Every campaign and brief routes through the founder.', desc: 'Senior judgement without a £150k hire. Embedded leadership that installs the loop, then transfers it to your team.', svc: 'Fractional CMO', meta2: 'from £5k/mo · 3-month min', link: '/services/fractional-cmo' }
      };
      const cards = document.querySelectorAll('.bf-card');
      function update(key) {
        const d = data[key];
        document.getElementById('bf-meta').textContent = d.meta;
        document.getElementById('bf-title').textContent = d.title;
        document.getElementById('bf-desc').textContent = d.desc;
        document.getElementById('bf-svc').textContent = d.svc;
        document.getElementById('bf-svc-meta').textContent = d.meta2;
        document.getElementById('bf-link').href = d.link;
        document.getElementById('bf-link').textContent = d.svc + ' →';
      }
      cards.forEach(c => {
        c.addEventListener('click', () => {
          cards.forEach(o => o.classList.remove('active'));
          c.classList.add('active');
          update(c.dataset.bn);
        });
      });
    })();
  </script>
</BaseLayout>
