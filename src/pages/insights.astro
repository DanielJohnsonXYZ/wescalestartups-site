---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../lib/schema";
import { formatDate, sortByOrder } from "../lib/utils";
import { insightsHubRelatedReading, insightsThemeGroups, siteConfig } from "../site";

const insights = sortByOrder(await getCollection("insights"));
const insightsById = new Map(insights.map((item) => [item.id, item]));

// These answer the queries this page actually ranks for. GSC 90d shows the hub
// absorbing provider-selection intent — "growth leader for post pmf startup"
// (28 imp, pos 9.3), "post pmf saas scaling" (30 @ 14.2), "best company for
// startup growth" — and answering it with a link list. State the provider
// answer plainly instead.
const insightsHubFaqs = [
  {
    question: "Who should a post-PMF startup hire to lead growth?",
    answer:
      "It depends on whether the gap is judgement or capacity. If you know which channel to run and need more hands, hire an agency or a senior individual contributor. If nobody can confidently say why pipeline arrives in waves, that is a judgement gap and adding execution makes it worse — that is the case for a fractional CMO. Hire a full-time VP of Growth once growth is predictable enough to hand one person a number, a budget and a team. We Scale Startups works the fractional and embedded way, for post-PMF B2B SaaS and AI companies at roughly £1M–£10M ARR, Seed to Series B."
  },
  {
    question: "What does a growth leader actually do for a post-PMF startup?",
    answer:
      "Names the constraint, sequences the work against it, and installs a weekly decision rhythm the team keeps afterwards — typically a Monday pipeline review, a mid-week experiment ship and a Friday scale/stop/fix call. What they do not do is execution: campaigns, content and channel work stay with your team or your agencies. The artefacts that outlast the engagement are a decision log, a pipeline dashboard and a hire profile."
  },
  {
    question: "What does We Scale Startups charge?",
    answer:
      "Growth Diagnosis from £2,000 (about a week), 90-Day Growth Sprint from £8,000 (12 weeks), Acquisition System Build from £15,000 (8–12 weeks), and Fractional CMO from £5,000/month with a three-month minimum. Published rates are on the pricing page; the ranges depend on channel mix, reporting depth and how much senior ownership the team needs."
  },
  {
    question: "Where should I start if I do not know my constraint?",
    answer:
      "The Growth Bottleneck Scorecard is free, takes about four minutes and names a primary constraint across positioning, acquisition, conversion, reporting and team ownership. Read the pillar that matches whatever it returns. If the constraint is political, cross-functional or expensive to get wrong, a diagnostic call is the faster honest check."
  }
];

const insightsSchema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Insights", path: "/insights" }
  ]),
  buildFaqSchema(insightsHubFaqs)
];
---

<BaseLayout
  path="/insights"
  title="Growth notes for post-PMF founders | We Scale Startups"
  description="WSS insights organised around diagnosis, acquisition systems, fractional CMO leadership, and AI/LLM visibility, not a generic marketing blog archive."
  keywords="fractional CMO, B2B SaaS growth, growth diagnosis, acquisition system, GTM strategy, startup marketing, founder-led growth, pipeline bottleneck, We Scale Startups"
  schema={insightsSchema}
  lastUpdated={siteConfig.lastUpdated}
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "Insights", path: "/insights" }
  ]}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Insights</p>
      <h1>Growth notes for founders between traction and scale.</h1>
      <div class="hero-support">
        <p class="lede">
          <strong>We Scale Startups is a London growth consultancy and fractional CMO practice for post-PMF B2B SaaS and AI companies, typically £1M–£10M ARR, Seed to Series B.</strong> These notes are the working material behind that: how to name the growth constraint, build the acquisition system around it, and hand the operating rhythm to your team. Four clusters — fractional CMO, GTM, AI-native marketing and growth diagnostics — each with a pillar and spokes. Pick a cluster below, or scroll for every published note.
        </p>
        <div class="hero-actions">
          <a
            class="button button-dark button-with-subcopy"
            href={siteConfig.bookingUrl}
            data-cta="insights-hero-book"
            title={siteConfig.bookingCallReassurance}
          >
            <span class="button-label">{siteConfig.bookingLabel}</span>
            <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
          </a>
          <a class="link-arrow" href={siteConfig.scorecardUrl} data-cta="insights-hero-scorecard">
            Or, {siteConfig.scorecardLabel} →
          </a>
          <a class="button button-light" href="/fractional-cmo-vs-agency" data-cta="insights-hero-vs-agency">WSS vs agency</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Content clusters"
        title="Four pillars with spokes, built for topical depth and internal links."
        body="Each cluster has a pillar page (the hub) and live spokes. More notes roll in until each cluster reaches 6–8 articles, all interlinked to the pillar and to relevant services."
      />
      <div class="insights-theme-grid">
        {insightsThemeGroups.map((theme) => {
          const pillar = insightsById.get(theme.pillarId);
          return (
            <article class="feature-card insights-theme-card">
              <h2>{theme.title}</h2>
              <p>{theme.description}</p>
              {pillar ? (
                <p class="insights-pillar-link">
                  <span class="insights-pillar-label">Pillar</span>
                  <a class="card-link" href={`/insights/${pillar.id}`}>
                    {pillar.data.title} →
                  </a>
                </p>
              ) : null}
              <ul class="insights-theme-links">
                {theme.spokeInsightIds.map((id) => {
                  const item = insightsById.get(id);
                  if (!item) return null;
                  return (
                    <li>
                      <a class="card-link" href={`/insights/${item.id}`}>
                        {item.data.title} →
                      </a>
                    </li>
                  );
                })}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Published notes"
        title="Start with the bottleneck, then choose the work."
        body="Each article is written to answer a real founder question, not to fill a blog archive."
      />
      <div class="grid-3">
        {insights.map((item) => (
          <article class="feature-card insight-card">
            <p class="card-kicker">{formatDate(item.data.publishedAt)}</p>
            <h2>{item.data.title}</h2>
            <p>{item.data.excerpt}</p>
            <div class="insight-tags">
              {item.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <a class="card-link" href={`/insights/${item.id}`}>Read the note →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro eyebrow="Related reading" title="Frameworks and proof that pair with these notes." />
      <ul class="related-insights-list">
        {insightsHubRelatedReading.map((item) => (
          <li>
            <a class="card-link" href={item.href}>
              {item.label} →
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="FAQ" title="How to use these notes." />
      <div class="grid-3">
        {insightsHubFaqs.map((item) => (
          <article class="feature-card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Apply this to your company</p>
        <h2>Diagnose the constraint before adding more activity.</h2>
        <p>
          Bring the current site, pipeline, campaigns, reporting, and team context. In {siteConfig.bookingCallDurationPhrase} we can usually decide which part of the system needs work first.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="insights-final-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="link-arrow" href={siteConfig.scorecardUrl} data-cta="insights-final-scorecard">
          Or, {siteConfig.scorecardLabel} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .insights-theme-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .insights-theme-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .insights-theme-card h2 {
    font-size: 1.08rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .insights-pillar-link {
    margin: 0.85rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .insights-pillar-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .insights-theme-links {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
</style>
