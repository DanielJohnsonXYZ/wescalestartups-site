---
// EmailSignup.astro — inline email capture; posts to Customer.io via /api/forms.
import { customerIoNewsletter, siteConfig } from "../site";

interface Props {
  heading?: string;
  subtext?: string;
  formId?: string;
  variant?: "light" | "dark";
  buttonLabel?: string;
  sourceType?: "newsletter" | "lead_magnet" | "contact_enquiry";
  sourcePage?: string;
  leadMagnet?: string;
  /** Customer.io form id (Integrations → Forms). Defaults to site newsletter form. */
  cioFormId?: string;
  finePrint?: string;
  /** Optional same-origin destination after a successful signup. */
  successRedirect?: string;
}

const {
  heading = siteConfig.newsletterName,
  subtext = `${siteConfig.newsletterDescription} ${siteConfig.newsletterFrequencyLine}`,
  formId = "email-signup",
  variant = "light",
  buttonLabel = "Get the note ->",
  sourceType = "newsletter",
  sourcePage = Astro.url.pathname,
  leadMagnet = "",
  cioFormId: cioFormIdProp,
  finePrint = "No spam. Unsubscribe any time.",
  successRedirect = ""
} = Astro.props;

const cioFormId = cioFormIdProp ?? customerIoNewsletter.formId;
const submitUrl = customerIoNewsletter.submitUrl;
const sourcePageValue = sourcePage || Astro.url.pathname;
const turnstileSiteKey =
  (typeof import.meta.env.PUBLIC_TURNSTILE_SITE_KEY === "string" &&
    import.meta.env.PUBLIC_TURNSTILE_SITE_KEY.trim()) ||
  "0x4AAAAAAEIhzoHuWLsynQnO";
const turnstileTheme = variant === "dark" ? "dark" : "light";
const turnstileCallbackSuffix = formId.replace(/[^a-zA-Z0-9_]/g, "_");
const turnstileErrorCallback = `wssTurnstileError_${turnstileCallbackSuffix}`;
const turnstileSuccessCallback = `wssTurnstileSuccess_${turnstileCallbackSuffix}`;
---


<script
  is:inline
  data-form-id={formId}
  data-error-handler={turnstileErrorCallback}
  data-success-handler={turnstileSuccessCallback}
>
  // Register before the widget appears so async Turnstile can always find its callbacks.
  (() => {
    const script = document.currentScript;
    const formId = script?.dataset.formId;
    const errorHandler = script?.dataset.errorHandler;
    const successHandler = script?.dataset.successHandler;
    if (!formId || !errorHandler || !successHandler) return;

    const controls = () => {
      const form = document.getElementById(formId);
      return {
        status: form?.parentElement?.querySelector("[data-signup-status]"),
        retryButton: form?.querySelector("[data-turnstile-retry]")
      };
    };

    window[errorHandler] = () => {
      const { status, retryButton } = controls();
      if (status && status.textContent !== "Subscribing…") {
        if (status.dataset.turnstileError !== "1") {
          status.dataset.previousTurnstileStatus = status.textContent || "";
        }
        status.dataset.turnstileError = "1";
        status.textContent = "Security check failed. Cloudflare will retry automatically. If it keeps failing, select Retry verification or refresh this page.";
      }
      if (retryButton instanceof HTMLButtonElement) retryButton.hidden = false;
      return true; // Handled, so Turnstile does not throw an uncaught exception.
    };

    window[successHandler] = () => {
      const { status, retryButton } = controls();
      if (status?.dataset.turnstileError === "1") {
        status.textContent = status.dataset.previousTurnstileStatus || "Security check complete. You can sign up.";
        delete status.dataset.previousTurnstileStatus;
        delete status.dataset.turnstileError;
      }
      if (retryButton instanceof HTMLButtonElement) retryButton.hidden = true;
    };
  })();
</script>

<div class={`email-signup-strip email-signup-strip--${variant}`} data-form-id={formId}>
  <div class="email-signup-inner">
    <div class="email-signup-copy">
      <p class="email-signup-heading">{heading}</p>
      <p class="email-signup-sub">{subtext}</p>
    </div>
    <form
      class="email-signup-form"
      id={formId}
      action={submitUrl}
      method="post"
      accept-charset="UTF-8"
      data-cta={`email-signup-${formId}`}
      data-cio-source-form
      data-success-redirect={successRedirect}
    >
      <input type="hidden" name="form_id" value={cioFormId} />
      <input type="hidden" name="source_type" value={sourceType} />
      <input type="hidden" name="source_page" value={sourcePageValue} data-source-page />
      <input type="hidden" name="lead_magnet" value={leadMagnet} />
      <input type="hidden" name="utm_source" value="" data-utm-field="utm_source" />
      <input type="hidden" name="utm_medium" value="" data-utm-field="utm_medium" />
      <input type="hidden" name="utm_campaign" value="" data-utm-field="utm_campaign" />
      <label class="sr-only" for={`email-field-${formId}`}>Your email address</label>
      <input
        id={`email-field-${formId}`}
        type="email"
        name="email"
        placeholder="you@company.com"
        required
        autocomplete="email"
      />
      {turnstileSiteKey && (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme={turnstileTheme}
          data-size="flexible"
          data-error-callback={turnstileErrorCallback}
          data-callback={turnstileSuccessCallback}
        />
      )}
      {turnstileSiteKey && (
        <button type="button" class="turnstile-retry" data-turnstile-retry hidden>Retry verification</button>
      )}
      <button type="submit" class="button button-brand">{buttonLabel}</button>
    </form>
    <p class="email-signup-fine" data-signup-status role="status" aria-live="polite">{finePrint}</p>
  </div>
</div>

<script is:inline>
  document.querySelectorAll("form[data-cio-source-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.cioBound) return;
    form.dataset.cioBound = "1";

    const pageField = form.querySelector("[data-source-page]");
    if (pageField instanceof HTMLInputElement) {
      pageField.value = window.location.href;
    }

    const params = new URLSearchParams(window.location.search);
    form.querySelectorAll("[data-utm-field]").forEach((field) => {
      if (!(field instanceof HTMLInputElement)) return;
      const key = field.dataset.utmField;
      if (!key) return;
      field.value = params.get(key) || "";
    });

    const status = form.parentElement?.querySelector("[data-signup-status]");
    const button = form.querySelector('button[type="submit"]');
    const defaultFine = status?.textContent || "No spam. Unsubscribe any time.";
    const retryButton = form.querySelector("[data-turnstile-retry]");
    if (retryButton instanceof HTMLButtonElement) {
      retryButton.addEventListener("click", () => {
        const widget = form.querySelector(".cf-turnstile");
        if (!widget || !window.turnstile) {
          if (status) status.textContent = "Please refresh this page and try again.";
          return;
        }
        try {
          if (status) status.textContent = "Retrying the security check…";
          retryButton.hidden = true;
          window.turnstile.reset(widget);
        } catch (_) {
          retryButton.hidden = false;
          if (status) status.textContent = "Please refresh this page and try again.";
        }
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = (data.get("email") || "").toString().trim();
      if (!email) return;
      if (form.querySelector(".cf-turnstile") && !(data.get("cf-turnstile-response") || "").toString().trim()) {
        if (status) status.textContent = "Please complete the security check before subscribing.";
        if (retryButton instanceof HTMLButtonElement) retryButton.hidden = false;
        return;
      }

      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
      }
      if (status) status.textContent = "Subscribing…";

      try {
        const res = await fetch(form.action || "/api/forms", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            email,
            form_id: (data.get("form_id") || "").toString(),
            source_type: (data.get("source_type") || "").toString(),
            source_page: (data.get("source_page") || window.location.href).toString(),
            lead_magnet: (data.get("lead_magnet") || "").toString(),
            utm_source: (data.get("utm_source") || "").toString(),
            utm_medium: (data.get("utm_medium") || "").toString(),
            utm_campaign: (data.get("utm_campaign") || "").toString(),
            "cf-turnstile-response": (data.get("cf-turnstile-response") || "").toString()
          })
        });
        const payload = await res.json().catch(() => ({}));
        if (res.ok && payload.ok && payload.form_id) {
          try {
            if (typeof window.wssRememberLeadEmail === "function") {
              window.wssRememberLeadEmail(email);
            } else {
              sessionStorage.setItem("wss_lead_email", email);
            }
          } catch (_) {}
          form.reset();
          if (pageField instanceof HTMLInputElement) pageField.value = window.location.href;
          try {
            if (window.turnstile) {
              const widget = form.querySelector(".cf-turnstile");
              if (widget) window.turnstile.reset(widget);
            }
          } catch (_) {}
          // Lets the newsletter popup retire itself for anyone who has signed
          // up — newsletter forms only, not lead-magnet downloads.
          if ((data.get("source_type") || "").toString() === "newsletter") {
            document.dispatchEvent(new CustomEvent("newsletter:subscribed"));
          }
          const successRedirect = form.dataset.successRedirect || "";
          if (status) status.textContent = successRedirect ? "Success. Opening your downloads…" : "You're in. Check your inbox.";
          if (successRedirect) {
            const destination = new URL(successRedirect, window.location.origin);
            if (destination.origin === window.location.origin) window.location.assign(destination.href);
          }
        } else {
          if (status) status.textContent = "Couldn\u0027t confirm your signup. Please try again, or contact us by email.";
        }
      } catch (_) {
        if (status) status.textContent = "Something went wrong — try again in a moment.";
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
        if (status && status.textContent === "Subscribing…") {
          status.textContent = defaultFine;
        }
      }
    });
  });
</script>

<style>
  .email-signup-strip {
    border-radius: var(--v9-radius-small);
    padding: 2rem 1.5rem;
    margin: 2.5rem 0;
  }
  .email-signup-strip--light {
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .email-signup-strip--dark {
    background: var(--ink);
    color: #fff;
  }
  .email-signup-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .email-signup-copy { display: flex; flex-direction: column; gap: 0.25rem; }
  .email-signup-heading {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: inherit;
  }
  .email-signup-sub {
    font-size: 0.9rem;
    margin: 0;
    color: var(--muted);
  }
  .email-signup-strip--dark .email-signup-sub { color: var(--v9-copy-dark); }

  .email-signup-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    width: 100%;
    min-width: 0;
  }
  .email-signup-form .cf-turnstile {
    flex: 1 1 100%;
  }
  .email-signup-form .turnstile-retry {
    border: 0;
    background: transparent;
    padding: 0.25rem 0;
    color: var(--accent);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
  }
  .email-signup-form .turnstile-retry[hidden] { display: none; }
  .email-signup-strip--dark .turnstile-retry { color: var(--v9-white); }
  .email-signup-form input[type="email"] {
    flex: 1 1 220px;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--v9-radius-small);
    font-size: 0.95rem;
    background: #fff;
    color: var(--ink);
    outline: none;
    min-width: 0;
  }
  .email-signup-strip--dark .email-signup-form input[type="email"] {
    background: var(--v9-night-3);
    border-color: var(--v9-line-dark);
    color: var(--v9-white);
  }
  .email-signup-form input[type="email"]:focus {
    border-color: var(--accent);
  }
  .email-signup-form .button {
    max-width: 100%;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .email-signup-form {
      flex-direction: column;
    }
    .email-signup-form input[type="email"],
    .email-signup-form .button {
      width: 100%;
    }
    /* Once the form stacks, the 220px basis applies to height, not width,
       which stretches the field into a giant box. */
    .email-signup-form input[type="email"] {
      flex: 0 0 auto;
    }
  }
  .email-signup-fine {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
</style>