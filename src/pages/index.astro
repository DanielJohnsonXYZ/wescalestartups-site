---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig, buyerFaqs, testimonials } from "../site";
import { buildFaqSchema } from "../lib/schema";
import "../styles/home-v8.css";

const faqSchema = buildFaqSchema([...buyerFaqs]);
const homepageQuotes = testimonials
  .filter((t) => t.category === "paid-client" || t.category === "paid-advisory")
  .slice(0, 3);

// "Not a founder?" routing, investors / corporate / operators
const subAudiences = [
  {
    title: "Investors & funds.",
    body: "Diagnose growth across a portfolio in two weeks. Same framework, applied across companies.",
    href: "/resources/vc-portfolio-growth-diagnosis",
    label: "VC Portfolio Diagnosis"
  },
  {
    title: "Corporate & accelerator partners.",
    body: "Workshops, keynote talks, and programme advisory for cohorts and innovation teams.",
    href: "/speaking",
    label: "Speaking & workshops"
  },
  {
    title: "Operators, advisors & referrers.",
    body: "Refer a founder, come on the podcast, or partner on a deal. Drop a line.",
    href: "/contact",
    label: "Get in touch"
  }
];
---
<BaseLayout
  title="We Scale Startups | Growth Systems for Seed–Series B B2B SaaS & AI"
  description="Fractional CMO who installs a repeatable growth system in 90 days, for post-PMF B2B SaaS and AI founders doing £1–10M ARR."
  path="/"
  schema={faqSchema}
  bodyClass="page-home-v8"
>
  {/* ============ HERO, the problem, the promise, the proof ============ */}
  <section class="hero">
    <div class="shell">
      <span class="hero-badge"><span class="dot"></span> Growth partner · Seed–Series B B2B SaaS &amp; AI</span>
      <div class="hero-grid">
        <div>
          <h1>We drive growth for <span class="hl">B2B SaaS &amp; AI startups</span>.</h1>
          <p class="lede">Your product is ahead of your pipeline. We diagnose what's blocking growth, install the acquisition system, and hand it to your team in 90 days, <strong>so revenue compounds without the founder in every decision</strong>.</p>

          <div class="step-chips">
            <a href="/services/growth-diagnosis" class="step-chip"><span class="n">01</span> Diagnose</a>
            <a href="/services/90-day-growth-sprint" class="step-chip"><span class="n">02</span> Sprint</a>
            <a href="/services/acquisition-system-build" class="step-chip"><span class="n">03</span> Build</a>
            <a href="/services/fractional-cmo" class="step-chip"><span class="n">04</span> Embed</a>
          </div>

          <div class="hero-ctas">
            <a href={siteConfig.bookingUrl} class="btn-primary">{siteConfig.bookingLabel} <span>→</span></a>
            <a href={siteConfig.scorecardUrl} class="hero-cta-alt">Or find the constraint costing this quarter's pipeline, free 5-min diagnostic →</a>
          </div>

          <div class="hero-trust">
            <div class="trust"><span class="trust-v">£18M+</span><span class="trust-l">Revenue<br />influenced</span></div>
            <div class="trust"><span class="trust-v">£6M+</span><span class="trust-l">Paid spend<br />managed</span></div>
            <div class="trust"><span class="trust-v">479+</span><span class="trust-l">Founder<br />sessions</span></div>
            <div class="trust"><span class="trust-v">4.93<span style="font-size:0.55em;color:var(--ink-4);font-weight:500;">/5</span></span><span class="trust-l">GrowthMentor<br />rating</span></div>
          </div>
        </div>

        {/* 60-second bottleneck check, funnels into the full scorecard */}
        <aside class="diag-card glow-card" id="mini-check">
          <div class="diag-head">
            <span class="diag-head-l">Growth Bottleneck Check</span>
            <span class="diag-head-r" id="mc-progress">3 questions · 60 seconds</span>
          </div>
          <div class="diag-title">Where is growth actually stuck?</div>
          <div class="diag-sub">Answer honestly. You'll get a first read on your constraint, then the full scorecard can pressure-test it.</div>
          <div class="mc-questions">
            <div class="mc-q" data-q="loop">
              <p>Could your team run pipeline for a month without you?</p>
              <div class="mc-btns"><button type="button" data-a="yes">Yes</button><button type="button" data-a="no">No</button></div>
            </div>
            <div class="mc-q" data-q="acquisition">
              <p>Does more than one channel reliably create pipeline?</p>
              <div class="mc-btns"><button type="button" data-a="yes">Yes</button><button type="button" data-a="no">No</button></div>
            </div>
            <div class="mc-q" data-q="customer">
              <p>Do you know, with evidence, why customers pick you?</p>
              <div class="mc-btns"><button type="button" data-a="yes">Yes</button><button type="button" data-a="no">No</button></div>
            </div>
          </div>
          <div class="verdict" id="mc-verdict" hidden><strong>First read.</strong> <span id="mc-verdict-text"></span></div>
          <a class="btn-primary mc-cta" id="mc-cta" href={siteConfig.scorecardUrl} hidden>Run the full 5-min scorecard <span>→</span></a>
        </aside>
      </div>
    </div>
  </section>

  {/* ============ LOGO WALL, credentials ============ */}
  <section class="logo-wall">
    <div class="shell">
      <div class="logo-wall-label">Trusted by founders, programmes &amp; platforms</div>
      <div class="logo-row-groups reveal">
        <div class="logo-group">
          <p class="logo-group-label">Startup programmes &amp; mentoring</p>
          <div class="logo-row">
            <a href="https://startup.google.com/" class="logo-item" rel="noopener noreferrer" target="_blank" aria-label="Google for Startups, mentor">
              <img class="logo-img" src="/images/logos/google.webp" alt="Google for Startups" width="130" height="30" loading="lazy" decoding="async" />
              <span class="logo-meta">Mentor</span>
            </a>
            <a href="https://www.techstars.com" class="logo-item" rel="noopener noreferrer" target="_blank" aria-label="Techstars, mentor and speaker">
              <img class="logo-img" src="/images/logos/techstars.webp" alt="Techstars" width="130" height="30" loading="lazy" decoding="async" />
              <span class="logo-meta">Mentor &amp; speaker</span>
            </a>
            <a href="https://www.gov.uk/government/organisations/uk-space-agency" class="logo-item" rel="noopener noreferrer" target="_blank" aria-label="UK Space Agency, startup ecosystem support">
              <img class="logo-img" src="/images/logos/uksa.webp" alt="UK Space Agency" width="130" height="30" loading="lazy" decoding="async" />
              <span class="logo-meta">Ecosystem support</span>
            </a>
          </div>
        </div>
        <div class="logo-group">
          <p class="logo-group-label">Guest lecturing &amp; teaching</p>
          <div class="logo-row">
            <a href="https://www.jbs.cam.ac.uk/" class="logo-item" rel="noopener noreferrer" target="_blank" aria-label="Cambridge Judge Business School, guest lecturer">
              <img class="logo-img" src="/images/logos/cambridge.webp" alt="Cambridge Judge Business School" width="130" height="30" loading="lazy" decoding="async" />
              <span class="logo-meta">Guest lecturer</span>
            </a>
            <a href="https://www.imperial.ac.uk/business-school" class="logo-item" rel="noopener noreferrer" target="_blank" aria-label="Imperial College Business School, speaker">
              <img class="logo-img" src="/images/logos/imperial.webp" alt="Imperial College Business School" width="130" height="30" loading="lazy" decoding="async" />
              <span class="logo-meta">Speaker</span>
            </a>
            <a href="https://generalassemb.ly/" class="logo-item" rel="noopener noreferrer" target="_blank" aria-label="General Assembly, growth teaching">
              <img class="logo-img" src="/images/logos/general-assembly.webp" alt="General Assembly" width="130" height="30" loading="lazy" decoding="async" />
              <span class="logo-meta">Growth teaching</span>
            </a>
          </div>
        </div>
        <div class="logo-group">
          <p class="logo-group-label">Founder reviews</p>
          <div class="logo-row">
            <a href="https://app.growthmentor.com/mentors/daniel-johnson" class="logo-item" rel="noopener noreferrer" target="_blank" aria-label="GrowthMentor, 4.93 across 479+ sessions">
              <img class="logo-img" src="/images/logos/growthmentor-v2.jpg" alt="GrowthMentor" width="130" height="30" loading="lazy" decoding="async" />
              <span class="logo-meta">★ 4.93 · 479+ sessions</span>
            </a>
            <a href="https://mentorcruise.com/mentor/danieljohnson/" class="logo-item cred-item" rel="noopener noreferrer" target="_blank" aria-label="MentorCruise, Top Mentor, 5.0 out of 5">
              <span class="cred-name">MentorCruise</span>
              <span class="logo-meta">Top Mentor · 5.0/5</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ MANIFESTO, why a system beats heroics ============ */}
  <section class="manifesto">
    <div class="shell">
      <span class="spec-label">The thesis · § 01</span>
      <p class="manifesto-quote reveal">Most Seed–Series B B2B SaaS and AI startups don't have a product problem. They have a <em>distribution problem</em>: every growth decision still routes through the founder, so pipeline moves at the speed of one person.</p>
      <div class="manifesto-grid">
        <div class="belief-card glow-card reveal" data-d="1">
          <span class="belief-n">/01, Diagnose before spend</span>
          <h2>Name the constraint first.</h2>
          <p>More budget against an unnamed bottleneck buys activity, not pipeline. Every engagement starts by naming the single constraint that's binding growth.</p>
        </div>
        <div class="belief-card glow-card reveal" data-d="2">
          <span class="belief-n">/02, Systems over heroics</span>
          <h2>Install a rhythm, not a hero.</h2>
          <p>A weekly decision cadence your team owns beats a brilliant operator who leaves. We build the operating system, then transfer it.</p>
        </div>
        <div class="belief-card glow-card reveal" data-d="3">
          <span class="belief-n">/03, Built to hand off</span>
          <h2>You shouldn't need us forever.</h2>
          <p>Success is the quarter the system runs without us, channels aligned, reporting trusted, decisions made on schedule, founder out of the loop.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ============ INTERACTIVE BOTTLENECK FINDER ============ */}
  <section class="bf-section">
    <div class="shell">
      <span class="spec-label">The system · § 02 · WSS Growth Operating System</span>
      <h2 class="section-h">The WSS Growth <em>Operating System</em>.</h2>
      <p class="section-sub">The same arc we teach founders: know the customer, prove the problem, sharpen the offer, test cheaply, then install the growth loop. No decision passes on opinion; evidence moves from <strong>word → action → money</strong> before it earns budget. Click the constraint that sounds like you.</p>

      <div class="bottleneck-finder">
        <div class="bf-grid reveal" id="bf-grid">
          <button class="bf-card" data-bn="customer"><span class="bf-num">01 / CUSTOMER</span><span class="bf-name">ICP too broad</span><span class="bf-q">Everyone could use it, no one buys it.</span></button>
          <button class="bf-card" data-bn="positioning"><span class="bf-num">02 / OFFER &amp; POSITIONING</span><span class="bf-name">Story doesn't land</span><span class="bf-q">Demos go well, pipeline doesn't.</span></button>
          <button class="bf-card active" data-bn="acquisition"><span class="bf-num">03 / ACQUISITION</span><span class="bf-name">One-channel risk</span><span class="bf-q">If it dips, the quarter dips.</span></button>
          <button class="bf-card" data-bn="evidence"><span class="bf-num">04 / EXPERIMENTS &amp; EVIDENCE</span><span class="bf-name">Decisions on opinion</span><span class="bf-q">Dashboards disagree, tests never conclude.</span></button>
          <button class="bf-card" data-bn="team"><span class="bf-num">05 / GROWTH LOOP</span><span class="bf-name">Founder bottleneck</span><span class="bf-q">Every brief routes through you.</span></button>
        </div>

        <div class="bf-result glow-card reveal" id="bf-result">
          <div>
            <div class="bf-result-meta" id="bf-meta">03 · ACQUISITION</div>
            <h3 id="bf-title">One channel carries the funnel.</h3>
            <p id="bf-desc">Diversify before the dip: design the second engine and the weekly decision rule that scales it.</p>
            <a class="bf-result-link" id="bf-link" href="/services/acquisition-system-build">Acquisition System Build →</a>
          </div>
          <div class="bf-rec">
            <span class="bf-rec-label">Recommended engagement</span>
            <span class="bf-rec-svc" id="bf-svc">Acquisition System Build</span>
            <span class="bf-rec-meta" id="bf-svc-meta">from £15k · 8–12 weeks · Flagship</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ PHOTO STRIP, break up the text ============ */}
  <section class="photo-strip" aria-label="Daniel Johnson teaching and speaking">
    <div class="shell">
      <div class="photo-strip-grid reveal">
        <figure>
          <img src="/images/speaking/daniel-speaking-nomad-960.webp" alt="Daniel Johnson teaching a founder cohort" loading="lazy" decoding="async" width="960" height="640" />
          <figcaption>Teaching the growth system to a founder cohort</figcaption>
        </figure>
        <figure>
          <img src="/images/speaking/daniel-speaking-shenzhen-960.webp" alt="Daniel Johnson speaking on startup growth in Shenzhen" loading="lazy" decoding="async" width="960" height="640" />
          <figcaption>On stage: acquisition systems for AI-era startups</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ============ FIT, built for / not for ============ */}
  <section class="fit">
    <div class="shell">
      <span class="spec-label">Self-qualify · § 03</span>
      <h2 class="section-h">Built for some teams. <em>Not for others.</em></h2>
      <p class="section-sub">Better you know in 30 seconds than 15 minutes into a call.</p>
      <div class="fit-grid">
        <div class="fit-card for glow-card reveal">
          <span class="fit-label yes">Built for</span>
          <ul>
            <li>Post-PMF B2B SaaS and AI startups, Seed to Series B.</li>
            <li>Real traction, inconsistent pipeline.</li>
            <li>Founder still owns too many growth decisions.</li>
            <li>A team that needs a system, not more disconnected execution.</li>
            <li>Willing to share numbers weekly.</li>
          </ul>
        </div>
        <div class="fit-card against glow-card reveal" data-d="1">
          <span class="fit-label no">Not for</span>
          <ul>
            <li>Pre-PMF products still searching for fit.</li>
            <li>Teams wanting only ads management.</li>
            <li>Founders looking for a one-off campaign.</li>
            <li>Volume buyers who want more activity, not fewer sharper decisions.</li>
            <li>Companies unwilling to share numbers weekly.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ============ SERVICES LADDER ============ */}
  <section class="services">
    <div class="shell">
      <span class="spec-label">Four engagements · one ladder · § 04</span>
      <h2 class="section-h">Pick the smallest commitment that answers your <em>biggest</em> question.</h2>
      <p class="section-sub">Each engagement installs what the next one needs, diagnosis names the constraint, the sprint tests the move, the build installs the rhythm, embed operates it. Start small, ladder up.</p>
      <div class="svc-grid">
        <article class="svc-card glow-card reveal">
          <span class="svc-step">/01</span>
          <span class="svc-title">Growth Diagnosis</span>
          <span class="svc-price">£2k · 1 week</span>
          <div class="svc-desc"><strong>Best for</strong>You're not sure what's blocking pipeline.</div>
          <div class="svc-desc"><strong>What gets built</strong>Constraint map, evidence review, 90-day plan.</div>
          <div class="svc-cta"><a href="/services/growth-diagnosis">Read →</a></div>
        </article>
        <article class="svc-card glow-card reveal" data-d="1">
          <span class="svc-step">/02</span>
          <span class="svc-title">90-Day Growth Sprint</span>
          <span class="svc-price">£8k · 12 weeks</span>
          <div class="svc-desc"><strong>Best for</strong>Focused tests against the named bottleneck this quarter.</div>
          <div class="svc-desc"><strong>What gets built</strong>Experiment backlog, weekly decisions, tested copy.</div>
          <div class="svc-cta"><a href="/services/90-day-growth-sprint">Run →</a></div>
        </article>
        <article class="svc-card flagship glow-card reveal" data-d="2">
          <span class="svc-step">/03 <span class="svc-flag">Flagship</span></span>
          <span class="svc-title">Acquisition System Build</span>
          <span class="svc-price">£15k · 8–12 weeks</span>
          <div class="svc-desc"><strong>Best for</strong>Channels in isolation; you need them as one system.</div>
          <div class="svc-desc"><strong>What gets built</strong>Channel architecture, offer map, reporting, handoff pack.</div>
          <div class="svc-cta"><a href="/services/acquisition-system-build">Build →</a></div>
        </article>
        <article class="svc-card glow-card reveal" data-d="3">
          <span class="svc-step">/04</span>
          <span class="svc-title">Fractional CMO</span>
          <span class="svc-price">£5k/mo · 3-mo min</span>
          <div class="svc-desc"><strong>Best for</strong>Senior growth leadership without a £150k full-time hire.</div>
          <div class="svc-desc"><strong>What gets built</strong>Operating cadence, agency direction, board reporting.</div>
          <div class="svc-cta"><a href="/services/fractional-cmo">Embed →</a></div>
        </article>
      </div>
    </div>
  </section>

  {/* ============ 90-DAY TIMELINE ============ */}
  <section class="timeline">
    <div class="shell">
      <span class="spec-label">After you book · § 05</span>
      <h2 class="section-h">What actually happens in <em>90 days</em>.</h2>
      <p class="section-sub">Not a strategy deck and a wave goodbye. A week-by-week operating programme with a handoff date.</p>
      <div class="tl-grid">
        <div class="tl-step glow-card reveal">
          <span class="tl-when">Week 1</span>
          <h3>Name the constraint</h3>
          <p>Evidence review, funnel data, founder context. The single bottleneck named in plain English, with a reporting baseline.</p>
        </div>
        <div class="tl-step glow-card reveal" data-d="1">
          <span class="tl-when">Weeks 2–4</span>
          <h3>Design &amp; launch</h3>
          <p>ICP, offer, channel architecture. First tests live. The weekly decision meeting starts, and keeps its slot.</p>
        </div>
        <div class="tl-step glow-card reveal" data-d="2">
          <span class="tl-when">Month 2</span>
          <h3>Scale the signal</h3>
          <p>Double down on the strongest channel and fix the conversion leaks the tests exposed. One dashboard, trusted.</p>
        </div>
        <div class="tl-step glow-card reveal" data-d="3">
          <span class="tl-when">Month 3</span>
          <h3>Transfer ownership</h3>
          <p>Cadence documented, dashboard owned, decisions made by the team. The founder leaves the loop deliberately.</p>
        </div>
        <div class="tl-step tl-final glow-card reveal" data-d="4">
          <span class="tl-when">Day 90</span>
          <h3>Board-ready review</h3>
          <p>What moved, what didn't, and next quarter's plan, with a system that runs without you in every decision.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ============ CASE STUDIES ============ */}
  <section class="cases">
    <div class="shell">
      <span class="spec-label">Real engagements · § 06</span>
      <h2 class="section-h">Client results.</h2>
      <p class="section-sub">Every result is labelled: paid client engagement, programme, or lecturing. Nothing here reads like an implied client when it isn't one.</p>
      <div class="case-grid">
        <article class="case-card feature glow-card reveal">
          <span class="case-meta">Paid · Healthtech · Fractional CMO</span>
          <h3>Healthtech (anon.)</h3>
          <div class="case-sub">Precision medicine · Marketing function from zero</div>
          <p>Built the marketing operation from scratch: outbound, events, agency coordination. <strong>CEO moved from doing everything to a weekly review</strong>, with the system left in the team.</p>
          <div class="case-mini-stats">
            <div><div class="case-stat-v">464</div><div class="case-stat-l">Media placements</div></div>
            <div><div class="case-stat-v">18</div><div class="case-stat-l">Clinicians in pilot</div></div>
            <div><div class="case-stat-v">30–40%</div><div class="case-stat-l">LinkedIn accept rate</div></div>
          </div>
          <a href="/case-studies/healthtech-precision-medicine" class="case-link">Read the full case study →</a>
        </article>
        <article class="case-card glow-card reveal" data-d="1">
          <span class="case-meta">Paid · Fintech</span>
          <h3>Ned</h3>
          <div class="case-sub">Funding platform · Paid search + SEO</div>
          <p><strong>500+ sign-ups</strong> in two months from paid search. CTR 8.6%, CPC $0.74.</p>
          <a href="/case-studies/ned" class="case-link">Read →</a>
        </article>
        <article class="case-card glow-card reveal" data-d="2">
          <span class="case-meta">Paid · Healthtech</span>
          <h3>eQuoo</h3>
          <div class="case-sub">Mental-health app · Fractional CMO</div>
          <p>Clearer <strong>acquisition narrative</strong> and channel hierarchy.</p>
          <a href="/case-studies/equoo" class="case-link">Read →</a>
        </article>
      </div>
    </div>
  </section>

  {/* ============ TESTIMONIALS ============ */}
  <section class="testimonials">
    <div class="shell">
      <span class="spec-label">Founder voices · § 07</span>
      <h2 class="section-h">What founders <em>say</em>.</h2>
      <p class="section-sub">Paid client and paid advisory work. Mentoring-platform reviews live on /testimonials.</p>
      <div class="testim-grid">
        {homepageQuotes.map((t, i) => (
          <figure class={`testim-card glow-card reveal`} data-d={i || undefined}>
            <span class="testim-mark">"</span>
            <blockquote>{t.quote}</blockquote>
            <cite>
              <strong>{t.name}{t.role ? `, ${t.role}` : ""}</strong>
              {t.company}
            </cite>
          </figure>
        ))}
      </div>
      <p class="section-sub" style="margin-top:1.5rem;">
        <a href="/testimonials">All founder voices, including mentoring reviews →</a>
      </p>
    </div>
  </section>

  {/* ============ DIAGNOSTIC CTA ============ */}
  <section class="diag-cta">
    <div class="shell">
      <div class="diag-cta-card glow-card reveal">
        <div>
          <span class="spec-label">Free diagnostic · § 08</span>
          <h2>Find the constraint costing this quarter's pipeline.</h2>
          <p>Take the 5-minute Growth Bottleneck Scorecard, built from 479+ founder sessions, and get a founder-ready readout across positioning, acquisition, conversion, reporting and team ownership.</p>
        </div>
        <div class="diag-cta-actions">
          <a href={siteConfig.scorecardUrl} class="btn-primary">Take the 5-min scorecard <span>→</span></a>
          <a href={siteConfig.bookingUrl} class="hero-cta-alt">Or skip straight to the 20-min call →</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============ ABOUT, with real photos ============ */}
  <section class="about">
    <div class="shell">
      <span class="spec-label">Founder · § 09</span>
      <div class="about-grid">
        <div class="about-photo-stack reveal">
          <div class="about-photo">
            <img src="/images/daniel-headshot-640.webp" alt="Daniel Johnson, founder of We Scale Startups" loading="lazy" width="640" height="640" decoding="async" />
          </div>
          <div class="about-photo-secondary">
            <img src="/images/daniel-aircraft-640.webp" alt="Daniel Johnson, operator-side context" loading="lazy" width="640" height="640" decoding="async" />
          </div>
          <div class="about-photo-caption">Daniel Johnson · Founder, We Scale Startups</div>
        </div>
        <div class="about-content reveal" data-d="1">
          <h2>Why I built <em>this</em>.</h2>
          <p>I'm Daniel Johnson. After 15 years operating inside SaaS, fintech, healthtech and EdTech startups, including two exits, I kept seeing the same pattern: founders with great products, stuck running marketing themselves because nobody else on the team could read the numbers and decide what to scale.</p>
          <p>I built We Scale Startups to be the operator I wished was there. <strong>The work is to diagnose the bottleneck, install the acquisition system, and transfer the weekly rhythm</strong>, so you don't need me forever.</p>
          <ul class="about-creds">
            <div class="label">Track record</div>
            <li>Two operator-side startup exits</li>
