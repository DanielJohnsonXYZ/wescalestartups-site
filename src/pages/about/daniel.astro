---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { buildBreadcrumbSchema } from "../../lib/schema";
import { canonicalProofMetrics, founderStory, pricingTiers, siteConfig } from "../../site";

const path = "/about/daniel";
const schema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
    { name: "Daniel Johnson", path }
  ])
];
---

<BaseLayout
  path={path}
  title="Daniel Johnson | We Scale Startups"
  description="Daniel Johnson, founder of We Scale Startups, fractional CMO and growth operator for post-PMF B2B SaaS and AI startups."
  schema={schema}
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
    { name: "Daniel Johnson", path }
  ]}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Founder</p>
      <h1>Daniel Johnson</h1>
      <figure class="daniel-portrait">
        <img
          src="/images/daniel-headshot-960.webp"
          alt="Daniel Johnson, founder of We Scale Startups"
          width="960"
          height="960"
          loading="eager"
          decoding="async"
        />
      </figure>
      <div class="hero-support">
        <p class="lede">{founderStory.intro}</p>
        <p>{founderStory.why}</p>
        <div class="hero-actions">
          <a class="button button-brand" href={siteConfig.bookingUrl} data-cta="daniel-book">{siteConfig.bookingLabel} →</a>
          <a class="button button-light" href={siteConfig.danielSite} rel="noopener noreferrer" target="_blank">
            Personal site →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="who-daniel-works-with">
    <div class="shell">
      <SectionIntro
        eyebrow="Who he works with"
        title="Daniel advises post-PMF B2B SaaS and AI teams between Seed and Series B."
        body="Daniel Johnson is a London-based fractional CMO and growth advisor. He works with founders who have paying customers but no repeatable way to win more of them, usually at Seed to Series B and roughly £1M–£10M ARR, in the UK and internationally. He leads every engagement himself, with no junior account managers, and hands the system to your team at the end."
      />
      <ul class="related-insights-list">
        <li>Best for: founders still running growth themselves, or teams whose pipeline is inconsistent after early traction.</li>
        <li>Stage: Seed to Series B, roughly £1M–£10M ARR.</li>
        <li>Sectors: B2B SaaS and AI first, with operator experience in fintech, healthtech and EdTech. 15 years in growth and two operator-side startup exits.</li>
        <li>Mentoring is separate from client work: he mentors founders through Google for Startups and Techstars, which is teaching, not paid delivery.</li>
        <li>Not the right fit: pre-PMF startups, or teams with no one internally to run the work. If that is you, he will say so on the call and point you somewhere better.</li>
      </ul>
      <h3 style="margin-top:1.5rem">Ways to hire him, with published prices</h3>
      <ul class="related-insights-list">
        {pricingTiers.map((t) => (
          <li><a href={t.href}>{t.name}</a>: {t.priceFrom}, {t.duration}.</li>
        ))}
        <li><a href="/services/fractional-cmo">Fractional CMO Plus</a>: £7.5k–£10k/mo, about two days a week, when you need deeper operating support.</li>
      </ul>
      <p style="margin-top:1rem"><a href="/pricing">Compare all engagements on the pricing page</a>, or <a href={siteConfig.bookingUrl}>book a call</a> to check fit.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro eyebrow="Proof base" title="Operator context." />
      <ul class="daniel-credentials">
        {founderStory.credentials.map((c) => <li>{c}</li>)}
      </ul>
      <ul class="related-insights-list" style="margin-top:1.5rem">
        {canonicalProofMetrics.map((m) => (
          <li>
            <strong>{m.value}</strong> {m.label}
            {"note" in m && m.note ? `, ${m.note}` : ""}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Podcast"
        title={`Host of ${siteConfig.podcastName}`}
        body={`${siteConfig.podcastTagline} Subscribe on YouTube at ${siteConfig.podcastYoutubeHandle}, or visit the show page for guest applications and updates.`}
      />
      <div class="hero-actions">
        <a class="button button-brand" href="/podcast" data-cta="daniel-podcast">Show page →</a>
        <a class="button button-light" href={siteConfig.podcastYoutubeUrl} target="_blank" rel="noopener" data-cta="daniel-podcast-youtube">
          YouTube {siteConfig.podcastYoutubeHandle}
        </a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Next step</p>
        <h2>Talk to Daniel directly.</h2>
        <p>Bring your current growth picture. You'll leave with the bottleneck named in plain English.</p>
      </div>
      <div class="hero-actions">
        <a class="button button-brand" href={siteConfig.bookingUrl} data-cta="daniel-final-book">{siteConfig.bookingLabel} →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* A two-word name leaves the masthead's left column empty for ~360px.
     The portrait fills it and is the one image this page should lead with. */
  .daniel-portrait {
    margin: 1.75rem 0 0;
    max-width: 340px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--v9-radius);
  }
  .daniel-portrait img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 999px) {
    .daniel-portrait { max-width: 240px; }
  }
  /* The masthead grid auto-flows children, so a third child would land in
     the support column. Placed explicitly: headline then portrait down the
     left, support rail on the right. Matches site-v9's own breakpoint. */
  @media (min-width: 1000px) {
    .page-hero .shell > .daniel-portrait {
      grid-column: 1;
      grid-row: 3;
      margin-top: 2.25rem;
    }
    /* The rail spans both left-column rows so row 2 sizes to the headline
       alone — otherwise it stretches to the rail's height and drops the
       portrait 400px down the page. */
    .page-hero .shell > .hero-support {
      grid-column: 2;
      grid-row: 2 / span 2;
    }
  }
</style>
