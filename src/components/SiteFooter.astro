---
// SiteFooter.astro
//
// Layout: a brand column that carries the one footer conversion we care about
// (Growth Notes), then four even link columns. Legal moved down to the bottom
// bar so it stops being a two-item stub next to five-item columns.
import EmailSignup from "./EmailSignup.astro";
import { siteConfig } from "../site";

interface Props {
  /** When false, hide the secondary scorecard CTA in the brand column. */
  showScorecardCta?: boolean;
  /** When false, hide the newsletter signup block. */
  showNewsletter?: boolean;
}

const { showScorecardCta = true, showNewsletter = true } = Astro.props;

const groups = [
  {
    label: "Work with us",
    links: [
      { href: "/mentoring", label: "Growth Mentoring" },
      { href: "/services/growth-diagnosis", label: "Growth Diagnosis" },
      { href: "/services/90-day-growth-sprint", label: "90-Day Growth Sprint" },
      { href: "/services/acquisition-system-build", label: "Acquisition System Build" },
      { href: "/services/fractional-cmo", label: "Fractional CMO" },
      { href: "/ai-growth-audit", label: "AI Growth Audit" },
      { href: "/pricing", label: "Pricing" }
    ]
  },
  {
    label: "Results",
    links: [
      { href: "/proof", label: "All results" },
      { href: "/case-studies", label: "Case studies" },
      { href: "/testimonials", label: "Testimonials" },
      { href: "/industries", label: "Industries we serve" },
      { href: "/fractional-cmo-vs-agency", label: "WSS vs agency" }
    ]
  },
  {
    label: "Resources",
    links: [
      { href: "/start-here", label: "Start here" },
      { href: siteConfig.scorecardUrl, label: siteConfig.scorecardName },
      { href: "/resources", label: "Templates & tools" },
      { href: "/growth-operating-system", label: "Growth Operating System" },
      { href: "/growth-course", label: "Free growth course" },
      { href: "/insights", label: "Insights" },
      { href: "/gtm-strategy", label: "GTM Strategy Guide" },
      ...(siteConfig.podcastLive ? [{ href: "/podcast", label: "Luck Doesn't Scale" }] : [])
    ]
  },
  {
    label: "Company",
    links: [
      { href: "/about", label: "About WSS" },
      { href: "/about/daniel", label: "About Daniel" },
      { href: "/team", label: "Team" },
      { href: "/press", label: "Speaking & press" },
      { href: "/workshops", label: "Workshops" },
      { href: "/refer", label: "Refer a founder" },
      { href: "/contact", label: "Contact" },
      { href: siteConfig.linkedin, label: "LinkedIn", external: true }
    ]
  }
];
---

<footer class="site-footer site-footer-v2">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <img
        class="footer-logo"
        src="/images/logos/wss-logo.webp"
        alt="We Scale Startups"
        width="128"
        height="72"
        loading="lazy"
        decoding="async"
      />
      <p class="footer-summary">
        Growth infrastructure for AI startups and B2B SaaS: customer research, experimentation, and a weekly testing
        rhythm your team owns.
      </p>

      {showNewsletter && (
        <div class="footer-newsletter" aria-label="Newsletter signup">
          <EmailSignup
            variant="light"
            formId="footer-newsletter"
            heading={siteConfig.newsletterName}
            subtext={`${siteConfig.newsletterDescription} ${siteConfig.newsletterFrequencyLine}`}
          />
        </div>
      )}

      <div class="footer-brand-actions">
        <a class="button button-brand footer-contact" href="/contact" data-cta="footer-contact">
          Contact →
        </a>
        {showScorecardCta && (
          <a class="footer-secondary-cta" href={siteConfig.scorecardUrl}>
            Or take the {siteConfig.scorecardName} →
          </a>
        )}
      </div>
    </div>

    <div class="footer-cols">
      {groups.map((group) => (
        <div class="footer-col">
          <h2>{group.label}</h2>
          <nav class="footer-links" aria-label={`${group.label} links`}>
            {group.links.map((link) => (
              <a href={link.href} {...(link.external ? { target: "_blank", rel: "noopener" } : {})}>
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      ))}
    </div>
  </div>

  <div class="shell footer-note">
    <p>
      <strong>Brand note:</strong> this is the We Scale Startups commercial site (services, proof, systems). Daniel's
      personal brand, speaking, writing and media lives at{" "}
      <a href={siteConfig.danielSite} rel="noopener" target="_blank">danieljohnson.xyz</a>.
    </p>
  </div>

  <div class="shell footer-bottom">
    <p>© {new Date().getFullYear()} We Scale Startups</p>
    <p>{siteConfig.address}</p>
    <nav class="footer-legal" aria-label="Legal links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/facts/we-scale-startups">Company facts</a>
    </nav>
    <p class="founder-line">
      Founded by <a href="/about/daniel">{siteConfig.founderName}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer-v2 {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: 2rem;
  }

  .site-footer-v2 .footer-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 1024px) {
    .site-footer-v2 .footer-grid {
      grid-template-columns: minmax(300px, 0.95fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 34rem;
  }

  .footer-brand p.footer-summary {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 1rem 0 1.5rem;
    max-width: 38ch;
  }

  /* The newsletter is the footer's one job, so it gets the brand column and
     drops the centred 600px inner box it uses inside page sections. */
  .footer-newsletter {
    width: 100%;
    min-width: 0;
    margin-bottom: 1.5rem;
  }

  .footer-newsletter :global(.email-signup-strip) {
    margin: 0;
    padding: 1.25rem 1.35rem 1.35rem;
    border-radius: 0.9rem;
  }

  .footer-newsletter :global(.email-signup-inner) {
    max-width: none;
    margin: 0;
  }

  .footer-newsletter :global(.email-signup-heading) { font-size: 1rem; }
  .footer-newsletter :global(.email-signup-sub) { font-size: 0.82rem; }

  /* The shared form uses a 220px flex-basis on the field, which wraps the button
     onto its own line in a column this narrow. Keep them on one row. */
  .footer-newsletter :global(.email-signup-form) { flex-wrap: nowrap; }

  .footer-newsletter :global(.email-signup-form input[type="email"]) {
    flex: 1 1 auto;
    min-width: 0;
  }

  .footer-newsletter :global(.email-signup-form .button) {
    flex-shrink: 0;
    padding-inline: 1rem;
    font-size: 0.85rem;
  }

  .footer-brand-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.1rem;
  }

  .footer-contact { flex-shrink: 0; }

  .footer-secondary-cta {
    color: var(--muted);
    font-size: 0.84rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line);
  }

  .footer-secondary-cta:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .footer-cols {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 720px) {
    .footer-cols { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .footer-col h2 {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--violet-deep);
    margin: 0 0 0.9rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-links a:hover { color: var(--ink); }

  .footer-note {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .footer-note p {
    max-width: 92ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .footer-note strong { color: var(--ink); }

  .footer-note a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .footer-bottom p { margin: 0; }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
  }

  .footer-legal a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-legal a:hover { color: var(--ink); }

  .founder-line { margin-left: auto; }

  .founder-line a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .founder-line a:hover { border-bottom-color: var(--accent); }

  @media (max-width: 720px) {
    .founder-line { margin-left: 0; }
  }
</style>
