---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema } from "../lib/schema";

const steps = [
  { title: "Find the problem", detail: "Get specific about who you want to serve, what is frustrating them and how they solve it today. Talk to real people instead of guessing from a prompt.", outcome: "A customer problem worth testing", icon: "◎" },
  { title: "Validate demand", detail: "Find out whether the problem is important enough that people would change their behaviour or pay. Use conversations and tangible evidence, not compliments.", outcome: "Evidence of interest and willingness to pay", icon: "✳" },
  { title: "Build what matters", detail: "Prioritise the smallest changes that make the product more useful to the people most likely to buy. Avoid building features just because AI makes them easy.", outcome: "A sharper offer and product priorities", icon: "▱" },
  { title: "Get customers", detail: "Choose a practical way to reach the right buyers, start useful conversations and make a clear offer. Focus on doing, learning and improving.", outcome: "An acquisition experiment you can actually run", icon: "↗" },
  { title: "Repeat what works", detail: "Work out what caused progress and turn the useful parts into a simple repeatable process. Use AI to save time, not to replace customer understanding.", outcome: "A focused next-step growth plan", icon: "↻" }
];

const faqs = [
  {q:"Is this an AI course?",a:"The focus is finding customers, testing demand and making sales. You may use AI tools during the work, but you will still need to speak to potential buyers."},
  {q:"Who is it for?",a:"Solo founders and small teams using AI to build a product or service. You might be testing an idea, building an MVP or looking for your first customers."},
  {q:"What stage should I be at?",a:"You can apply with an idea, a prototype or a launched product. Tell us where you are stuck so we can see if the cohort is right for you."},
  {q:"How much does it cost and when does it start?",a:"Dates, format and pricing have not been confirmed. We are collecting interest now and will share the details before anyone commits."}
];
---

<BaseLayout
  title="WSS Solo | Built something with AI. Now what?"
  description="WSS Solo helps founders building with AI test demand, find paying customers and work out how to grow. Register interest in the founding cohort."
  keywords="WSS Solo, AI startup accelerator, solo founder, first customers, validate demand, AI-built businesses"
  path="/solo"
  schema={buildBreadcrumbSchema([{name:"Home",path:"/"},{name:"WSS Solo",path:"/solo"}])}
  showSiteHeader={false}
  showAnnouncement={false}
  stickyBookCta={false}
  newsletterPopup={false}
  showFooterNewsletter={false}
  showFooterScorecard={false}
>
  <main class="ws-solo">
    <header class="ws-nav">
      <div class="ws-wrap ws-nav-inner">
        <a class="ws-logo" href="/" aria-label="We Scale Startups home"><span class="ws-logo-mark">WSS<span>✳</span></span><span>WE SCALE STARTUPS <em>/ SOLO</em></span></a>
        <nav aria-label="WSS Solo" class="ws-nav-links"><a href="#approach">The approach</a><a href="#fit">Who it's for</a><a class="ws-nav-cta" href="#apply">Apply <span aria-hidden="true">↗</span></a></nav>
      </div>
    </header>

    <section class="ws-hero" aria-labelledby="ws-title">
      <div class="ws-wrap ws-hero-grid">
        <div>
          <p class="ws-eyebrow"><span class="ws-live-dot"></span> WSS SOLO / FOUNDING COHORT</p>
          <h1 id="ws-title">Built something <em>with AI.</em><br />Now what<span class="ws-question">?</span></h1>
          <p class="ws-lead">WSS Solo helps founders turn AI-powered products into businesses people actually pay for.</p>
          <p class="ws-hero-text">Find the right customers, test demand and work out how to grow.</p>
          <div class="ws-hero-actions"><a class="ws-btn ws-btn-lime" href="#apply">Apply for the founding cohort <span aria-hidden="true">↗</span></a><a class="ws-btn ws-btn-outline" href="#approach">Explore the approach ↓</a></div>
          <p class="ws-caption ws-hero-caption">Founding cohort. Dates and pricing to be confirmed.</p>
        </div>
        <aside class="ws-hero-art" aria-label="From product to a business">
          <span class="ws-art-top">WSS / SOLO</span>
          <div class="ws-art-orbit"><span class="ws-art-spark">✳</span><span class="ws-art-ring ws-art-ring-one"></span><span class="ws-art-ring ws-art-ring-two"></span></div>
          <div class="ws-art-bottom"><strong>Build it.</strong><strong>Find buyers.</strong><strong>Keep going.</strong></div>
          <span class="ws-art-corner">01 / 05</span>
        </aside>
      </div>
      <div class="ws-marquee" aria-hidden="true">MAKE SOMETHING <b>✳</b> FIND THE CUSTOMER <b>✳</b> TEST REAL DEMAND <b>✳</b> KEEP BUILDING <b>✳</b></div>
    </section>

    <section class="ws-section ws-intro">
      <div class="ws-wrap ws-intro-grid">
        <p class="ws-section-label">01 / THE QUESTION</p>
        <div><h2>You built the product.<br /><em>Who is buying it?</em></h2><p>We help you find out who needs your product, what they would pay for and how to reach them.</p></div>
      </div>
    </section>

    <section class="ws-section ws-approach" id="approach">
      <div class="ws-wrap">
        <div class="ws-heading"><p class="ws-section-label">02 / THE APPROACH</p><h2>From product to<br /><em>paying customers.</em></h2><p>Five steps to test demand, build what buyers want and start selling.</p></div>
        <div class="ws-step-area">
          <div class="ws-step-list" role="tablist" aria-label="Five steps of the approach">
            {steps.map((step,i)=>(
              <button class="ws-step" type="button" role="tab" id={`ws-tab-${i}`} aria-controls="ws-step-panel" aria-selected={i===0 ? "true":"false"} data-step={i}>
                <span class="ws-step-num">{String(i+1).padStart(2,"0")}</span><span>{step.title}</span><span class="ws-step-arrow" aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
          <div class="ws-step-detail" id="ws-step-panel" role="tabpanel" aria-labelledby="ws-tab-0" tabindex="0">
            <span class="ws-detail-icon" id="ws-detail-icon">◎</span><p class="ws-detail-small">FOCUS / <span id="ws-detail-number">01</span></p>
            <h3 id="ws-detail-title">Find the problem</h3>
            <p id="ws-detail-copy">Get specific about who you want to serve, what is frustrating them and how they solve it today. Talk to real people instead of guessing from a prompt.</p>
            <div class="ws-detail-outcome"><span>WHAT YOU ARE WORKING TOWARDS</span><strong id="ws-detail-outcome">A customer problem worth testing</strong></div>
          </div>
        </div>
        <script type="application/json" id="ws-step-data" set:html={JSON.stringify(steps)} />
      </div>
    </section>

    <section class="ws-section ws-fit" id="fit">
      <div class="ws-wrap ws-fit-grid">
        <div><p class="ws-section-label">03 / WHO IT'S FOR</p><h2>For founders<br /><em>building with AI.</em></h2><p>You've used AI to get something off the ground. Now you want to find out whether people need it and how to reach them.</p><a class="ws-link" href="#apply">Tell us about your product ↗</a></div>
        <div class="ws-deliverables"><p>WHAT YOU WILL WORK ON</p><div><span>✳</span>A specific customer problem</div><div><span>♧</span>Proof people will pay</div><div><span>↗</span>A way to reach buyers</div><div><span>▱</span>A sales process you can repeat</div></div>
      </div>
    </section>

    <section class="ws-section ws-proof">
      <div class="ws-wrap">
        <p class="ws-section-label">04 / THE EXPERIENCE BEHIND IT</p><h2>We've helped founders <em>find customers.</em></h2>
        <div class="ws-proof-grid"><div><strong>£18M+</strong><span>Revenue influenced</span></div><div><strong>479+</strong><span>Founder sessions</span></div><div><strong>4.97/5</strong><span>Mentor rating</span></div></div>
        <p class="ws-proof-note">These figures come from previous We Scale Startups work. The first Solo cohort has not run yet.</p>
      </div>
    </section>

    <section class="ws-section ws-application" id="apply">
      <div class="ws-wrap ws-application-grid">
        <div><p class="ws-section-label">05 / JOIN THE FOUNDING COHORT</p><h2>Tell us what<br /><em>you're building.</em></h2><p>We're collecting applications for the first cohort. We'll share dates, format and pricing before you commit.</p><div class="ws-apply-aside"><span>✳</span><div><strong>Early applications are open</strong><small>No payment or commitment required.</small></div></div></div>
        <div class="ws-form-wrap">
          <form id="ws-solo-application" novalidate>
            <label>Your name <input name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Your name" /></label>
            <label>Email address <input name="email" type="email" autocomplete="email" required maxlength="320" placeholder="you@company.com" /></label>
            <label>What are you building? <textarea name="product" required maxlength="1500" rows="3" placeholder="A few lines about your product or idea"></textarea></label>
            <label>Where are you now?
              <select name="stage" required><option value="">Select your stage</option><option>Exploring an idea</option><option>Building a prototype or MVP</option><option>Launched, looking for first customers</option><option>Already have some customers</option></select>
            </label>
            <label>What's your biggest challenge? <textarea name="challenge" required maxlength="1500" rows="3" placeholder="What are you trying to figure out?"></textarea></label>
            <label>Anything else we should know? <span class="ws-optional">Optional</span><textarea name="notes" maxlength="1500" rows="2" placeholder="What would make this useful for you?"></textarea></label>
            <button class="ws-btn ws-btn-purple ws-submit" type="submit">Review my application <span aria-hidden="true">↗</span></button>
            <p class="ws-form-info">Nothing is submitted automatically. You'll review and send the email yourself.</p>
            <p class="ws-form-info">Please don't include sensitive information. <a href="/privacy">Privacy policy</a>.</p>
            <p class="ws-form-message" id="ws-form-message" role="status" aria-live="polite"></p>
          </form>
          <div id="ws-review" class="ws-review" hidden>
            <p class="ws-section-label">REVIEW YOUR EMAIL</p><h3>Ready to send?</h3><p>Check the details below. When you're happy, open the draft in your email app and send it.</p>
            <div class="ws-review-details"><p><strong>To:</strong> daniel@wescalestartups.com</p><p><strong>Subject:</strong> WSS Solo founding cohort application</p><pre id="ws-review-text"></pre></div>
            <a id="ws-review-send" class="ws-btn ws-btn-purple ws-submit" href="mailto:daniel@wescalestartups.com">Open email draft ↗</a>
            <div class="ws-review-actions"><button id="ws-copy-email" class="ws-small-btn" type="button">Copy email details</button><button id="ws-edit-application" class="ws-small-btn" type="button">Edit my answers</button></div>
            <p id="ws-copy-status" role="status" aria-live="polite"></p>
            <p class="ws-form-info">If your email app doesn't open, copy the details and email them to <a href="mailto:daniel@wescalestartups.com">daniel@wescalestartups.com</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ws-section ws-faq">
      <div class="ws-wrap ws-faq-grid"><div><p class="ws-section-label">06 / GOOD QUESTIONS</p><h2>Before you <em>apply.</em></h2></div><div class="ws-faq-list">{faqs.map((item)=>(<details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>))}</div></div>
    </section>
    <div class="ws-end"><div class="ws-wrap"><p>BUILT SOMETHING? MAKE IT A BUSINESS.</p><a href="#apply">Apply for the founding cohort ↗</a></div></div>
  </main>
  <script is:inline>
    (() => {
      const stepData = document.getElementById("ws-step-data");
      if (stepData) {
        const steps = JSON.parse(stepData.textContent || "[]");
        const tabs = Array.from(document.querySelectorAll(".ws-step"));
        const panel = document.getElementById("ws-step-panel");
        const selectStep = (index) => {
          const item = steps[index];
          if (!item || !panel) return;
          for (const [i, tab] of tabs.entries()) {
            tab.setAttribute("aria-selected", i === index ? "true" : "false");
            tab.tabIndex = i === index ? 0 : -1;
          }
          document.getElementById("ws-detail-number").textContent = String(index+1).padStart(2,"0");
          document.getElementById("ws-detail-title").textContent = item.title;
          document.getElementById("ws-detail-copy").textContent = item.detail;
          document.getElementById("ws-detail-outcome").textContent = item.outcome;
          document.getElementById("ws-detail-icon").textContent = item.icon;
          panel.setAttribute("aria-labelledby", "ws-tab-" + index);
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener("click", () => selectStep(index));
          tab.addEventListener("keydown", (event) => {
            if (!["ArrowDown","ArrowUp","ArrowRight","ArrowLeft","Home","End"].includes(event.key)) return;
            event.preventDefault();
            const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length-1 : (index + (["ArrowDown","ArrowRight"].includes(event.key) ? 1 : -1) + tabs.length) % tabs.length;
            selectStep(next);
            tabs[next].focus();
          });
        });
      }
      const form = document.getElementById("ws-solo-application");
      const review = document.getElementById("ws-review");
      const notice = document.getElementById("ws-form-message");
      if (!(form instanceof HTMLFormElement) || !review) return;
      const subject = "WSS Solo founding cohort application";
      let draftText = "";
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          if (notice) notice.textContent = "Please complete the required fields.";
          return;
        }
        const data = new FormData(form);
        const value = (key) => String(data.get(key) || "").trim();
        draftText = ["WSS Solo founding cohort application","", "Name: " + value("name"), "Email: " + value("email"), "", "What I'm building:", value("product"), "", "Current stage: " + value("stage"), "", "Biggest challenge:", value("challenge"), "", "Anything else:", value("notes") || "(not provided)", "", "Submitted from: https://wescalestartups.com/solo"].join("\n");
        const email = document.getElementById("ws-review-text");
        const link = document.getElementById("ws-review-send");
        if (email) email.textContent = draftText;
        if (link) link.href = "mailto:daniel@wescalestartups.com?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(draftText);
        form.hidden = true;
        review.hidden = false;
        review.scrollIntoView({behavior: "smooth", block: "start"});
        if (notice) notice.textContent = "";
      });
      document.getElementById("ws-edit-application")?.addEventListener("click", () => {
        review.hidden = true; form.hidden = false; form.scrollIntoView({behavior: "smooth", block: "start"});
      });
      document.getElementById("ws-copy-email")?.addEventListener("click", async () => {
        const message = document.getElementById("ws-copy-status");
        try { await navigator.clipboard.writeText("To: daniel@wescalestartups.com\nSubject: " + subject + "\n\n" + draftText); if (message) message.textContent = "Copied. Paste into an email to Daniel."; }
        catch (_) { if (message) message.textContent = "Please select and copy the email details above."; }
      });
    })();
  </script>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap');
  .ws-solo{--night:#11121b;--night2:#191824;--ink:#13121d;--paper:#f9f7f2;--paper2:#f5f2ec;--purple:#603cff;--purple2:#a489ff;--lime:#d5ff58;--rule:#dcd8d3;--muted:#625f68;color:var(--ink);font-family:'DM Sans',Arial,sans-serif;overflow:hidden}
  .ws-solo *{box-sizing:border-box}.ws-solo a{text-underline-offset:4px}.ws-wrap{width:min(1170px,calc(100% - 3rem));margin-inline:auto}
  .ws-nav{background:var(--night);border-bottom:1px solid #ffffff24;color:white}.ws-nav-inner{display:flex;align-items:center;justify-content:space-between;gap:2rem;min-height:77px}
  .ws-logo{display:flex;align-items:center;gap:1rem;color:#f8f7fa;text-decoration:none;font-size:.72rem;letter-spacing:.12em;font-weight:800}
  .ws-logo-mark{font-size:1.1rem;letter-spacing:-.09em;color:var(--lime);font-weight:800}.ws-logo-mark span{font-size:1rem;margin-left:.2rem}.ws-logo em{font-style:normal;color:#bbaaff}.ws-nav-links{display:flex;align-items:center;gap:2rem}.ws-nav-links a{color:#e0dce8;text-decoration:none;font-size:.88rem;font-weight:600}.ws-nav-links a:hover{color:white}
  .ws-nav-links .ws-nav-cta{padding:.7rem 1.05rem;border-radius:40px;background:var(--lime);color:var(--ink);font-weight:800}.ws-nav-cta span{margin-left:.4rem}
  .ws-hero{background:radial-gradient(ellipse at 76% 30%,#35276088,transparent 42%),var(--night);color:white;padding-top:clamp(5rem,9vw,9rem)}.ws-hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2rem,6vw,6rem);align-items:center;padding-bottom:clamp(5rem,8vw,8rem)}.ws-eyebrow,.ws-section-label{font-size:.78rem;letter-spacing:.14em;font-weight:800;text-transform:uppercase}.ws-eyebrow{display:flex;align-items:center;gap:.7rem;color:var(--lime);margin:0 0 2rem}.ws-live-dot{width:8px;height:8px;border-radius:50%;background:var(--lime);box-shadow:0 0 0 5px #d5ff581e}
  .ws-solo h1,.ws-solo h2,.ws-solo h3{letter-spacing:-.045em}.ws-hero h1{font-size:clamp(3.8rem,6.5vw,7.3rem);line-height:1.03;margin:0 0 1.9rem;font-weight:700;max-width:12ch}.ws-hero h1 em,.ws-solo h2 em{font-family:'Fraunces',Georgia,serif;font-weight:400}.ws-hero h1 em{color:#bbaaff}.ws-question{color:var(--lime)}.ws-lead{font-size:clamp(1.2rem,2.2vw,1.48rem);font-weight:700;line-height:1.45;max-width:33ch;margin:0 0 1rem}.ws-hero-text{font-size:1.02rem;color:#cecad5;line-height:1.8;max-width:50ch}.ws-hero-actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem}.ws-btn{display:inline-flex;align-items:center;justify-content:center;gap:1.25rem;border:1px solid transparent;padding:1rem 1.3rem;min-height:52px;border-radius:10px;font-family:inherit;font-size:.91rem;font-weight:800;text-decoration:none;cursor:pointer;transition:transform .18s ease}.ws-btn:hover{transform:translateY(-2px)}.ws-btn-lime{background:var(--lime);color:var(--ink)}.ws-btn-outline{background:transparent;border-color:#ffffff55;color:white}.ws-btn-purple{background:var(--purple);color:white}.ws-caption{font-size:.8rem;color:#a9a5b3}.ws-hero-caption{margin:1.2rem 0 0}
  .ws-hero-art{position:relative;min-height:490px;border:1px solid #6c567a66;border-radius:22px;overflow:hidden;background:radial-gradient(circle at 53% 48%,#643cff5c,transparent 34%),linear-gradient(135deg,#2d2546,#151522 78%);box-shadow:0 35px 100px #0005}.ws-art-top{position:absolute;top:2rem;left:2rem;color:#d3c4fc;font-size:.72rem;letter-spacing:.2em;font-weight:800}.ws-art-orbit{position:absolute;inset:22% 5% 23%;display:grid;place-items:center}.ws-art-spark{font-size:clamp(8rem,19vw,16rem);color:var(--lime);line-height:1;text-shadow:0 0 60px #c7ff4c55;z-index:1}.ws-art-ring{position:absolute;width:80%;aspect-ratio:1;border:1px solid #b397ff77;border-radius:50%;transform:rotate(-25deg) scaleY(.58)}.ws-art-ring-two{width:95%;transform:rotate(35deg) scaleY(.5)}.ws-art-bottom{position:absolute;bottom:2.3rem;left:2rem;display:grid;gap:.15rem;font-size:1.05rem}.ws-art-bottom strong:nth-child(2){color:var(--lime)}.ws-art-corner{position:absolute;bottom:2rem;right:2rem;color:#c6c0d2;font-size:.72rem;letter-spacing:.18em}.ws-marquee{display:flex;align-items:center;justify-content:center;gap:clamp(1rem,3vw,4rem);background:var(--lime);color:var(--ink);padding:1rem;font-size:.77rem;letter-spacing:.09em;font-weight:800;white-space:nowrap;overflow:hidden}.ws-marquee b{font-size:1.2rem}
  .ws-section{padding:clamp(4rem,7vw,7rem) 0}.ws-section-label{color:var(--purple);margin:0 0 1.5rem}.ws-solo h2{font-size:clamp(2.9rem,5vw,5.2rem);line-height:1.1;margin:0 0 1.5rem;font-weight:700}.ws-solo h2 em{color:var(--purple)}.ws-section p:not(.ws-section-label):not(.ws-proof-note){font-size:1.03rem;line-height:1.8}.ws-intro{background:var(--paper)}.ws-intro-grid{display:grid;grid-template-columns:1fr 2fr;gap:3rem;align-items:start}.ws-intro-grid p:last-child{max-width:43ch;color:var(--muted)}
