---
import EasterEgg from "../components/EasterEgg.astro";
import NewsletterPopup from "../components/NewsletterPopup.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import StickyBookCta from "../components/StickyBookCta.astro";
import { buildOrganizationSchema, buildPersonSchema, buildWebSiteSchema } from "../lib/schema";
import { absoluteUrl, normalizePath } from "../lib/utils";
import { siteConfig } from "../site";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/site-v9.css";
import "../styles/mobile-qa.css";

interface Props {
  title?: string;
  description?: string;
  /** Optional extra discoverability meta for hub pages (insights, resources, etc.). */
  keywords?: string;
  path?: string;
  ogImage?: string;
  /** Alt text for social preview images (defaults to title). */
  ogImageAlt?: string;
  /** Open Graph type; use `article` for long-form insights. */
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  lastUpdated?: string | false;
  /** Override default robots meta (e.g. noindex for utility pages). */
  metaRobots?: string;
  /** Visible breadcrumb trail (mirrors JSON-LD when provided). Last item is current page. */
  breadcrumbItems?: Array<{ name: string; path: string }>;
  /** When false, the page supplies its own header (e.g. homepage hero v3). */
  showSiteHeader?: boolean;
  /** Extra classes on `<body>` (space-separated). */
  bodyClass?: string;
  /** Override default sitewide announcement banner. */
  announcementText?: string;
  announcementHref?: string;
  announcementLinkText?: string;
  announcementDismissible?: boolean;
  announcementVariant?: "default" | "brand" | "muted" | "dark-hero";
  announcementPill?: string;
  /** Sticky book CTA (off on /book and pages with their own booking block). */
  stickyBookCta?: boolean;
  /** Sticky CTA destination override (defaults to /book). */
  stickyBookHref?: string;
  /** Sticky CTA button label override. */
  stickyBookCtaLabel?: string;
  /** Newsletter popup (off on /newsletter and the booking flow). */
  newsletterPopup?: boolean;
  /** Header primary CTA label. */
  headerCtaLabel?: string;
  /** Header primary CTA href. */
  headerCtaHref?: string;
  /** When false, hide footer scorecard secondary CTA. */
  showFooterScorecard?: boolean;
  /** When false, hide footer newsletter signup. */
  showFooterNewsletter?: boolean;
  /** When false, hide the sitewide announcement banner (e.g. /book). */
  showAnnouncement?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  keywords,
  path = Astro.url.pathname,
  ogImage = siteConfig.ogImage,
  ogImageAlt: ogImageAltProp,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  schema = [],
  lastUpdated = false,
  metaRobots = "index,follow,max-image-preview:large",
  breadcrumbItems,
  showSiteHeader = true,
  bodyClass = "",
  announcementText = `New: the ${siteConfig.scorecardName}. Find your growth constraint in 5 minutes.`,
  announcementHref = siteConfig.scorecardUrl,
  announcementLinkText = "Take the scorecard →",
  announcementDismissible = true,
  announcementVariant = "brand",
  announcementPill,
  stickyBookCta: stickyBookCtaProp,
  stickyBookHref,
  stickyBookCtaLabel,
  newsletterPopup: newsletterPopupProp,
  headerCtaLabel,
  headerCtaHref,
  showFooterScorecard = true,
  showFooterNewsletter = true,
  showAnnouncement: showAnnouncementProp
} = Astro.props;

const currentPath = normalizePath(path);
const stickyBookCta =
  stickyBookCtaProp ?? !(currentPath === "/book" || currentPath.startsWith("/book/"));
const showAnnouncement =
  showAnnouncementProp ?? !(currentPath === "/book" || currentPath.startsWith("/book/"));
// Don't interrupt readers who are already on the signup page or in the
// booking flow — everywhere else the popup is on by default.
const newsletterPopup =
  newsletterPopupProp ??
  !(currentPath === "/newsletter" || currentPath === "/book" || currentPath.startsWith("/book/"));
const canonical = absoluteUrl(currentPath);
const imageUrl = absoluteUrl(ogImage);
const ogImageAlt = ogImageAltProp ?? title;
const ogImageMime = ogImage.toLowerCase().endsWith(".svg") ? "image/svg+xml" : ogImage.toLowerCase().endsWith(".png") ? "image/png" : ogImage.toLowerCase().match(/\.(jpe?g)$/) ? "image/jpeg" : undefined;
const pageSchemas = Array.isArray(schema) ? schema : [schema];
const allSchemas = [buildPersonSchema(), buildOrganizationSchema(), buildWebSiteSchema(), ...pageSchemas].filter(Boolean);
const serializedSchemas = allSchemas.map((item) => JSON.stringify(item).replace(/</g, "\\u003c"));
// GTM bootstrap — dataLayer initialised immediately so events queue; gtm.js deferred to first interaction or idle (3s cap) to keep it off the critical path.
const gtmScript = `window.dataLayer=window.dataLayer||[];window.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});
(function(){var loaded=false;function load(){if(loaded)return;loaded=true;var j=document.createElement('script');j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id=${siteConfig.gtmId}';document.head.appendChild(j);}
['pointerdown','keydown','scroll','touchstart'].forEach(function(e){addEventListener(e,load,{once:true,passive:true});});
if('requestIdleCallback' in window){requestIdleCallback(load,{timeout:3000});}else{setTimeout(load,3000);}})();`;
const turnstileSiteKey =
  (typeof import.meta.env.PUBLIC_TURNSTILE_SITE_KEY === "string" &&
    import.meta.env.PUBLIC_TURNSTILE_SITE_KEY.trim()) ||
  "0x4AAAAAAEIhzoHuWLsynQnO";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Analytics: GTM loads gtm.js here; dataLayer events — page_context (page load); ai_referral (AI referrer/utm); cta_click, book_call (/book or Cal.com), calendly_click (legacy alias for Cal.com clicks), scorecard_start, pricing_click, resource_click, outbound_link_click (link clicks with label); form_submit; resource_download; sticky_book_cta_shown. Booking (inline Cal.com on /book): booking_time_selected, booking_completed (mark booking_completed + book_call as GA4 key events). Home: home_scorecard_hook_select. Configure GTM Custom Events + Data Layer variables. CMP: use GTM if opt-in regions. -->
    <!-- Google Tag Manager — high in <head> per install instructions (GTM loads before other head assets). -->
    <script is:inline set:html={gtmScript} />
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={metaRobots} />
    {siteConfig.bingSiteVerification && (
      <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {currentPath === "/" && (
      <>
        <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM / agent summary (plain text)" />
        <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Extended context (markdown)" />
        <link rel="alternate" type="text/markdown" href="/markdown/home.md" title="Homepage as markdown" />
        <link rel="api-catalog" href="/.well-known/api-catalog" />
        <link rel="alternate" type="application/json" href="/.well-known/agent-skills/index.json" title="Agent skills index" />
      </>
    )}

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {ogImageMime && <meta property="og:image:type" content={ogImageMime} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.twitterHandle} />
    <meta name="twitter:creator" content={siteConfig.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    {turnstileSiteKey && <meta name="cf-turnstile-sitekey" content={turnstileSiteKey} />}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <meta name="ai:summary" content={description} />
    <meta name="ai:role" content="Growth consultancy and fractional CMO support for post-PMF startups" />
    <meta name="ai:serves" content="Post-PMF SaaS, AI, fintech, healthtech, ecommerce, and education startups" />
    <meta name="ai:contact" content={`${siteConfig.siteUrl}${siteConfig.bookingUrl}`} />
    <meta
      name="ai:entity"
      content={`${siteConfig.name}; ${siteConfig.founderName}; Fractional CMO; ${siteConfig.danielSite}; ${siteConfig.podcastUrl}`}
    />
    <meta
      name="ai:credibility"
      content="Cambridge Judge Business School; Google for Startups; Techstars; GrowthMentor"
    />

    <!--email_off-->
    {serializedSchemas.map((json) => <script is:inline type="application/ld+json" set:html={json} />)}
    <!--/email_off-->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "page_context",
        page_path: window.location.pathname,
        page_title: document.title,
        page_location: window.location.href
      });

      (function () {
        var AI_SOURCES = ["chatgpt", "openai", "perplexity", "gemini", "claude", "copilot", "you.com", "phind"];
        var params = new URLSearchParams(window.location.search);
        var utmSource = (params.get("utm_source") || "").toLowerCase();
        var utmMedium = (params.get("utm_medium") || "").toLowerCase();
        var referrerHost = "";
        try {
          referrerHost = document.referrer ? new URL(document.referrer).hostname.toLowerCase() : "";
        } catch (err) {}
        var matchedSource = AI_SOURCES.find(function (source) {
          return utmSource.indexOf(source) !== -1 || referrerHost.indexOf(source) !== -1;
        });
        if (!matchedSource && utmMedium !== "ai" && utmMedium !== "llm") return;
        window.dataLayer.push({
          event: "ai_referral",
          ai_source: matchedSource || utmSource || "unknown",
          ai_medium: utmMedium || "referrer",
          ai_referrer_host: referrerHost || "none",
          page_path: window.location.pathname,
          page_location: window.location.href
        });
      })();

      document.addEventListener("click", (event) => {
        const target = event.target;
        const link = target instanceof Element ? target.closest("a") : null;
        if (!link) return;

        if (link.hasAttribute("download")) {
          const href = link.href || "";
          const label = link.dataset.cta || link.textContent?.trim() || "resource_download";
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "resource_download",
            download_url: href,
            download_label: label,
            page_path: window.location.pathname
          });
          return;
        }

        const label = link.dataset.cta || link.textContent?.trim();
        if (!label) return;

        const href = link.href || "";
        const isCalendly = href.includes("calendly.com") || href.includes("cal.wescalestartups.com");
        const isBookPath = /\/book\/?(\?|$|#)/.test(href) || href.endsWith("/book") || href.includes("/book?");
        const isScorecard = href.includes("growth-bottleneck-scorecard");
        const isPricing = href.includes("/pricing") || link.closest("[data-pricing-link]");
        const isResource = href.includes("/resources") || link.closest("[data-resource-link]");
        const isOutbound = href.startsWith("http") && !href.includes(window.location.hostname);

        let eventName = "cta_click";
        if (isCalendly || isBookPath) eventName = "book_call";
        else if (isScorecard) eventName = "scorecard_start";
        else if (isPricing) eventName = "pricing_click";
        else if (isResource) eventName = "resource_click";
        else if (isOutbound) eventName = "outbound_link_click";

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: eventName,
          cta_label: label,
          cta_href: href,
          page_path: window.location.pathname
        });

        // Keep calendly_click for existing GTM mappings while book_call is the key event.
        if (isCalendly) {
          window.dataLayer.push({
            event: "calendly_click",
            cta_label: label,
            cta_href: href,
            page_path: window.location.pathname
          });
        }
      });

      document.addEventListener("submit", (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "form_submit",
          form_id: form.id || form.name || "unknown",
          form_action: form.action || "unknown",
          page_path: window.location.pathname
        });
      });
    </script>
  </head>
  <body class:list={["theme-wss-v9", bodyClass]}>
    <!-- Google Tag Manager (noscript) — immediately after <body> per GTM install instructions. -->
    <noscript>
      <iframe
        height="0"
        src={`https://www.googletagmanager.com/ns.html?id=${siteConfig.gtmId}`}
        style="display:none;visibility:hidden"
        width="0"
      />
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Reading progress. Rendered here rather than per page so the homepage
         and the other ~124 routes share one element and one listener. -->
    <div class="v9-scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showAnnouncement && (
      <AnnouncementBanner
        text={announcementText}
        href={announcementHref}
        linkText={announcementLinkText}
        dismissible={announcementDismissible}
        variant={announcementVariant}
        pill={announcementPill}
      />
    )}
    {showSiteHeader && (
      <SiteHeader
        currentPath={currentPath}
        ctaLabel={headerCtaLabel}
        ctaHref={headerCtaHref}
      />
    )}
    <main id="main-content">
      {
        breadcrumbItems && breadcrumbItems.length > 0 && (
          <div class="breadcrumb-wrap">
            <div class="shell">
              <nav aria-label="Breadcrumb" class="breadcrumb-nav">
                <ol>
                  {breadcrumbItems.map((item, index) => {
                    const isLast = index === breadcrumbItems.length - 1;
                    const href = item.path.startsWith("/") ? normalizePath(item.path) : `/${normalizePath(item.path)}`;
                    return (
                      <li>
                        {isLast ? (
                          <span aria-current="page">{item.name}</span>
                        ) : (
                          <a href={href}>{item.name}</a>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </nav>
            </div>
          </div>
        )
      }
      <slot />
      {lastUpdated && (
        <section class="last-updated-band" aria-label="Page freshness">
          <div class="shell">
            <p>Last updated: {lastUpdated}</p>
          </div>
        </section>
      )}
    </main>
    <SiteFooter showScorecardCta={showFooterScorecard} showNewsletter={showFooterNewsletter} />
    <StickyBookCta
      enabled={stickyBookCta}
      href={stickyBookHref}
      ctaLabel={stickyBookCtaLabel}
    />
    <NewsletterPopup enabled={newsletterPopup} />
    <EasterEgg />
    <!-- Shared interaction layer: scroll progress, scroll reveal and the
         pointer-tracking card glow. This is the homepage's motion language
         (previously inline in index.astro) promoted to every route.

         Performance: inline so it costs no request, ~1.5KB, and the only
         persistent listeners are one rAF-throttled scroll handler plus two
         delegated document listeners. Deliberately NOT deferred to first
         interaction the way gtm.js is — the reveal has to settle before the
         visitor scrolls, and unlike an analytics tag it renders content.

         NO-JS: the `v9-reveal` class is only ever added here. If this script
         does not run, nothing is hidden and every page reads normally. -->
    <script is:inline>
      (function () {
        var progress = document.querySelector(".v9-scroll-progress");
        var frame = 0;
        var pending = [];

        function onFrame() {
          frame = 0;
          if (progress) {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            var value = max > 0 ? Math.min(1, window.scrollY / max) : 0;
            progress.style.transform = "scaleX(" + value + ")";
          }
          sweep();
        }

        /* IntersectionObserver only fires on a threshold CROSSING, so an
           instant jump (anchor link, Cmd+End, restored scroll position) skips
           every element in between and they stay at opacity 0 forever. This
           sweep reveals anything the viewport has already reached. It only
           measures the not-yet-revealed set, so it costs nothing once the
           page is fully revealed. */
        function sweep() {
          if (!pending.length) return;
          var limit = window.innerHeight;
          pending = pending.filter(function (el) {
            if (el.classList.contains("is-visible")) return false;
            if (el.getBoundingClientRect().top >= limit) return true;
            el.classList.add("is-visible");
            return false;
          });
        }

        window.addEventListener("scroll", function () {
          if (!frame) frame = requestAnimationFrame(onFrame);
        }, { passive: true });
        window.addEventListener("resize", onFrame, { passive: true });
        onFrame();

        /* Interior card families — the same KINDS of element the homepage
           glows. The homepage's own glow surfaces already carry the class in
           markup and are listed here too so the two sets stay one decision;
           classList.add is idempotent, so nothing is bound twice. */
        var INTERIOR_CARDS =
          ".feature-card, .case-card, .insight-card, .pricing-card, .industry-card," +
          ".offer-card, .offer-detail-card, .offer-routing-card, .pillar-card," +
          ".audience-card, .team-card, .stage-card, .decision-card, .fit-card," +
          ".free-paid-card, .handson-card, .mistake-card, .start-step, .content-block," +
          ".strategic-panel, .contact-option, .cta-inner";

        var GLOW =
          INTERIOR_CARDS +
          ", .v9-principle, .v9-service-card, .v9-case-card, .v9-os-card," +
          ".v9-teaching-card, .v9-diagnostic-output, .v9-fit-video," +
          ".v9-community-newsletter, .v9-community-whatsapp";

        /* Reveal is narrower than glow on purpose. The homepage's list is
           reproduced verbatim (it deliberately leaves the hero card, the
           teaching photo and the community strip static) and interior pages
           add their cards, section intros and the closing CTA. FAQ
           accordions, quiz panels and long-form prose stay still. */
        var REVEAL =
          INTERIOR_CARDS +
          ", .section-intro, .content-header, .testimonials-header," +
          ".related-insights-list > li, .wss-ledger > *," +
          ".v9-principle, .v9-service-card, .v9-case-card, .v9-quote, .v9-fit-card," +
          ".v9-timeline li, .v9-diagnostic-output, .v9-constraint-tabs, .v9-fit-video," +
          ".v9-scorecard-card, .v9-other-grid article, .v9-metric";

        /* The glow is a CSS object that needs two custom properties kept up to
           date; adding the class here rather than in 60 templates keeps it a
           single decision. Purely decorative, so no-JS losing it is fine. */
        document.querySelectorAll(GLOW).forEach(function (card) {
          card.classList.add("v9-hover-glow");
        });

        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
          var revealObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            });
          }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
          document.querySelectorAll(REVEAL).forEach(function (el, index) {
            el.classList.add("v9-reveal");
            el.style.transitionDelay = (index % 3) * 70 + "ms";
            pending.push(el);
            revealObserver.observe(el);
          });
          sweep();
        }

        /* One delegated listener instead of one per card: pages carry 20+
           glow surfaces and the homepage carried 12 individual bindings. */
        document.addEventListener("pointermove", function (event) {
          var card = event.target instanceof Element ? event.target.closest(".v9-hover-glow") : null;
          if (!card) return;
          var rect = card.getBoundingClientRect();
          card.style.setProperty("--pointer-x", ((event.clientX - rect.left) / rect.width * 100) + "%");
          card.style.setProperty("--pointer-y", ((event.clientY - rect.top) / rect.height * 100) + "%");
        }, { passive: true });
      })();
    </script>
  </body>
</html>
