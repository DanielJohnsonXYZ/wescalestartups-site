---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { buildBreadcrumbSchema } from "../lib/schema";
import { siteConfig, customerIoNewsletter } from "../site";

const schemas = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Podcast Guest Application", path: "/podcast-guest-application" }
  ])
];

const guestFields = [
  { name: "name", label: "Name", type: "text" as const, required: true, autocomplete: "name" },
  { name: "company", label: "Company", type: "text" as const, required: true, autocomplete: "organization" },
  { name: "role", label: "Role / Title", type: "text" as const, required: true, autocomplete: "organization-title" },
  // Use text (not url): browsers reject linkedin.com/... without https:// and the tooltip
  // often sits above the fold, so Submit looks dead.
  { name: "website", label: "Website", type: "text" as const, required: false, placeholder: "https://", inputmode: "url", autocomplete: "url" },
  { name: "linkedin", label: "LinkedIn Profile", type: "text" as const, required: false, placeholder: "https://linkedin.com/in/…", inputmode: "url" },
  { name: "what-building", label: "What are you building?", type: "textarea" as const, required: true },
  { name: "how-using-ai", label: "How are you using AI in your startup?", type: "textarea" as const, required: true },
  { name: "practical-lessons", label: "What practical lessons can listeners take away?", type: "textarea" as const, required: true },
  { name: "relevant-links", label: "Relevant links (product, press, LinkedIn, etc.)", type: "textarea" as const, required: false },
  { name: "email", label: "Email", type: "email" as const, required: true, autocomplete: "email" }
];

const suggestedCopy =
  "Want to be a guest? We are looking for founders, marketers, investors, and operators with practical perspectives on how AI is changing startup growth: what is breaking, what still works, and what leaders should do differently.";
---

<BaseLayout
  title={`Podcast Guest Application | ${siteConfig.podcastName}`}
  description={`Apply to be a guest on ${siteConfig.podcastName}. Founders, marketers, investors, and operators examining how AI is rewriting the startup growth playbook.`}
  path="/podcast-guest-application"
  schema={schemas}
  metaRobots={siteConfig.podcastLive ? "index,follow,max-image-preview:large" : "noindex,follow"}
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Podcast Guest Application</p>
      <h1>Apply to be a guest on <span class="grad">{siteConfig.podcastName}</span></h1>
      <p class="max-w-3xl">
        {suggestedCopy}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Who we're looking for"
        title="Founders and operators with real AI growth stories."
        body="We want practical, specific examples, not theory. If your startup is using AI to grow faster, save time, or make better commercial decisions, we want to hear from you."
      />
      <div class="max-w-3xl grid gap-4">
        <div class="card p-6">
          <h3 class="font-bold text-lg">What makes a great guest</h3>
          <ul class="mt-4 space-y-3">
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>You're a founder, operator, or growth leader at a post-PMF startup</span></li>
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>You're using AI in a way that creates measurable commercial outcomes</span></li>
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>You can share specific examples, numbers, and lessons learned</span></li>
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>You're comfortable on record, clear speaking, practical takeaways</span></li>
          </ul>
        </div>
        <div class="card p-6">
          <h3 class="font-bold text-lg">Topics we love</h3>
          <ul class="mt-4 space-y-3">
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>AI-native GTM: how AI changed your acquisition model</span></li>
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>Agentic workflows that replaced manual growth work</span></li>
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>Using AI to sharpen positioning, ICP, or pricing</span></li>
            <li class="flex gap-3"><span class="text-[color:var(--accent)] mt-1">✦</span><span>AI tools that improved conversion, retention, or sales efficiency</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="shell">
      <SectionIntro
        eyebrow="Application form"
        title="Tell us about yourself and your AI story."
        body="The more specific you are, the faster we can see if there's a fit for the show."
      />
      <form class="max-w-2xl card p-8 md:p-10 space-y-5" id="guest-application" name="guest-application" novalidate>
        {guestFields.map((field) => (
          <label class="block">
            <span class="block text-sm font-semibold uppercase tracking-[0.1em] text-[color:var(--muted)] mb-2">
              {field.label}{field.required && <span class="text-[color:var(--accent)]"> *</span>}
            </span>
            {field.type === "textarea" ? (
              <textarea
                name={field.name}
                rows="4"
                required={field.required}
                class="w-full rounded-lg border border-[color:var(--line)] bg-[color:var(--surface)] px-4 py-3 text-base focus:border-[color:var(--accent)] focus:outline-none"
              ></textarea>
            ) : (
              <input
                type={field.type}
                name={field.name}
                required={field.required}
                placeholder={"placeholder" in field ? field.placeholder : undefined}
                inputmode={"inputmode" in field ? (field.inputmode as astroHTML.JSX.HTMLAttributes["inputmode"]) : undefined}
                autocomplete={"autocomplete" in field ? field.autocomplete : undefined}
                class="w-full rounded-lg border border-[color:var(--line)] bg-[color:var(--surface)] px-4 py-3 text-base focus:border-[color:var(--accent)] focus:outline-none"
              />
            )}
          </label>
        ))}
        <button class="button button-brand" type="submit" id="guest-submit">Submit Application</button>
        <p id="guest-status" class="guest-status" role="status" aria-live="polite" hidden></p>
      </form>

      <script is:inline define:vars={{ email: siteConfig.email, cioUrl: customerIoNewsletter.submitUrl, cioFormId: customerIoNewsletter.formId }}>
        (function () {
          const form = document.getElementById("guest-application");
          if (!(form instanceof HTMLFormElement)) return;

          const status = document.getElementById("guest-status");
          const submitBtn = document.getElementById("guest-submit");
          const MAILTO_SAFE_LENGTH = 1800;

          function val(name) {
            const raw = form.elements.namedItem(name);
            if (!(raw instanceof HTMLInputElement || raw instanceof HTMLTextAreaElement)) return "";
            return raw.value.trim();
          }

          function normalizeUrl(value) {
            if (!value) return "";
            if (/^[a-z][a-z0-9+.-]*:/i.test(value)) return value;
            return "https://" + value;
          }

          function showStatus(html, ok) {
            if (!(status instanceof HTMLElement)) return;
            status.hidden = false;
            status.className = "guest-status" + (ok ? " guest-status--ok" : " guest-status--err");
            status.innerHTML = html;
            status.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }

          function fieldError(name, message) {
            const el = form.elements.namedItem(name);
            if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
              el.setCustomValidity(message || "");
              if (message) el.reportValidity();
            }
          }

          form.addEventListener("input", (event) => {
            const t = event.target;
            if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement) {
              t.setCustomValidity("");
            }
          });

          form.addEventListener("submit", async (event) => {
            event.preventDefault();

            // Clear previous custom errors, then enforce required fields ourselves
            // so we can scroll to the first problem near the submit button.
            for (const el of Array.from(form.elements)) {
              if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
                el.setCustomValidity("");
              }
            }

            const required = ["name", "company", "role", "what-building", "how-using-ai", "practical-lessons", "email"];
            for (const name of required) {
              if (!val(name)) {
                fieldError(name, "Please fill in this field.");
                return;
              }
            }

            const emailVal = val("email");
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
              fieldError("email", "Please enter a valid email address.");
              return;
            }

            const website = normalizeUrl(val("website"));
            const linkedin = normalizeUrl(val("linkedin"));

            const subject = "Podcast Guest Application: " + (val("name") || "Guest") + " (" + (val("company") || "") + ")";
            const body = [
              "Name: " + val("name"),
              "Company: " + val("company"),
              "Role: " + val("role"),
              "Website: " + website,
              "LinkedIn: " + linkedin,
              "",
              "What are you building?",
              val("what-building"),
              "",
              "How are you using AI?",
              val("how-using-ai"),
              "",
              "Practical lessons for listeners:",
              val("practical-lessons"),
              "",
              "Relevant links:",
              val("relevant-links"),
              "",
              "Email: " + emailVal
            ].join("\n");

            if (submitBtn instanceof HTMLButtonElement) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Submitting…";
            }

            // Capture the lead in Customer.io (fire-and-forget) so submissions are never lost,
            // even if no mail client is configured.
            try {
              fetch(cioUrl, {
                method: "POST",
                keepalive: true,
                headers: { "Content-Type": "application/json", Accept: "application/json" },
                body: JSON.stringify({
                  form_id: cioFormId,
                  email: emailVal,
                  source_type: "podcast-guest-form",
                  source_page: window.location.href,
                  lead_magnet: "podcast-guest-application"
                })
              }).catch(function () {});
            } catch (_) {}

            // Prefer a same-origin API when available (Pages Function); fall back to clipboard + mailto.
            let apiOk = false;
            try {
              const res = await fetch("/api/podcast-guest", {
                method: "POST",
                headers: { "Content-Type": "application/json", Accept: "application/json" },
                body: JSON.stringify({
                  name: val("name"),
                  company: val("company"),
                  role: val("role"),
                  website: website,
                  linkedin: linkedin,
                  whatBuilding: val("what-building"),
                  howUsingAi: val("how-using-ai"),
                  practicalLessons: val("practical-lessons"),
                  relevantLinks: val("relevant-links"),
                  email: emailVal,
                  page: window.location.href
                })
              });
              apiOk = res.ok;
            } catch (_) {
              apiOk = false;
            }

            let copied = false;
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(subject + "\n\n" + body);
                copied = true;
              }
            } catch (_) {}

            const mailtoHref =
              "mailto:" + email + "?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
            const mailtoShort =
              "mailto:" +
              email +
              "?subject=" +
              encodeURIComponent(subject) +
              "&body=" +
              encodeURIComponent(
                "Hi Daniel,\n\nI'd like to apply as a podcast guest. My application is ready to paste from my clipboard" +
                  (copied ? "" : " (copy failed — please re-open the form)") +
                  ".\n\nName: " +
                  val("name") +
                  "\nCompany: " +
                  val("company") +
                  "\nEmail: " +
                  emailVal +
                  "\n"
              );

            // Only auto-open mailto when short enough; long bodies silently fail in many clients.
            const openHref = mailtoHref.length <= MAILTO_SAFE_LENGTH ? mailtoHref : mailtoShort;
            try {
              const a = document.createElement("a");
              a.href = openHref;
              a.rel = "noopener";
              a.style.display = "none";
              document.body.appendChild(a);
              a.click();
              a.remove();
            } catch (_) {}

            if (submitBtn instanceof HTMLButtonElement) {
              submitBtn.textContent = "Application submitted";
            }

            const clipboardLine = copied
              ? " A copy is on your clipboard."
              : "";
            const apiLine = apiOk
              ? " We've received your application."
              : " If an email draft did not open, send it to <a href=\"mailto:" +
                email +
                "\">" +
                email +
                "</a>.";

            showStatus(
              "<strong>Thanks — you're in.</strong>" +
                apiLine +
                clipboardLine +
                ' <a href="' +
                openHref +
                '">Open email draft →</a>',
              true
            );
          });
        })();
      </script>

      <style>
        .guest-status {
          margin: 0;
          padding: 1rem 1.1rem;
          border-radius: 8px;
          font-size: 0.95rem;
          line-height: 1.5;
        }
        .guest-status--ok {
          border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
          background: color-mix(in srgb, var(--accent) 10%, var(--surface));
          color: var(--ink);
        }
        .guest-status--err {
          border: 1px solid #c44;
          background: #fff5f5;
          color: #5a1515;
        }
        .guest-status a {
          text-decoration: underline;
        }
        #guest-submit:disabled {
          opacity: 0.7;
          cursor: default;
        }
      </style>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionIntro
        eyebrow="Sponsorship"
        title={`Interested in sponsoring ${siteConfig.podcastName}?`}
        body="Reach a high-intent audience of founders and operators building AI-native startups."
      />
      <div class="max-w-3xl card p-8 md:p-10">
        <p class="text-lg leading-8 text-[color:var(--muted)]">
          {siteConfig.podcastName} reaches founders and operators at post-PMF startups who are actively figuring out how AI changes growth. Sponsorship includes pre-roll mentions, show notes links, and optional founder-led partnership discussions.
        </p>
        <a class="button button-brand mt-6" href={`mailto:${siteConfig.email}?subject=Podcast%20Sponsorship%20Enquiry`}>Enquire About Sponsorship →</a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Prefer a call?</p>
        <h2>Discuss the podcast or sponsorship directly.</h2>
        <p>
          If you'd rather talk through the fit, the topic, or sponsorship options, book a 20-minute diagnostic call with Daniel.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand button-with-subcopy"
          href={siteConfig.bookingUrl}
          data-cta="podcast-book"
          title={siteConfig.bookingCallReassurance}
        >
          <span class="button-label">{siteConfig.bookingLabel}</span>
          <span class="button-subcopy">{siteConfig.bookingSubcopy}</span>
        </a>
        <a class="button button-light" href={`mailto:${siteConfig.email}?subject=Podcast%20Guest%20Enquiry`} data-cta="podcast-email">
          Or, email {siteConfig.email} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
