---
// SiteFooter.astro — the page's closing object, in four ledger bands:
//   1. footer-top      identity + the one next step
//   2. footer-directory  four indexed link groups, split by vertical rules
//   3. footer-keep     newsletter + community, two cells of the same ledger
//   4. footer-legal    dark strip: copyright, address, legal, founder
// Styling lives in site-v9.css (shared chrome on all 121 routes), per that
// file's header note. Nothing is styled here.
import EmailSignup from "./EmailSignup.astro";
import WhatsAppCta from "./WhatsAppCta.astro";
import { siteConfig } from "../site";

interface Props {
  /** When false, hide the secondary scorecard CTA in the brand column. */
  showScorecardCta?: boolean;
  /** When false, hide the newsletter signup block. */
  showNewsletter?: boolean;
}

const { showScorecardCta = true, showNewsletter = true } = Astro.props;

// Four groups, not five: "Legal" was two links next to columns of eight, so it
// rendered as a mostly empty fifth column. Privacy and Terms now sit in the
// legal strip, which is where a reader looks for them anyway.
const groups = [
  {
    label: "Work with us",
    links: [
      { href: "/services/growth-diagnosis", label: "Growth Diagnosis" },
      { href: "/services/90-day-growth-sprint", label: "90-Day Growth Sprint" },
      { href: "/services/acquisition-system-build", label: "Acquisition System Build" },
      { href: "/services/fractional-cmo", label: "Fractional CMO" },
      { href: "/ai-growth-audit", label: "AI Growth Audit" },
      { href: "/pricing", label: "Pricing" },
      { href: "/contact", label: "Contact" }
    ]
  },
  {
    label: "Results",
    links: [
      { href: "/proof", label: "All results" },
      { href: "/case-studies", label: "Case studies" },
      { href: "/testimonials", label: "Testimonials" },
      { href: "/industries", label: "Industries we serve" },
      { href: "/fractional-cmo-vs-agency", label: "WSS vs agency" }
    ]
  },
  {
    label: "Resources",
    links: [
      { href: "/start-here", label: "Start here" },
      { href: siteConfig.scorecardUrl, label: siteConfig.scorecardName },
      { href: "/post-raise", label: "Just raised? Read this" },
      { href: "/resources", label: "All resources & templates" },
      { href: "/growth-operating-system", label: "Growth Operating System" },
      { href: "/growth-course", label: "Free growth course" },
      { href: "/newsletter", label: siteConfig.newsletterName },
      { href: "/insights", label: "Insights" },
      { href: "/gtm-strategy", label: "GTM Strategy Guide" },
...(siteConfig.podcastLive ? [{ href: "/podcast", label: "Luck Doesn't Scale" }] : [])
    ]
  },
  {
    label: "Company",
    links: [
      { href: "/about", label: "About WSS" },
      { href: "/team", label: "Team" },
      { href: "/about/daniel", label: "About Daniel" },
      { href: "/facts/we-scale-startups", label: "Verified company facts" },
      { href: "/press", label: "Speaking & press" },
      { href: "/workshops", label: "Workshops" },
      { href: "/refer", label: "Refer a founder" },
      { href: siteConfig.linkedin, label: "LinkedIn", external: true }
    ]
  }
];
---

<footer class="site-footer site-footer-v2">
  <div class="shell footer-top">
    <div class="footer-identity">
      <img class="footer-logo" src="/images/logos/wss-logo.webp" alt="We Scale Startups" width="128" height="72" loading="lazy" decoding="async" />
      <p class="footer-summary">
        We build the growth infrastructure AI startups and B2B SaaS teams need to hit the KPI that matters: customer research, experimentation and a testing rhythm your team owns, built from first principles.
      </p>
      <p class="footer-brand-arch">
        <strong>Brand note:</strong> This is the We Scale Startups commercial site (services, proof, systems). Daniel&apos;s personal brand, speaking, writing, media, lives at{" "}
        <a href={siteConfig.danielSite} rel="noopener" target="_blank">danieljohnson.xyz</a>.
      </p>
    </div>

    <div class="footer-next">
      <p class="footer-next-label">Next step</p>
      <p class="footer-next-line">
        Tell us where you are: stage, traction, the KPI you care about. We reply with the clearest next step, even if that step is not us.
      </p>
      <a
        class="button button-brand footer-next-cta"
        href="/contact"
        data-cta="footer-contact"
        title="Contact We Scale Startups"
      >
        Contact <span aria-hidden="true">→</span>
      </a>
      {showScorecardCta && (
        <p class="footer-secondary-cta">
          Or <a href={siteConfig.scorecardUrl}>{siteConfig.scorecardLabel}</a>
        </p>
      )}
    </div>
  </div>

  <div class="shell footer-directory">
    {groups.map((group, index) => (
      <nav class="footer-col" aria-label={`${group.label} links`}>
        <h3>
          <span class="footer-col-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          {group.label}
        </h3>
        <ul class="footer-links">
          {group.links.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
              >
                {link.label}
                {link.external && <span class="footer-link-ext" aria-hidden="true">↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  {showNewsletter && (
    <div class="shell footer-keep">
      <div class="footer-keep-cell footer-keep-newsletter">
        <p class="footer-keep-label">Newsletter</p>
        <EmailSignup
          variant="light"
          formId="footer-newsletter"
          heading={siteConfig.newsletterName}
          subtext={`${siteConfig.newsletterDescription} ${siteConfig.newsletterFrequencyLine}`}
        />
      </div>
      <div class="footer-keep-cell footer-keep-community">
        <p class="footer-keep-label">Community</p>
        <p class="footer-keep-heading">{siteConfig.growingPains.name}</p>
        <p class="footer-keep-copy">
          Prefer real-time? Join founders and operators comparing notes on pipeline, positioning, and growth systems.
        </p>
        <WhatsAppCta class="button button-acid" cta="footer-whatsapp" />
      </div>
    </div>
  )}

  <div class="footer-legal">
    <div class="shell footer-legal-inner">
      <p class="footer-legal-copyright">© {new Date().getFullYear()} We Scale Startups</p>
      <p class="footer-legal-address">{siteConfig.address}</p>
      <nav class="footer-legal-links" aria-label="Legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
      <p class="footer-legal-founder">
        Founded by <a href="/about#daniel">{siteConfig.founderName}</a>
        <span aria-hidden="true">·</span>
        <a href={siteConfig.danielSite} rel="noopener" target="_blank">danieljohnson.xyz</a>
      </p>
    </div>
  </div>
</footer>
