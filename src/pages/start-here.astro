---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema, buildFaqSchema } from "../lib/schema";
import { siteConfig } from "../site";

const startHereFaqs = [
  {
    question: "How long does this path take?",
    answer:
      "About 35 minutes end to end: 5 for the scorecard, 10 for a case study, 20 for the call. You can stop after any step."
  },
  {
    question: "Do I have to book a call?",
    answer:
      "No. The scorecard and case studies are there so you can self-qualify. Book when the bottleneck is sharp enough that a conversation saves you a quarter of guessing."
  },
  {
    question: "Is We Scale Startups a marketing agency?",
    answer:
      "No. WSS works at diagnosis and system level: bottleneck, acquisition design, reporting cadence, and transfer. Agencies execute inside that system once the constraint is clear, and many teams use both."
  },
  {
    question: "Should I use this site or Daniel Johnson's personal site?",
    answer:
      "Use wescalestartups.com for the WSS engagement ladder: Growth Diagnosis, 90-Day Sprint, Acquisition System Build, or Fractional CMO. Use danieljohnson.xyz if you're exploring a fractional CMO relationship with Daniel as the principal."
  }
];

const steps = [
  {
    num: "01",
    time: "5 minutes",
    title: "Score yourself",
    body: "Take the Growth Bottleneck Scorecard. 10 questions across the five layers that block pipeline: customer, offer, acquisition, evidence, and team ownership. You leave with your constraint named.",
    ctaLabel: "Take the scorecard",
    ctaHref: siteConfig.scorecardUrl
  },
  {
    num: "02",
    time: "10 minutes",
    title: "Read one case study",
    body: "Pick the one that looks most like your situation. Every case uses the same Problem / Action / Result format, so you can see exactly how the work happens and what it produces.",
    ctaLabel: "See the case studies",
    ctaHref: "/proof"
  },
  {
    num: "03",
    time: "20 minutes",
    title: "Book the Growth Audit call",
    body: "Free, 20 minutes, no pitch. Bring your scorecard result and current numbers. You leave with the bottleneck named in plain English and an honest read on whether WSS is the right call.",
    ctaLabel: "Book the call",
    ctaHref: siteConfig.bookingUrl
  },
  {
    num: "04",
    time: "When you're ready",
    title: "Start with the smallest engagement that answers your question",
    body: "Growth Diagnosis £2k–£4k if the constraint is unclear. 90-Day Sprint £8k–£12k for focused tests. Acquisition System Build £15k–£25k for one connected system. Fractional CMO £5k–£8k/mo for senior leadership.",
    ctaLabel: "Compare engagements",
    ctaHref: "/pricing"
  }
];

const startHereSchema = [
  buildBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Start here", path: "/start-here" }
  ]),
  buildFaqSchema(startHereFaqs)
];
---

<BaseLayout
  path="/start-here"
  breadcrumbItems={[
    { name: "Home", path: "/" },
    { name: "Start here", path: "/start-here" }
  ]}
  title="Start here | We Scale Startups"
  description="The four-step path for founders: score your growth bottleneck, read one case study, book the audit call, then pick the smallest engagement that fits."
  keywords="We Scale Startups onboarding, post-PMF founder guide, growth consultancy fit, which engagement first, startup growth decision tree"
  schema={startHereSchema}
  lastUpdated={siteConfig.lastUpdated}
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Start here</p>
      <h1>Four steps. About 35 minutes. No demos.</h1>
      <p class="lede">
        WSS works with <strong>AI and B2B SaaS startups</strong> where growth still runs through the founder. This page is the
        whole path, in order. Do step one now; book a call only when step three makes sense.
      </p>
    </div>
  </section>

  <!-- THE PATH -->
  <section class="section">
    <div class="shell">
      {steps.map((step) => (
        <article class="start-step">
          <span class="start-step-num">{step.num}</span>
          <div>
            <p class="step-time">{step.time}</p>
            <h2 class="step-title">{step.title}</h2>
            <p>{step.body}</p>
          </div>
          <a
            class="button button-brand"
            href={step.ctaHref}
            data-cta={`start-here-step-${step.num}`}
          >
            {step.ctaLabel} →
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- FIT CHECK -->
  <section class="section section-alt">
    <div class="shell">
      <p class="eyebrow">Before you invest the 35 minutes</p>
      <h2>WSS isn't right for everyone.</h2>

      <div class="stage-grid">
        <article class="stage-card">
          <p class="card-kicker">Pre-PMF</p>
          <h3>Still searching for the problem?</h3>
          <p>Some signal, no repeatable customer. Growth marketing won't fix it.</p>
          <p class="stage-action">
            <strong>Don't hire us yet.</strong> Spend the time on customer research and product. Come back when there's repeatable revenue.
          </p>
        </article>

        <article class="stage-card stage-card-fit">
          <p class="card-kicker">Post-PMF, founder still selling</p>
          <h3>Paying customers, but pipeline arrives in bursts?</h3>
          <p>The founder owns every revenue call and nobody can say confidently what's working.</p>
          <p class="stage-action">
            <strong>Best fit.</strong> Follow the four steps above, starting with the scorecard.
          </p>
        </article>

        <article class="stage-card">
          <p class="card-kicker">Scaling, then a plateau</p>
          <h3>£1m–£10m ARR and growth slowing?</h3>
          <p>Channels running but disconnected; growth decisions still route through the founder.</p>
          <p class="stage-action">
            <strong>Core fit.</strong> Most teams in this band start with the System Build, then add fractional leadership.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="shell">
      <p class="eyebrow">FAQ</p>
      <h2>Before you commit time.</h2>
      <div class="grid-3">
        {startHereFaqs.map((item) => (
          <article class="feature-card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-band">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow">Already know your bottleneck?</p>
        <h2>Skip ahead and book the call.</h2>
        <p>Bring your current growth picture. We'll spend the {siteConfig.bookingCallDurationPhrase} on the bottleneck, not on intros.</p>
      </div>
      <div class="hero-actions">
        <a
          class="button button-brand"
          href={siteConfig.bookingUrl}
          data-cta="start-here-final"
          title={siteConfig.bookingCallReassurance}
        >
          {siteConfig.bookingLabel} →
        </a>
        <a class="button button-light" href={siteConfig.scorecardUrl} data-cta="start-here-final-scorecard">
          Or, {siteConfig.scorecardLabel} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Border/radius/background come from the shared card contract in
     site-v9.css. */
  .start-step {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 1.6rem;
    margin-top: 1rem;
  }
  @media (max-width: 720px) {
    .start-step { grid-template-columns: 1fr; gap: 0.85rem; }
  }
  .start-step-num {
    font-family: var(--v9-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .step-time {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin: 0 0 0.3rem;
  }
  .step-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.45rem;
    color: var(--ink);
  }
  .start-step p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
    max-width: 62ch;
  }
  .start-step .button { align-self: center; white-space: nowrap; }

  .stage-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 2rem;
  }
  @media (min-width: 720px) { .stage-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .stage-grid { grid-template-columns: repeat(3, 1fr); } }

  /* Border/radius/background come from the shared card contract in
     site-v9.css. */
  .stage-card {
    padding: 1.4rem 1.4rem;
  }
  .stage-card-fit { border-color: var(--accent); }
  .stage-card h3 {
    margin-top: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .stage-card p {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin-top: 0.5rem;
  }
  .stage-action {
    background: var(--surface-dim);
    border-radius: var(--v9-radius-small);
    padding: 0.7rem 0.85rem;
    margin-top: 0.85rem !important;
    color: var(--ink) !important;
  }
  .stage-action strong { color: var(--accent); }
</style>
