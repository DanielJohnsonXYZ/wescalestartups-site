---
// NewsletterPopup.astro — newsletter invite, shown once on exit intent
// (desktop) or when the reader is deep into the page (any device).
//
// Built on <dialog>, so focus handling, Esc and the backdrop come from the
// platform rather than hand-rolled JS. Frequency: at most once every
// `dismissDays`, and never again for anyone who subscribes (EmailSignup
// dispatches `newsletter:subscribed` on success).
import EmailSignup from "./EmailSignup.astro";
import WhatsAppCta from "./WhatsAppCta.astro";
import { siteConfig } from "../site";

interface Props {
  /** Set false on pages that already lead with the signup, or on /book. */
  enabled?: boolean;
  /** Scroll progress (0–1) that opens the popup when exit intent never fires. */
  scrollTrigger?: number;
  /** Quiet period before the reader is interrupted, in seconds. */
  delaySeconds?: number;
  /** How long a dismissal is remembered. */
  dismissDays?: number;
}

const {
  enabled = true,
  scrollTrigger = 0.55,
  delaySeconds = 12,
  dismissDays = 30
} = Astro.props;
---

{enabled && (
  <dialog
    class="nl-popup"
    data-newsletter-popup
    data-scroll-trigger={scrollTrigger}
    data-delay-seconds={delaySeconds}
    data-dismiss-days={dismissDays}
    aria-labelledby="nl-popup-heading"
  >
    <button class="nl-popup-close" type="button" data-newsletter-popup-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div class="nl-popup-head">
      <p class="nl-popup-eyebrow">Stay in the loop</p>
      <h2 id="nl-popup-heading">Two ways to keep in touch.</h2>
    </div>

    <div class="nl-popup-panels">
      <EmailSignup
        variant="light"
        formId="popup-newsletter"
        sourceType="newsletter"
        heading="Practical founder-led GTM, one email at a time."
        subtext={siteConfig.newsletterFrequencyLine}
        buttonLabel={`Subscribe to ${siteConfig.newsletterName} →`}
      />

      <div class="nl-popup-panel">
        <p class="nl-popup-panel-eyebrow">{siteConfig.growingPains.name}</p>
        <h3>Talk it through with other founders.</h3>
        <p class="nl-popup-panel-sub">
          {siteConfig.growingPains.blurb} A WhatsApp group working the same problems in real time. No pitching, no noise.
        </p>
        <WhatsAppCta
          class="button button-brand nl-popup-panel-cta"
          label="Join the WhatsApp group →"
          cta="popup-whatsapp"
        />
      </div>
    </div>
  </dialog>
)}

{enabled && (
  <script is:inline>
    (() => {
      const dialog = document.querySelector("dialog[data-newsletter-popup]");
      if (!dialog || typeof dialog.showModal !== "function") return;

      const KEY = "wss-newsletter-popup";
      const trigger = Number(dialog.dataset.scrollTrigger) || 0.55;
      const delay = (Number(dialog.dataset.delaySeconds) || 12) * 1000;
      const dismissMs = (Number(dialog.dataset.dismissDays) || 30) * 86400000;

      let state = {};
      try {
        state = JSON.parse(window.localStorage.getItem(KEY) || "{}") || {};
      } catch (_) {}

      const save = (patch) => {
        Object.assign(state, patch);
        try {
          window.localStorage.setItem(KEY, JSON.stringify(state));
        } catch (_) {}
      };

      const close = () => {
        if (dialog.open) dialog.close();
      };

      // The sticky bar pitches the same newsletter; two interruptions at once
      // is one too many, so it stands down while the dialog is up.
      const flagOpen = (isOpen) => {
        document.documentElement.toggleAttribute("data-newsletter-popup-open", isOpen);
      };

      document.addEventListener("newsletter:subscribed", () => {
        save({ subscribed: true });
        // Leave the confirmation on screen long enough to read.
        if (dialog.open) window.setTimeout(close, 2600);
      });

      dialog
        .querySelector("[data-newsletter-popup-close]")
        ?.addEventListener("click", close);

      // Clicking the backdrop (anywhere outside the card) dismisses.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) close();
      });

      dialog.addEventListener("close", () => {
        document.body.style.removeProperty("overflow");
        flagOpen(false);
      });

      if (state.subscribed) return;
      if (state.shownAt && Date.now() - state.shownAt < dismissMs) return;

      let opened = false;

      const disarm = () => {
        document.removeEventListener("mouseout", onExitIntent);
        window.removeEventListener("scroll", onScroll);
      };

      const open = () => {
        if (opened || document.querySelector("dialog[open]")) return;
        opened = true;
        disarm();
        save({ shownAt: Date.now() });
        dialog.showModal();
        document.body.style.overflow = "hidden";
        flagOpen(true);
      };

      function onExitIntent(event) {
        if (!event.relatedTarget && event.clientY <= 0) open();
      }

      function onScroll() {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (max > 0 && window.scrollY / max >= trigger) open();
      }

      window.setTimeout(() => {
        if (opened) return;
        document.addEventListener("mouseout", onExitIntent);
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }, delay);
    })();
  </script>
)}

<style>
  .nl-popup {
    /* inset + auto margins are what centre a modal <dialog> in the top layer. */
    inset: 0;
    margin: auto;
    width: min(34rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    height: fit-content;
    padding: 1.5rem 1.35rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--v9-radius-small);
    background: var(--paper);
    overflow: auto;
    box-shadow: 0 24px 60px rgba(17, 17, 23, 0.28);
  }

  .nl-popup-head {
    margin-bottom: 1rem;
    padding-right: 2rem;
  }

  .nl-popup-eyebrow {
    margin: 0 0 0.3rem;
    font-family: var(--v9-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--violet-deep);
  }

  .nl-popup-head h2 {
    margin: 0;
    font-family: var(--v9-display);
    font-size: 1.45rem;
    line-height: 1.2;
    color: var(--ink);
  }

  /* Equal billing: two panels, same surface, same padding, same CTA weight. */
  .nl-popup-panels {
    display: grid;
    gap: 0.75rem;
  }

  .nl-popup-panel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--v9-radius-small);
    background: var(--surface);
  }

  .nl-popup-panel-eyebrow {
    margin: 0;
    font-family: var(--v9-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--violet-deep);
  }

  .nl-popup-panel h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
  }

  .nl-popup-panel-sub {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Matches the signup's own submit button, so neither half outranks the
     other on the way out of the dialog. */
  .nl-popup :global(.nl-popup-panel-cta) {
    justify-content: center;
    width: 100%;
    margin-top: 0.35rem;
  }

  .nl-popup::backdrop {
    background: rgba(17, 17, 23, 0.55);
    backdrop-filter: blur(2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nl-popup[open] {
      animation: nl-popup-in 220ms ease-out;
    }
    .nl-popup[open]::backdrop {
      animation: nl-popup-fade 220ms ease-out;
    }
  }

  @keyframes nl-popup-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes nl-popup-fade {
    from {
      opacity: 0;
    }
  }

  /* EmailSignup brings its own surface, border and radius — match the
     WhatsApp panel's padding so the pair reads as one control. */
  .nl-popup :global(.email-signup-strip) {
    margin: 0;
    padding: 1.4rem 1.5rem;
  }

  .nl-popup :global(.email-signup-heading) {
    font-size: 1.05rem;
    line-height: 1.35;
  }

  /* Full-width submit, so both panels end in the same size of button. */
  .nl-popup :global(.email-signup-form .button) {
    width: 100%;
    justify-content: center;
  }

  /* Keep the heading clear of the close button on narrow viewports. */
  .nl-popup :global(.email-signup-copy) {
    padding-right: 2.2rem;
  }

  .nl-popup-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }

  .nl-popup-close:hover,
  .nl-popup-close:focus-visible {
    border-color: var(--ink);
    color: var(--ink);
  }

  .nl-popup-close svg {
    width: 0.95rem;
    height: 0.95rem;
  }
</style>
